{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp",
        "--headless"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "vaultspec-core": {
      "command": "uvx",
      "args": [
        "--from",
        "vaultspec-core",
        "python",
        "-m",
        "vaultspec_core.mcp_server.app"
      ]
    },
    "vaultspec-rag": {
      "command": "uvx",
      "args": [
        "--from",
        "vaultspec-rag[mcp]",
        "python",
        "-m",
        "vaultspec_rag.server"
      ]
    }
  }
}
