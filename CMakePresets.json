{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 pinned MSVC",
      "generator": "Visual Studio 17 2022",
      "toolchainFile": "${sourceDir}/native/cmake/WindowsToolchain.cmake",
      "binaryDir": "$env{CADRUMO_BUILD_DIR}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "environment": {
        "CADRUMO_BUILD_DIR": "${sourceDir}/build/windows-x64",
        "TEMP": "$env{CADRUMO_BUILD_DIR}/tmp",
        "TMP": "$env{CADRUMO_BUILD_DIR}/tmp",
        "TMPDIR": "$env{CADRUMO_BUILD_DIR}/tmp"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "windows-x86-64"
      }
    },
    {
      "name": "windows-installers-x64",
      "displayName": "Unsigned Windows installer build, isolated outputs",
      "inherits": "windows-x64",
      "environment": {
        "CADRUMO_BUILD_DIR": "${sourceDir}/build/windows-installers-x64"
      }
    },
    {
      "name": "linux-x86-64",
      "displayName": "linux-x86-64 (requires native SDK/toolchain)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/linux-x86-64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "linux-x86-64"
      }
    },
    {
      "name": "linux-aarch64",
      "displayName": "linux-aarch64 (requires native SDK/toolchain)",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/linux-aarch64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "linux-aarch64"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macos-arm64 (requires native SDK/toolchain)",
      "generator": "Ninja Multi-Config",
      "toolchainFile": "${sourceDir}/native/cmake/DarwinToolchain.cmake",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "macos-arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-installers-release",
      "configurePreset": "windows-installers-x64",
      "configuration": "Release",
      "targets": ["native-installer"]
    },
    {
      "name": "debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "package-debug",
      "inherits": "debug",
      "targets": [
        "zip"
      ]
    },
    {
      "name": "package-release",
      "inherits": "release",
      "targets": [
        "zip"
      ]
    },
    {
      "name": "linux-x86-64-debug",
      "configurePreset": "linux-x86-64",
      "configuration": "Debug",
      "targets": [
        "bundle"
      ]
    },
    {
      "name": "linux-x86-64-release",
      "configurePreset": "linux-x86-64",
      "configuration": "Release",
      "targets": [
        "bundle"
      ]
    },
    {
      "name": "linux-aarch64-debug",
      "configurePreset": "linux-aarch64",
      "configuration": "Debug",
      "targets": [
        "bundle"
      ]
    },
    {
      "name": "linux-aarch64-release",
      "configurePreset": "linux-aarch64",
      "configuration": "Release",
      "targets": [
        "bundle"
      ]
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64",
      "configuration": "Debug",
      "targets": [
        "bundle"
      ]
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64",
      "configuration": "Release",
      "targets": [
        "bundle"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86-64-debug",
      "configurePreset": "linux-x86-64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-x86-64-release",
      "configurePreset": "linux-x86-64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-aarch64-debug",
      "configurePreset": "linux-aarch64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-aarch64-release",
      "configurePreset": "linux-aarch64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
