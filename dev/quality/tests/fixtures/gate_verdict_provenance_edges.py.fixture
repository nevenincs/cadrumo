import subprocess

LINT_IMPORTS_COMMAND = "lint-imports"
EXPECTED = "KEPT"


def audit() -> None:
    (subprocess.run([LINT_IMPORTS_COMMAND]), "ordinary")[1].endswith("KEPT")
    (subprocess.run([LINT_IMPORTS_COMMAND]), "ordinary")[-2].endswith("KEPT")
    (subprocess.run([LINT_IMPORTS_COMMAND]), "ordinary")[-1].endswith("KEPT")

    subprocess.run(args=[LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")

    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    (output := "ordinary")
    output.endswith("KEPT")

    result = subprocess.run([LINT_IMPORTS_COMMAND])
    tuple_output, ordinary = (result.stdout, "ordinary")
    tuple_output.startswith("BROKEN")


def local_imports() -> None:
    import subprocess as local_process
    from subprocess import run as local_run

    local_process.run([LINT_IMPORTS_COMMAND]).stderr.endswith("KEPT")
    local_run([LINT_IMPORTS_COMMAND]).stdout.startswith("BROKEN")
