# === pinning_helpers ===
def pinned_result() -> object:
    return invoke_cached_cli(["--lang=en", "command"])


def forwarded_result() -> object:
    return pinned_result()


def pinned_environment() -> dict[str, str]:
    return {"CADRUMO_OUTPUT_LANGUAGE": "en"}


def helper_output() -> None:
    result = forwarded_result()
    output_text = result.output
    assert "ADVISORY:" not in output_text


def helper_environment() -> None:
    environment = pinned_environment()
    result = invoke_cached_cli(["command"], env=environment)
    assert "ADVISORY:" not in result.output

# === helper_with_unrelated_pin ===
def misleading_helper() -> object:
    invoke_cached_cli(["--language", "en", "setup"])
    return invoke_cached_cli(["actual"])


def helper_output() -> None:
    result = misleading_helper()
    assert "ADVISORY:" not in result.output

# === helper_kind_confusion ===
def environment_only() -> dict[str, str]:
    return {"CADRUMO_OUTPUT_LANGUAGE": "en"}


def nested_environment() -> dict[str, object]:
    return {"wrapper": {"CADRUMO_OUTPUT_LANGUAGE": "en"}}


def environment_helper_is_not_output() -> None:
    result = environment_only()
    assert "ADVISORY:" not in result.output


def nested_mapping_is_not_an_environment_pin() -> None:
    result = invoke_cached_cli(["actual"], env=nested_environment())
    assert "ADVISORY:" not in result.output

# === future_pin ===
def output_before_pin() -> None:
    result = invoke_cached_cli(["actual"])
    assert "ADVISORY:" not in result.output
    result = invoke_cached_cli(["--language", "en", "later"])

# === mixed_invocations ===
def mixed_output() -> None:
    pinned = invoke_cached_cli(["--language", "en", "first"])
    unpinned = invoke_cached_cli(["second"])
    assert "ADVISORY:" not in pinned.output
    assert "ADVISORY:" not in unpinned.output

