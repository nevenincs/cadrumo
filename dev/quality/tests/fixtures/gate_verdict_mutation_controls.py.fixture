import subprocess

LINT_IMPORTS_COMMAND = "lint-imports"
KEPT = "KEPT"
BROKEN = "BROKEN"


def loop_marker_provenance() -> None:
    for command in (LINT_IMPORTS_COMMAND,):
        subprocess.run([command]).stdout.endswith("KEPT")  # loop-marker


def starred_loop_marker_provenance() -> None:
    for (*command,) in ((LINT_IMPORTS_COMMAND,),):
        subprocess.run([command]).stdout.endswith("KEPT")  # starred-marker


def loop_shadowed_module() -> None:
    import subprocess as process

    for process in (object(),):
        process.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")  # clean-loop-shadow


def command_source_order() -> None:
    subprocess.run([future_command]).stdout.endswith("KEPT")  # clean-future-command
    future_command = LINT_IMPORTS_COMMAND

    command = "git"
    command = LINT_IMPORTS_COMMAND
    subprocess.run([command]).stdout.endswith("KEPT")  # repeated-command


def cyclic_command() -> None:
    recursive = recursive
    subprocess.run([recursive]).stdout.endswith("KEPT")  # clean-cyclic-command


def composed_output() -> None:
    (subprocess.run([LINT_IMPORTS_COMMAND]).stdout + "").endswith("KEPT")  # left-binop
    ("" + subprocess.run([LINT_IMPORTS_COMMAND]).stdout).endswith("KEPT")  # right-binop


def indexed_output(index: int) -> None:
    (subprocess.run([LINT_IMPORTS_COMMAND]).stdout, "ordinary")[0].endswith("KEPT")  # positive-index
    (subprocess.run([LINT_IMPORTS_COMMAND]).stdout, "ordinary")[index].endswith("KEPT")  # clean-dynamic-index
    (subprocess.run([LINT_IMPORTS_COMMAND]).stdout, "ordinary")[2].endswith("KEPT")  # clean-out-of-range-index


def conditional_output(flag: bool) -> None:
    (subprocess.run([LINT_IMPORTS_COMMAND]).stdout if flag else "ordinary").endswith("KEPT")  # clean-one-sided-ifexp
    (  # both-sided-ifexp
        subprocess.run([LINT_IMPORTS_COMMAND]).stdout
        if flag
        else subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    ).endswith("KEPT")


def verdict_bindings(output: str, flag: bool) -> None:
    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    verdict = "BROKEN"
    verdict = "KEPT"
    output.endswith(verdict)  # repeated-verdict

    conditional_verdict = "BROKEN"
    if flag:
        conditional_verdict = "KEPT"
    output.endswith(conditional_verdict)  # clean-conditional-verdict

    loop_verdict = "KEPT"
    for loop_verdict in ("BROKEN",):
        pass
    output.endswith(loop_verdict)  # clean-loop-verdict-after


def comprehension_verdict(output: str) -> None:
    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    [output.endswith(verdict) for verdict in ("KEPT",)]  # comprehension-verdict


def branch_output(flag: bool, nested: bool) -> None:
    if flag:
        branch_output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
        branch_other = "ordinary"
        branch_annotated: str = "ordinary"
        if nested:
            nested_other = "ordinary"
    else:
        branch_output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    branch_output.endswith("KEPT")  # branch-reachability


def try_output() -> None:
    try:
        might_fail()
    except OSError:
        raise
    else:
        terminating_try_output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    terminating_try_output.endswith("KEPT")  # terminating-try


def partial_try_output() -> None:
    try:
        might_fail()
    except OSError:
        pass
    else:
        partial_try_output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    partial_try_output.endswith("KEPT")  # clean-partial-try


def direct_alias_collision() -> None:
    from subprocess import run as collide
    import subprocess as collide

    collide([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")  # clean-direct-alias-collision


def foreign_alias_collision() -> None:
    from subprocess import run as invoke
    from foreign_runner import run as invoke

    invoke([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")  # clean-foreign-alias-collision


def composed_command_edges() -> None:
    ambiguous = "ordinary"
    ambiguous = "still-ordinary"
    recursive = recursive
    command = recursive + LINT_IMPORTS_COMMAND
    subprocess.run([command]).stdout.endswith("KEPT")  # composed-ambiguous-command


def quiet_command_cycles() -> None:
    recursive_command = recursive_command
    subprocess.run([recursive_command]).stdout.endswith("KEPT")  # clean-direct-command-cycle

    for loop_command in (loop_command,):
        subprocess.run([loop_command]).stdout.endswith("KEPT")  # clean-loop-command-cycle


def partial_command_assignments(flag: bool) -> None:
    if flag:
        conditional_command = LINT_IMPORTS_COMMAND
    subprocess.run([conditional_command]).stdout.endswith("KEPT")  # clean-conditional-command

    try:
        try_command = LINT_IMPORTS_COMMAND
    except OSError:
        pass
    subprocess.run([try_command]).stdout.endswith("KEPT")  # clean-partial-command-try


def unrelated_comprehension_target() -> None:
    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    [output.endswith(verdict) for unrelated in ("KEPT",)]  # clean-unrelated-comprehension-target


def shadowed_comprehension_process() -> None:
    import subprocess as process

    for process in (object(),):
        [0 for _ in (process.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT"),)]  # clean-comprehension-shadow


def unresolved_alias() -> None:
    unknown_process = missing_process
    unknown_process.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")  # clean-unresolved-alias


def no_argument_run() -> None:
    subprocess.run().stdout.endswith("KEPT")  # clean-no-argument-run


def scalar_command() -> None:
    command = LINT_IMPORTS_COMMAND
    subprocess.run(command).stdout.endswith("KEPT")  # scalar-command


def output_barriers() -> None:
    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    output, other = ("ordinary", "ordinary")
    output.endswith("KEPT")  # clean-destructuring-barrier

    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    for output in ("ordinary",):
        pass
    output.endswith("KEPT")  # clean-loop-barrier


def exhaustive_branch_output(flag: bool) -> None:
    if flag:
        output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    else:
        output = "ordinary"
    output.endswith("KEPT")  # clean-gate-ordinary-branches


def gate_gate_bound_output(flag: bool) -> None:
    command = LINT_IMPORTS_COMMAND
    if flag:
        output = subprocess.run(command).stdout
    else:
        output = subprocess.run(args=[command]).stdout
    output.endswith("KEPT")  # gate-gate-bound-command


def bound_gate_helper(candidate: str) -> None:
    candidate.endswith("KEPT")  # gate-gate-bound-helper


def gate_gate_helper_output(flag: bool) -> None:
    command = LINT_IMPORTS_COMMAND
    if flag:
        output = subprocess.run([command]).stdout
    else:
        output = subprocess.run([command]).stdout
    bound_gate_helper(output)


def self_referential_comprehension() -> None:
    output = subprocess.run([LINT_IMPORTS_COMMAND]).stdout
    [output.endswith(verdict) for verdict in (verdict,)]  # clean-self-referential-comprehension
