import subprocess

LINT_IMPORTS_COMMAND = "lint-imports"
EXPECTED = "KEPT"


def inspect(candidate: str, unrelated: str) -> None:
    dynamic_verdict: str
    dynamic_verdict = "KEPT"
    candidate.endswith(dynamic_verdict)
    candidate.endswith(unbound_verdict)
    unrelated.endswith("KEPT")


def audit() -> None:
    result = subprocess.run([LINT_IMPORTS_COMMAND])
    output = result.stdout
    inspect(output, "ordinary")
