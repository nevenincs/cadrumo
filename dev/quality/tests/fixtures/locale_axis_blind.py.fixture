"""Non-collected positive control for the runtime locale axis."""

from __future__ import annotations

import os


def test_english_absence_is_blind_under_spanish_output() -> None:
    rendered = {
        "en": "ADVISORY: detail",
        "es": "AVISO: detalle",
    }[os.environ["CADRUMO_OUTPUT_LANGUAGE"]]

    assert "ADVISORY:" not in rendered
