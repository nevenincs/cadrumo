import subprocess


def layering_report() -> tuple[list[str], list[str]]:
    lint_imports = "lint-imports"
    result = subprocess.run([lint_imports], capture_output=True, text=True)
    output = result.stdout + result.stderr
    verdict_lines: dict[str, list[str]] = {}
    for verdict in ("KEPT", "BROKEN"):
        verdict_lines[verdict] = [
            line.strip() for line in output.splitlines() if line.endswith(verdict)
        ]
    return verdict_lines["BROKEN"], verdict_lines["KEPT"]
