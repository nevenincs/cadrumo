import subprocess

LINT_IMPORTS_COMMAND = "lint-imports"
EXPECTED = "KEPT"


def audit() -> None:
    result = subprocess.run([LINT_IMPORTS_COMMAND])
    output = result.stdout
    output = "ordinary"
    output.endswith("KEPT")
    alias = result.stderr
    alias = "ordinary"
    alias.startswith("KEPT")


def same_line() -> None:
    result = subprocess.run([LINT_IMPORTS_COMMAND]); output = result.stdout; output = "ordinary"; output.endswith("KEPT")
