import subprocess
import subprocess as process
from subprocess import run as invoke

LINT_IMPORTS_COMMAND = "lint-imports"
EXPECTED = "KEPT"


def audit() -> None:
    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")
    process.run([LINT_IMPORTS_COMMAND]).stdout.startswith("BROKEN")
    invoke([LINT_IMPORTS_COMMAND]).stderr.endswith("KEPT")
    [line.endswith("BROKEN") for line in subprocess.run([LINT_IMPORTS_COMMAND]).stdout.splitlines()]


def same_line() -> None:
    result = subprocess.run([LINT_IMPORTS_COMMAND]); output = result.stdout; output.endswith("KEPT")
