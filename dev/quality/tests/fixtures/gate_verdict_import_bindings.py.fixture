import subprocess
from subprocess import run

LINT_IMPORTS_COMMAND = "lint-imports"
EXPECTED = "KEPT"


def valid_before_shadowing() -> None:
    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")
    run([LINT_IMPORTS_COMMAND]).stdout.startswith("BROKEN")


def shadowed_module(fake) -> None:
    subprocess = fake
    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")


def shadowed_direct(fake) -> None:
    run = fake
    run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")


def future_local_import() -> None:
    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")
    import subprocess


def parameter_shadow(subprocess, run) -> None:
    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")
    run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")


def nested_definition_shadow() -> None:
    def subprocess() -> None:
        pass

    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")


def nested_class_shadow() -> None:
    class run:
        pass

    run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")


async def nested_async_definition_shadow() -> None:
    async def subprocess() -> None:
        pass

    subprocess.run([LINT_IMPORTS_COMMAND]).stdout.endswith("KEPT")
