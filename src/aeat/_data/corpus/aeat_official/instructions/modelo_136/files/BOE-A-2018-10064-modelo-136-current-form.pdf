      <dc:title><rdf:Alt><rdf:li xml:lang="x-default">DisposiciÃ³n 10064 del BOE nÃºm. 173 de 2018</rdf:li></rdf:Alt></dc:title><dc:description><rdf:Alt><rdf:li xml:lang="x-default">BOE-A-2018-10064</rdf:li></rdf:Alt></dc:description><dc:subject><rdf:Bag><rdf:li>ORDEN HAC/763/2018 de 10/07/2018</rdf:li><rdf:li>MINISTERIO DE HACIENDA</rdf:li><rdf:li>BOE-A-2018-10064</rdf:li><rdf:li>BOE 173 de 2018</rdf:li><rdf:li>10064</rdf:li><rdf:li>18/07/2018</rdf:li></rdf:Bag></dc:subject></rdf:Description>
