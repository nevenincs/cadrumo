<?xml version="1.0" encoding="UTF-8"?>
<!--
  EN16931 Cross Industry Invoice (UN/CEFACT syntax), STANDALONE rather than
  embedded in a PDF. The only CII bytes previously bundled arrived inside the
  ZUGFeRD PDF, so the probe reached CII solely through the PDF-attachment
  branch; a bare .xml carrying a CrossIndustryInvoice root was classified by
  nothing.

  The scenario is an export outside the Community (LIVA art. 21): a Spanish
  supplier invoicing a Swiss customer, UNTDID 5305 category code G at 0.00
  percent, with a base and no cuota.

  Deliberately the complement of the UBL code-G fixture beside it. That one
  prints NO counterparty country at all, so the guard withholds the category:
  a rule table cannot place a party it cannot locate. This one PRINTS the
  country, in CII's own ram:CountryID element, so the same code arrives with
  the evidence the other lacks. The pair discriminates "the code was honoured"
  from "the code was honoured because nothing checked where the party is".

  Both parties state a country, and they differ (ES and CH). A fixture whose
  two parties share one country cannot catch a reader that finds the seller's
  element twice, which is the specific shape a tree-wide descendant walk
  produces.
-->
<rsm:CrossIndustryInvoice
    xmlns:rsm="urn:un:unece:uncefact:data:standard:CrossIndustryInvoice:100"
    xmlns:ram="urn:un:unece:uncefact:data:standard:ReusableAggregateBusinessInformationEntity:100"
    xmlns:udt="urn:un:unece:uncefact:data:standard:UnqualifiedDataType:100">

  <rsm:ExchangedDocumentContext>
    <ram:GuidelineSpecifiedDocumentContextParameter>
      <ram:ID>urn:cen.eu:en16931:2017</ram:ID>
    </ram:GuidelineSpecifiedDocumentContextParameter>
  </rsm:ExchangedDocumentContext>

  <rsm:ExchangedDocument>
    <ram:ID>CII-2024-0042</ram:ID>
    <ram:TypeCode>380</ram:TypeCode>
    <ram:IssueDateTime>
      <udt:DateTimeString format="102">20241203</udt:DateTimeString>
    </ram:IssueDateTime>
    <ram:IncludedNote>
      <ram:Content>Exportacion exenta - art. 21 LIVA</ram:Content>
    </ram:IncludedNote>
  </rsm:ExchangedDocument>

  <rsm:SupplyChainTradeTransaction>
    <ram:IncludedSupplyChainTradeLineItem>
      <ram:AssociatedDocumentLineDocument>
        <ram:LineID>1</ram:LineID>
      </ram:AssociatedDocumentLineDocument>
      <ram:SpecifiedTradeProduct>
        <ram:Name>Suministro de maquinaria de envasado</ram:Name>
      </ram:SpecifiedTradeProduct>
      <ram:SpecifiedLineTradeAgreement>
        <ram:NetPriceProductTradePrice>
          <ram:ChargeAmount>7400.00</ram:ChargeAmount>
        </ram:NetPriceProductTradePrice>
      </ram:SpecifiedLineTradeAgreement>
      <ram:SpecifiedLineTradeDelivery>
        <ram:BilledQuantity unitCode="C62">1</ram:BilledQuantity>
      </ram:SpecifiedLineTradeDelivery>
      <ram:SpecifiedLineTradeSettlement>
        <ram:ApplicableTradeTax>
          <ram:TypeCode>VAT</ram:TypeCode>
          <ram:CategoryCode>G</ram:CategoryCode>
          <ram:RateApplicablePercent>0.00</ram:RateApplicablePercent>
        </ram:ApplicableTradeTax>
        <ram:SpecifiedTradeSettlementLineMonetarySummation>
          <ram:LineTotalAmount>7400.00</ram:LineTotalAmount>
        </ram:SpecifiedTradeSettlementLineMonetarySummation>
      </ram:SpecifiedLineTradeSettlement>
    </ram:IncludedSupplyChainTradeLineItem>

    <ram:ApplicableHeaderTradeAgreement>
      <ram:SellerTradeParty>
        <ram:Name>Maquinaria Levantina SL</ram:Name>
        <ram:PostalTradeAddress>
          <ram:PostcodeCode>46015</ram:PostcodeCode>
          <ram:LineOne>Avinguda del Port 212</ram:LineOne>
          <ram:CityName>Valencia</ram:CityName>
          <ram:CountryID>ES</ram:CountryID>
        </ram:PostalTradeAddress>
        <ram:SpecifiedTaxRegistration>
          <ram:ID schemeID="VA">ESB12345674</ram:ID>
        </ram:SpecifiedTaxRegistration>
      </ram:SellerTradeParty>
      <ram:BuyerTradeParty>
        <ram:Name>Alpine Packaging AG</ram:Name>
        <ram:PostalTradeAddress>
          <ram:PostcodeCode>8004</ram:PostcodeCode>
          <ram:LineOne>Badenerstrasse 41</ram:LineOne>
          <ram:CityName>Zuerich</ram:CityName>
          <ram:CountryID>CH</ram:CountryID>
        </ram:PostalTradeAddress>
        <ram:SpecifiedTaxRegistration>
          <ram:ID schemeID="VA">CHE116281277</ram:ID>
        </ram:SpecifiedTaxRegistration>
      </ram:BuyerTradeParty>
    </ram:ApplicableHeaderTradeAgreement>

    <ram:ApplicableHeaderTradeDelivery/>

    <ram:ApplicableHeaderTradeSettlement>
      <ram:InvoiceCurrencyCode>EUR</ram:InvoiceCurrencyCode>
      <ram:ApplicableTradeTax>
        <ram:CalculatedAmount>0.00</ram:CalculatedAmount>
        <ram:TypeCode>VAT</ram:TypeCode>
        <ram:ExemptionReason>Exportacion fuera de la Comunidad</ram:ExemptionReason>
        <ram:BasisAmount>7400.00</ram:BasisAmount>
        <ram:CategoryCode>G</ram:CategoryCode>
        <ram:RateApplicablePercent>0.00</ram:RateApplicablePercent>
      </ram:ApplicableTradeTax>
      <ram:SpecifiedTradeSettlementHeaderMonetarySummation>
        <ram:LineTotalAmount>7400.00</ram:LineTotalAmount>
        <ram:TaxBasisTotalAmount>7400.00</ram:TaxBasisTotalAmount>
        <ram:TaxTotalAmount currencyID="EUR">0.00</ram:TaxTotalAmount>
        <ram:GrandTotalAmount>7400.00</ram:GrandTotalAmount>
        <ram:DuePayableAmount>7400.00</ram:DuePayableAmount>
      </ram:SpecifiedTradeSettlementHeaderMonetarySummation>
    </ram:ApplicableHeaderTradeSettlement>
  </rsm:SupplyChainTradeTransaction>
</rsm:CrossIndustryInvoice>
