<?xml version="1.0" encoding="UTF-8"?>
<!--
  EN16931 UBL, domestic reverse charge (LIVA art. 84.Uno.2) as a Spanish
  supplier issues it: a taxable base with a ZERO cuota, because the recipient
  self-assesses the tax rather than the issuer repercuting it.

  UNTDID 5305 category code AE at 0.00 percent is what carries that fact.
  Nothing else on the document distinguishes it from an exempt or a zero-rated
  supply, since all three print a base and no cuota. The code, and only the
  code, can be trusted to say which one it is.
-->
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
