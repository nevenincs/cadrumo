# -- Google OAuth 2.0 (Desktop / Interactive) ----------------------------
# Required for development and user-delegated access to Drive & Sheets.
# Create at: https://console.cloud.google.com/apis/credentials
# Application type: "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080
# Stable path of the downloaded OAuth Desktop client JSON. Set
# automatically by `aeat oauth-client init --json <path>`. Used by
# `just gcloud-auth` via `--client-id-file` so application-default
# login can request Drive/Sheets/Docs scopes (Google blocks those
# scopes when requested against gcloud's built-in OAuth client).
GOOGLE_OAUTH_CLIENT_JSON=

# -- Google Service Account (Server / Automation) ------------------------
# Required for headless/automated operation (CI, Cloud Functions, cron jobs).
# Create at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download the JSON key and set the path below.
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Domain-wide delegation: impersonate a Workspace user.
# Requires: Google Admin console -> Security -> API controls -> Domain-wide delegation
# Leave blank if not using domain-wide delegation.
GOOGLE_IMPERSONATE_EMAIL=

# -- Google Cloud Project ------------------------------------------------
# The GCP project ID (not project number).
# Find at: https://console.cloud.google.com/home/dashboard
GOOGLE_CLOUD_PROJECT=

# -- Google Resource IDs -------------------------------------------------
# Spreadsheet ID: extract from https://docs.google.com/spreadsheets/d/{ID}/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Drive folder ID: extract from https://drive.google.com/drive/folders/{ID}
GOOGLE_DRIVE_FOLDER_ID=

# Cloud Storage bucket name (without gs:// prefix)
GOOGLE_CLOUD_STORAGE_BUCKET=

# -- Token Storage -------------------------------------------------------
# Directory for cached OAuth tokens (default: .tokens/ in project root).
# This directory is git-ignored automatically.
AEAT_TOKEN_DIR=.tokens

# -- AEAT ----------------------------------------------------------------
AEAT_BASE_URL=https://sede.agenciatributaria.gob.es

# -- Financial ingest (#73) ----------------------------------------------
# Fallback ISO 4217 currency used when a financial source does not carry a
# per-row currency column.
FINANCIAL_BASE_CURRENCY=EUR
# Preferred encoding attempted first when decoding CSV bank exports.
FINANCIAL_DEFAULT_CSV_ENCODING=utf-8
# Directory where the transaction catalogue JSON file is stored (#74).
AEAT_FINANCIAL_TXS_DIR=var/financial/transactions
# Directory where the invoice catalogue JSON file is stored (#75).
AEAT_INVOICES_DIR=var/financial/invoices
# Root directory for the attachment byte and manifest store (#76).
AEAT_ATTACHMENTS_DIR=var/financial/attachments

# -- Scratch resources (provisioned by `aeat bootstrap`) ----------------
# These are populated automatically by `aeat bootstrap` after authentication.
# Do not edit by hand unless you know what you are doing.
AEAT_SCRATCH_FOLDER_ID=
AEAT_SCRATCH_SHEET_ID=
AEAT_SCRATCH_DOC_ID=

# -- Storage (aeat#10) ---------------------------------------------------
# SQLAlchemy URL for the primary persistence backend. Default is a local
# SQLite file under var/aeat.db. Switching to PostgreSQL later is a single
# change here (e.g. postgresql+psycopg://user:pass@host/db).
AEAT_DATABASE_URL=sqlite:///var/aeat.db

# When true, the storage layer runs `alembic upgrade head` on engine creation.
# Off by default; migrations are applied deliberately via `just db-upgrade`.
AEAT_STORAGE_AUTO_MIGRATE=false

# Directory where the storage layer writes database backups.
AEAT_STORAGE_BACKUP_DIR=var/backups

# -- Google test fixtures (provisioned by `just google-fixtures-provision`) --
# Root Drive folder that parents every Google Workspace test fixture.
# Populated by scripts/provision_google_fixtures.py; never hand-edit.
AEAT_GOOGLE_TEST_FIXTURES_FOLDER_ID=
# Spreadsheet ID for the smoke-test fixture Sheet (cell A1 seeded with a sentinel).
AEAT_GOOGLE_TEST_FIXTURE_SMOKE_SHEET_ID=
# Document ID for the smoke-test fixture Doc (body seeded with a sentinel).
AEAT_GOOGLE_TEST_FIXTURE_SMOKE_DOC_ID=

# ── Casilla corpus (aeat#23) ───────────────────────────────────────────────
# Root directory for canonical casilla catalogue JSON files.
AEAT_CASILLAS_ROOT=corpus/casillas

# When true, `aeat casillas verify` rejects records lacking
# definition_reviewed_by / definition_reviewed_at.
AEAT_CASILLAS_REVIEW_REQUIRED=true

# -- Live tests ----------------------------------------------------------
# Opt-in flag for `@pytest.mark.live_read` tests that hit real external
# services. Default `pytest` invocation skips live tests; `just test-live`
# opts in.
AEAT_LIVE_TESTS_ENABLED=false
# Secondary opt-in specifically for Google Workspace fixture live tests.
# Both AEAT_LIVE_TESTS_ENABLED and AEAT_LIVE_TESTS_GOOGLE must be truthy
# to collect tests/live/test_google_fixtures_smoke.py.
AEAT_LIVE_TESTS_GOOGLE=false

# -- Live-write bypass (charter #116 R1) --------------------------------
# UNSAFE. Pytest collection bypass factor 1 of 3 for @pytest.mark.live_write
# tests. NEVER set outside an interactive live-filing session. NEVER set
# in CI or cron. See charter #116 and tests/README.md.
AEAT_LIVE_WRITE_UNSAFE_BYPASS=false
# UNSAFE. Pytest collection bypass factor 2 of 3. Must equal the phrase:
# I ACCEPT THE RISK OF FILING A LIVE TAX RETURN. NEVER set outside an
# interactive live-filing session. NEVER set in CI or cron.
AEAT_LIVE_WRITE_UNSAFE_BYPASS_CONFIRM=

# -- Manuals corpus (aeat.manuals, #25) ----------------------------------
# Root directory for the structured AEAT Manual practico corpus. The
# 'aeat manual fetch' CLI writes PDFs and manifests under this path.
AEAT_MANUALS_ROOT=corpus/manuals
# When true, 'aeat manual verify' rejects any Manual/Section/Rule record
# missing definition_reviewed_by / definition_reviewed_at. Set to false
# only for draft imports.
AEAT_MANUALS_REVIEW_REQUIRED=true

# -- Normatives corpus (aeat.normatives, #45) ----------------------------
# Root directory for the Spanish tax normatives JSON catalogue, e.g.
# Ley 35/2006, Ley 37/1992, LGT, RD 439/2007, etc.
AEAT_NORMATIVES_ROOT=corpus/normatives

# -- VAT catalogue (aeat.financial.vat, #85) -----------------------------
# Root directory for the hand-reviewed VAT taxonomy catalogue. The
# in-memory VAT_CATALOGUE_2025 is the fallback; when a {year}.json file
# is present under this directory the loader will prefer it.
AEAT_VAT_CATALOGUE_ROOT=corpus/financial/vat

# -- Browser Automation --------------------------------------------------
AEAT_BROWSER_CHANNEL=chrome
AEAT_BROWSER_HEADLESS=true
AEAT_DEFAULT_PROFILE_NAME=default
AEAT_PROXY_URL=
AEAT_PROXY_USERNAME=
AEAT_PROXY_PASSWORD_SECRET=
AEAT_PROXY_BYPASS=
AEAT_RATE_LIMIT_DELAY_SECONDS=2.0

# -- Trilingual i18n -----------------------------------------------------
AEAT_OUTPUT_LANGUAGE=es
AEAT_AUTHORITATIVE_LANGUAGE_AEAT_TERMS=es
AEAT_AUTHORITATIVE_LANGUAGE_PROJECT_DOCS=en
AEAT_FALLBACK_LANGUAGES=en,es

# -- AEAT certificate authentication (#8) -------------------------------
# PKCS#12 (.p12/.pfx) bundle supplied by the operator. Issued by FNMT-RCM
# as a "certificado de persona fisica". The passphrase is read from
# AEAT_CERTIFICATE_PASSWORD_SECRET and never appears in logs.
AEAT_CERTIFICATE_PATH=
AEAT_CERTIFICATE_PASSWORD_SECRET=
AEAT_CERTIFICATE_FRIENDLY_NAME=
# Backend to use: PLAYWRIGHT_CONTEXT (default, drives the Sede UI) or
# HTTPX_FALLBACK (verify-only smoke test).
AEAT_CERTIFICATE_BACKEND=PLAYWRIGHT_CONTEXT
# Target URL for aeat.auth.verify_handshake() mTLS smoke test.
AEAT_CERTIFICATE_VERIFY_URL=https://sede.agenciatributaria.gob.es/
# Pre-expiry gate thresholds (#94). Certificates with <= AEAT_CERT_WARN_DAYS
# remaining surface as WARN; <= AEAT_CERT_CRITICAL_DAYS as CRITICAL and
# block live submission unless --force-expiring-cert is passed.
AEAT_CERT_WARN_DAYS=60
AEAT_CERT_CRITICAL_DAYS=14

# -- Live-write gate (R3 charter, issue #116) ---------------------------
# AEAT_LIVE_SUBMIT_ENABLED is INTENTIONALLY NOT LISTED here. Setting it
# in a dotfile persists a value that could be loaded by a test run,
# violating R3 of the live-write safety charter. Export it only in an
# interactive shell, and only immediately before a real filing event.
# Unset it after the filing. The engine refuses dry_run=False when the
# var is not 'true', when PYTEST_CURRENT_TEST is present, or when any
# of the other gates in src/aeat/submission/_engine.py fail.
# Authoritative references: GitHub issue #116 and
# .vault/adr/2026-04-16-submission-safety-sweep-adr.md.

# -- LLM -----------------------------------------------------------------
AEAT_LLM_PROVIDER=ANTHROPIC
AEAT_LLM_MODEL=claude-sonnet-4-6
AEAT_LLM_ANTHROPIC_API_KEY=
AEAT_LLM_OPENAI_API_KEY=
AEAT_LLM_GEMINI_API_KEY=
AEAT_LLM_CACHE_DIR=var/llm-cache
AEAT_LLM_USAGE_DIR=var/llm-usage
AEAT_LLM_DEFAULT_TIMEOUT_S=60
AEAT_LLM_MAX_RETRIES=3

# -- Filing-deadline engine (#38) ----------------------------------------
# Optional path to a JSON file with the default AutonomoProfile loaded by
# `aeat deadlines` when --profile is omitted. Leave blank to require
# --profile on every invocation.
AEAT_DEFAULT_PROFILE_PATH=
# Days before an obligation's closes_on date that flag the obligation as
# ObligationStatus.DUE_SOON in the deadline engine.
AEAT_DEADLINE_DUE_SOON_DAYS=14

# -- Submission engine (#42) ---------------------------------------------
# Directory where SubmittedFiling JSON audit records are persisted.
AEAT_SUBMISSIONS_DIR=var/submissions
# Interactive-only live-write gate. Never enable this from pytest, CI,
# fixtures, or background jobs.
AEAT_LIVE_SUBMIT_ENABLED=false
# Directory where submission-engine Playwright traces and screenshots live.
AEAT_SUBMISSION_BROWSER_TRACE_DIR=var/browser-traces

# -- Self-healing sync runner (#11) --------------------------------------
# Maximum number of concurrent live-to-local sync fetches.
AEAT_SYNC_CONCURRENCY=4
# CSV list of DivergenceKind values the runner is permitted to auto-apply
# when classification==ADDITIVE and --auto-heal is passed. Everything else
# escalates to a PENDING divergence record for human review.
AEAT_SYNC_AUTO_HEAL_ALLOWLIST=casilla_added_with_default,label_translation_added,vigencia_extended
# Divergence record sink: FILE (JSON files, default) or STORAGE (pending
# #10 storage subpackage; selecting STORAGE before that merges raises).
AEAT_SYNC_DIVERGENCE_SINK=FILE
# Directory for JSON-file divergence records when the sink is FILE.
AEAT_SYNC_DIVERGENCE_FILE_DIR=var/divergences
# Maximum transient-fetch retry attempts during a sync run.
AEAT_SYNC_RETRY_MAX=3
# Initial exponential backoff delay (seconds) between retries.
AEAT_SYNC_RETRY_BACKOFF_S=5.0

# -- Status reader (#43) -------------------------------------------------
# Directory for the short-lived AEAT status-page cache.
AEAT_STATUS_CACHE_DIR=var/status-cache
# TTL in seconds for status cache entries. Short by default so we don't
# hammer AEAT but cache enough to deduplicate back-to-back CLI calls.
AEAT_STATUS_CACHE_TTL_S=900
# Directory where the status reader drops Playwright trace files (when
# tracing is enabled by the caller).
AEAT_STATUS_BROWSER_TRACE_DIR=var/browser-traces
# URL path template for per-expediente detail pages. Must contain
# '{expediente_id}'. Override if AEAT changes the URL shape between
# campaigns. See .vault/adr/2026-04-18-aeat-filing-detail-fetch-adr.md.
AEAT_STATUS_DETAIL_URL_TEMPLATE=/wlpl/TC-UTIL/Expediente/Detalle?EXP={expediente_id}

# -- Notifications inbox (#46) -------------------------------------------
# Directory where the persisted Inbox JSON file lives.
AEAT_INBOX_DIR=var/inbox
# Directory where downloaded notification PDFs are stored.
AEAT_INBOX_PDF_DIR=var/inbox/pdfs
# Lead window (days) for `aeat inbox next-deadline`: surface CRITICAL/HIGH
# notifications whose appeal_deadline falls within the next N days.
AEAT_INBOX_ALERT_LEAD_DAYS=7

# -- Workflow engine (#59) -----------------------------------------------
# Directory where composite-workflow run records (WorkflowResult) are
# persisted as JSON files (one file per run_id).
AEAT_WORKFLOW_RUNS_DIR=var/workflow-runs
# Default for WorkflowEngine.run_next(sync_first=...) when the CLI does
# not pass --sync/--no-sync explicitly.
AEAT_WORKFLOW_SYNC_FIRST_DEFAULT=true
# Optional path to a JSON file with the casilla input values the
# workflow engine consumes during BUILDING_DRAFT. Leave blank to
# require callers to inject their own FilingInputsProvider.
AEAT_WORKFLOW_DRAFT_INPUTS_PATH=

# -- Filing draft engine (#39) -------------------------------------------
# Directory where filing drafts are written as JSON files.
AEAT_DRAFTS_DIR=var/drafts
# If true, build_draft raises FilingValidationError when any
# WARNING- or ERROR-severity finding is produced.
AEAT_DRAFT_FAIL_ON_WARNING=false

# -- Site-health detection (#95) -----------------------------------------
# AEAT Sede URL that `aeat browser health` navigates to when probing
# for a mantenimiento banner, a WAF challenge, or a rate-limit answer.
SITE_HEALTH_PROBE_URL=https://sede.agenciatributaria.gob.es/
# Fallback Retry-After (seconds) used by the rate-limit parser when
# a 429/503 response omits the Retry-After header.
SITE_HEALTH_RATE_LIMIT_RETRY_AFTER_DEFAULT=300

# -- Observability (#99) -------------------------------------------------
# Directory where run traces + JSONL event logs are persisted (one
# subdirectory per run_id, containing trace.json + events.jsonl).
AEAT_RUNS_DIR=var/runs

# -- Schema extraction (aeat.schema, #9) --------------------------------
# Directory where extracted Modelo schemas and provenance manifests live.
AEAT_SCHEMA_CACHE_DIR=var/schema-cache
# Optional JSON-encoded {modelo_code: {boe_ref: url}} override for offline CI.
AEAT_SCHEMA_SOURCE_URLS_OVERRIDE=
# Max parallel BOE PDF fetches during refresh.
AEAT_SCHEMA_EXTRACTION_CONCURRENCY=2

# -- Justificante parser (#44) -------------------------------------------
# Directory where parsed justificante PDFs and their metadata are stored.
AEAT_JUSTIFICANTES_DIR=var/justificantes
# Parser backend for aeat.justificante. PDFPLUMBER is the fidelity-first
# default; PYMUPDF is reserved for a future speed-optimised backend.
AEAT_JUSTIFICANTE_PARSER_BACKEND=PDFPLUMBER

# -- Filing history (#168) -----------------------------------------------
# Directory where the persisted FilingHistory JSON file lives. The
# fetcher writes `history.json` at the root of this directory; when
# AEAT_FILING_HISTORY_ARCHIVE_HTML=1, fetched detail pages are written
# under a `pages/` subdirectory keyed by expediente_id.
AEAT_FILING_HISTORY_DIR=var/filing-history
# TTL in seconds for per-expediente filing-history cache entries.
# Default 15 min mirrors the status-reader cache TTL.
AEAT_FILING_HISTORY_CACHE_TTL_S=900
# If true, archive fetched detail-page HTML alongside the history JSON
# for offline debugging. Off by default.
AEAT_FILING_HISTORY_ARCHIVE_HTML=false
