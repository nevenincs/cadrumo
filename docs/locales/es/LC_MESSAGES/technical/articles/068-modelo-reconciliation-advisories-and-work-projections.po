"acotadas; no quedan intervalos sin leer."

#: ../../technical/articles/068-modelo-reconciliation-advisories-and-work-projections.md:48
msgid ""
"modelo/_m210_rate.py (`src/cadrumo/application/modelo/_m210_rate.py`) — "
"1–208"
msgstr ""
