"acotadas. Los recuentos de líneas son líneas físicas."

#: ../../technical/articles/128-governed-facts-and-export-conversion.md:48
msgid ""
"registry/export_literal_fact.py "
"(`src/cadrumo/domain/calculations/registry/export_literal_fact.py`) — "
"1–84"
msgstr ""
"registry/export_literal_fact.py "
