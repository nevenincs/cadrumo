msgstr "F8"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "Run the next step"
msgstr "Ejecutar el siguiente paso"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "`i`"
msgstr "`i`"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "List what verification found"
msgstr "Listar lo que encontró la verificación"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "`c`"
msgstr "`c`"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
