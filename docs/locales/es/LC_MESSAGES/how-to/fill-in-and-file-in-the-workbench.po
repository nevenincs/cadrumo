#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "`e`"
msgstr "`e`"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "Export"
msgstr "Exportar"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "`?` or F1"
msgstr "`?` o F1"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "Enlarge the help and list every key"
msgstr "Ampliar la ayuda y listar todas las teclas"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
