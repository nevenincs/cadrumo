msgstr "Campo de referencia"

#: ../../reference/registry-legal-api.md
msgid "Meaning"
msgstr "Significado"

#: ../../reference/registry-legal-api.md
msgid "Registry revision"
msgstr "Revisión del registro"

#: ../../reference/registry-legal-api.md
