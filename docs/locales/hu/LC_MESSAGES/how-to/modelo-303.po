msgid "[Review and supply calculation inputs](review-calculation-values.md)"
msgstr ""
"[A számítási bemenetek áttekintése és megadása](review-calculation-"
"values.md)"

#: ../../how-to/modelo-303.md:324
msgid "[Plan your filing calendar](filing-calendar.md)"
msgstr "[Tervezd meg a benyújtási naptáradat](filing-calendar.md)"

#: ../../how-to/modelo-303.md:325
msgid "[Reconcile a filing](reconcile.md)"
msgstr "[Benyújtás egyeztetése](reconcile.md)"

#: ../../how-to/modelo-303.md:326
msgid "[Diagnose and repair your local setup](troubleshooting.md)"
msgstr "[Diagnosztizáld és javítsd a helyi beállításodat](troubleshooting.md)"

#~ msgid ""
#~ "Casilla 65 (\"% atribuible a la "
#~ "Administración del Estado\") resolves to "
#~ "100 automatically for a común-territory"
#~ " profile, so casilla 66 and the "
#~ "headline casilla 71 (Resultado final) "
#~ "carry the full régimen-general result."
#~ " This tool supports común-territory "
#~ "profiles only; foral regimes are refused"
#~ " at profile creation."
#~ msgstr ""
#~ "A 65-ös casilla („% atribuible a "
#~ "la Administración del Estado”) egy "
#~ "común-területű profil esetén automatikusan "
#~ "100-ra oldódik fel, így a 66-os "
#~ "casilla és a fő 71-es casilla "
#~ "(Resultado final) a teljes régimen "
#~ "general eredményt hordozza. Ez az eszköz"
#~ " csak común-területű profilokat támogat;"
