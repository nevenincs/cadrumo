msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Modelo 131"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Art. 109 activity-income coverage exception applies"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Removes the Modelo 130 obligation"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Charges VAT under the general regime"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Modelo 303 (quarterly), Modelo 390 (annual)"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Pays employees or professionals with withholding"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Modelo 111 (quarterly), Modelo 190 (annual)"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Pays business-premises rent with withholding"
msgstr ""

#: ../../how-to/profile-setup.md:221
msgid "Modelo 115 (quarterly), Modelo 180 (annual)"
