msgid "`src/cadrumo/entrypoints/cli/_action_rendering.py`"
msgstr "`src/cadrumo/entrypoints/cli/_action_rendering.py`"

#: ../../technical/articles/156-cli-command-contracts-and-operator-surfaces.md:52
msgid "`src/cadrumo/entrypoints/cli/_actividad_asset_cli.py`"
msgstr "`src/cadrumo/entrypoints/cli/_actividad_asset_cli.py`"

