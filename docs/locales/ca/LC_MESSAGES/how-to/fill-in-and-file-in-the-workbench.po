msgstr "«"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "From an earlier declaration"
msgstr "D'una declaració anterior"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "Carried from a declaration you recorded before"
msgstr "Portat d'una declaració que vas registrar abans"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "◇"
msgstr "◇"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "Reference value"
msgstr "Valor de referència"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
msgid "The official form fixes it"
msgstr "El fixa el model oficial"

#: ../../how-to/fill-in-and-file-in-the-workbench.md
