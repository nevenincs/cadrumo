:seed: renta-2025
@setup aeat --format json app modelo work create --modelo 100 --year 2025 --period 0A
@setup aeat --format json app ledger retencion-soportada record B00010009 --ejercicio 2025 --income-class trabajo --origin operator_declaration --retencion 2400 --ingreso-a-cuenta 0 --importe-integro 24000 --payer-name "Pagador Sintetico SL"
@setup aeat --format json app modelo work calculate --modelo 100 --year 2025 --period 0A --casilla 0003=24000 --binding renta-base-liquidable-negativa-general-anterior=0 --binding renta-base-liquidable-negativa-general-em4-pendiente-inicio=0 --binding renta-base-liquidable-negativa-general-em3-pendiente-inicio=0 --binding renta-base-liquidable-negativa-general-em2-pendiente-inicio=0
@step Read the saved calculation notes behind the calculated figures.
aeat app modelo work observations --modelo 100 --year 2025 --period 0A
@step Show the saved calculation's persisted values.
aeat app modelo work revision --modelo 100 --year 2025 --period 0A
@step Look up one box's definition, with its legal references.
@result aeat --format json app modelo casilla 100 0003 --period 0A
@expect result.casilla_id == "0003"
@expect result.legal_refs[0] == "ley-35-2006:art-17"
@expect exit_code == 0
