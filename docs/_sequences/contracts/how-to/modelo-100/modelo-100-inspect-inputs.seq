:seed: renta-2025
@setup aeat --format json app modelo work create --modelo 100 --year 2025 --period 0A
@setup aeat --format json app modelo work calculate --modelo 100 --year 2025 --period 0A --casilla 0003=24000 --binding renta-certificado-trabajo-retenciones=2400 --binding renta-base-liquidable-negativa-general-anterior=0
@step List the boxes whose source has not supplied a value.
aeat app modelo bindings list --modelo 100 --year 2025 --period 0A --missing
@step List the boxes the declaration requires.
aeat app modelo casillas 100 --period 0A --required
@step Show the saved calculation notes behind the calculated figures.
@result aeat --format json app modelo work observations --modelo 100 --year 2025 --period 0A
@expect exit_code == 0
@expect result.observations[0].casilla_id == "0002"
