:seed: autonomo-irpf-2026
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@setup aeat --format json app modelo work attest-m303-exonerado-390 --year 2026 --period 1T --observed-at 2026-03-31T12:00:00+00:00
@capture m303_attestation_id result.attachment_id
@capture m303_attestation_sha256 result.sha256
@setup aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --no-joint-return-elected --no-annual-volume-nonzero --m303-exonerado-390-attachment-id {m303_attestation_id} --m303-exonerado-390-sha256 {m303_attestation_sha256}
@step List which casillas are still missing a bound value.
aeat --format json app modelo bindings list --modelo 303 --year 2026 --period 1T --missing
@step List the casillas the modelo requires.
@result aeat --format json app modelo casillas 303 --period 1T --required
@expect result.casilla_count == 2
@expect exit_code == 0
