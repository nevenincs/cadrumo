:seed: autonomo-irpf-2026
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@setup aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --no-joint-return-elected
@step List the boxes whose source has not supplied a value.
aeat app modelo bindings list --modelo 303 --year 2026 --period 1T --missing
@step List the boxes the modelo requires.
@result aeat --format json app modelo casillas 303 --period 1T --required
@expect result.casilla_count == 2
@expect exit_code == 0
