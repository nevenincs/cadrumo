:seed: iva-year-2025
@setup aeat --format json app modelo work create --modelo 390 --year 2025 --period 0A
@step Supply reviewed 303-derived values explicitly when the calculation lacks them.
@result aeat --format json app modelo work calculate --modelo 390 --year 2025 --period 0A --binding modelo-390-prev-303-cuota-devengada-total=4386.00 --binding modelo-390-prev-303-cuota-deducible-total=3492.30 --binding modelo-390-prev-303-resultado-regimen-general=893.70
@expect result.casilla_values["iva.anual.reconciliacion.devengada-303"] == "4386.00"
@expect result.casilla_values["iva.anual.reconciliacion.deducible-303"] == "3492.30"
@expect result.casilla_values["iva.anual.reconciliacion.resultado-303"] == "893.70"
@expect exit_code == 0
