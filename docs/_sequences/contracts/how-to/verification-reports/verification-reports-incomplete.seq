:seed: autonomo-irpf-2026
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@step Check which input kind each box is; only manual boxes accept --casilla.
aeat --format json app modelo casillas 303 --period 1T
@expect result.modelo == "303"
@setup aeat --format json app modelo work attest-m303-exonerado-390 --year 2026 --period 1T --observed-at 2026-03-31T12:00:00+00:00
@capture m303_attestation_id result.attachment_id
@capture m303_attestation_sha256 result.sha256
@step Supply a manual casilla's value and recalculate.
@result aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --no-joint-return-elected --no-annual-volume-nonzero --m303-exonerado-390-attachment-id {m303_attestation_id} --m303-exonerado-390-sha256 {m303_attestation_sha256} --casilla 44=150.00
@expect result.casilla_values.44 == "150.00"
@expect result.casilla_values["iva.cuota-deducible-total"] == "255.00"
@expect exit_code == 0
