:seed: iva-evidence-2026
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@setup aeat --format json app modelo work attest-m303-exonerado-390 --year 2026 --period 1T --observed-at 2026-03-31T12:00:00+00:00
@capture m303_attestation_id result.attachment_id
@capture m303_attestation_sha256 result.sha256
@setup aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --no-joint-return-elected --no-annual-volume-nonzero --m303-exonerado-390-attachment-id {m303_attestation_id} --m303-exonerado-390-sha256 {m303_attestation_sha256}
@setup aeat --format json app modelo work verify --modelo 303 --year 2026 --period 1T
@step Check where your filing stands.
aeat --format json app modelo work status --modelo 303 --year 2026 --period 1T
@expect result.modelo == "303"
@step Verified-complete is necessary but not sufficient: export refuses until reviewed product/software identity authority is available.
@result aeat --format json app modelo export --modelo 303 --year 2026 --period 1T --output ./modelo-303.boe
@expect exit_code == 2
@expect error.code == "REFUSED_MODELO_EXPORT_PRODUCT_IDENTITY_UNAVAILABLE"
