:seed: iva-evidence-2026
@step Create the work unit for the filing target.
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@capture work_unit_id result.work_unit_id
@step Record another sale so this exact-reference example owns a fresh calculation revision under cumulative page execution.
@setup aeat app ledger add --date 2026-03-25 --amount 60.50 --direction INCOMING --description "Exact reference transition sale" --classification BUSINESS --taxable-base 50 --iva-rate 0.21 --iva-amount 10.50 --iva-category domestic_general --idempotency-key filing-spine-exact-reference-transition
@step Calculate the quarter so a saved revision carries a reference number.
@setup aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --m303-filing-evidence fixtures/m303-filing-evidence-2026-1T.json
@capture revision_id result.calculation_revision_id
@step Verify a specific calculation by its reference number.
aeat --format json app modelo work verify {revision_id}
@step File a specific calculation by its reference number.
aeat --format json app modelo work file {revision_id}
@step Address an export by reference numbers; Modelo 303 still refuses without reviewed product/software identity authority.
@result aeat --format json app modelo export {work_unit_id} --revision {revision_id} --output ./modelo-303.boe
@expect exit_code == 5
@expect error.code == "FAIL_MODELO_EXPORT"
