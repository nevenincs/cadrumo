:seed: iva-evidence-2026
@step Create the declaration for the filing target.
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@step Calculate the quarter's VAT from the classified records.
@setup aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --no-joint-return-elected
@step Check the calculated draft.
@setup aeat --format json app modelo work verify --modelo 303 --year 2026 --period 1T
@step Record the filing of the current checked calculation in Cadrumo.
@result aeat --format json app modelo work file --modelo 303 --year 2026 --period 1T
@expect exit_code == 0
@expect result.kind == "internal_filing"
@expect result.live_submission == false
@expect result.aeat_accepted == false
@expect result.status == "vigente"
