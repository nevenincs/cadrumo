@step Import a quarter so there is a row to override.
@setup aeat app ledger import --file fixtures/movimientos-2026-1t.csv --provider csv
@step Classify the row manually; a manual decision always wins.
@result aeat --format json app ledger classify 1703f840 --classification BUSINESS --category-id material_oficina
@expect result.transaction.business_classification == "BUSINESS"
