@step Import a quarter so there is a transaction to inspect.
@setup aeat app ledger import --file fixtures/movimientos-2026-1t.csv --provider csv
@step Inspect the transaction.
aeat app ledger view 1703f840
@step Read the transaction's history.
@result aeat --format json app ledger history 1703f840
@expect result.transaction_id == "1703f840306efe4e82a72896e92e7c236245ec85348834b2c10b120c67fe087d"
