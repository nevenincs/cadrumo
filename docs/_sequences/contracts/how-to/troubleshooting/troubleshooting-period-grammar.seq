:seed: filing-spine-303-ledger
@setup aeat --format json app modelo work create --modelo 303 --year 2026 --period 1T
@step Run a quarterly ledger preflight.
aeat app ledger preflight --year 2026 --period 1T
@step Read the ledger for the annual period.
aeat app ledger status --year 2026 --period 0A
@step Run a monthly ledger preflight.
aeat app ledger preflight --year 2026 --period 03
@setup aeat --format json app modelo work attest-m303-exonerado-390 --year 2026 --period 1T --observed-at 2026-03-31T12:00:00+00:00
@capture m303_attestation_id result.attachment_id
@capture m303_attestation_sha256 result.sha256
@step The same token shape addresses a modelo calculation.
@result aeat --format json app modelo work calculate --modelo 303 --year 2026 --period 1T --no-joint-return-elected --no-annual-volume-nonzero --m303-exonerado-390-attachment-id {m303_attestation_id} --m303-exonerado-390-sha256 {m303_attestation_sha256}
@expect result.saved == true
@expect exit_code == 0
