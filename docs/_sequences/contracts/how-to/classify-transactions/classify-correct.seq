@step Import the quarter's movements so there is a row to reclassify.
@setup aeat app ledger import --file fixtures/movimientos-2026-1t.csv --provider csv
@setup aeat app ledger classify 1703f840 --classification BUSINESS --category-id material_oficina
@step Re-classify the same row as personal.
aeat app ledger classify 1703f840 --classification PERSONAL
@step Confirm the row now reads personal.
@result aeat --format json app ledger view 1703f840
@expect result.transaction.business_classification == "PERSONAL"
