@step Record when the activity started so both quarters are valid obligations.
@setup aeat config profile edit docs-sequence-sandbox --quiet --accept-defaults --activity-start-date 2026-01-01 --irpf-estimation-regime directa_simplificada --irpf-activity-income-imputation-criterion cobros_y_pagos --irpf-activity-income-imputation-year 2026 --no-irpf-codigo-comercio-accounting
@step Record the first quarter's sale; the same idempotency key keeps a repeat a no-op.
@setup aeat app ledger add --date 2026-02-10 --amount 1210 --direction INCOMING --description "venta" --classification BUSINESS --taxable-base 1000 --iva-rate 0.21 --iva-amount 210 --idempotency-key irpf-q1-venta
@step Recreate the first quarter's linked expense; its idempotency key preserves the same records when following the page in order.
@setup aeat --format json app ledger evidence add fixtures/factura-material-oficina.pdf --supplier "Papeleria Central SL" --invoice-number C-2026-0087 --invoice-date 2026-02-11 --taxable-base 500 --iva-rate 21 --iva-amount 105
@capture first_quarter_evidence_id result.evidence_id
@setup aeat app ledger add --date 2026-02-11 --amount 605 --direction OUTGOING --description "compra" --classification BUSINESS --category-id material_oficina --taxable-base 500 --iva-rate 0.21 --iva-amount 105 --purchase-invoice-evidence-id {first_quarter_evidence_id} --idempotency-key irpf-q1-compra
@step Prepare and file the first quarter, the record this quarter's carries read.
@setup aeat app modelo work create --modelo 130 --year 2026 --period 1T
@setup aeat app modelo work calculate --modelo 130 --year 2026 --period 1T --binding modelo-130-resultados-negativos-anteriores=0 --binding modelo-130-pagos-fraccionados-anteriores=0 --binding irpf.previous_year_economic_activity_net_income=0
@setup aeat app modelo work verify --modelo 130 --year 2026 --period 1T
@setup aeat app modelo work file --modelo 130 --year 2026 --period 1T
@step Register this quarter's purchase invoice, and take its supporting document reference from the output.
aeat --format json app ledger evidence add fixtures/factura-material-oficina.pdf --supplier "Papeleria Central SL" --invoice-number C-2026-0142 --invoice-date 2026-06-05 --taxable-base 250 --iva-rate 21 --iva-amount 52.50
@capture material_evidence_id result.evidence_id
@step Record the second quarter's three movements.
aeat app ledger add --date 2026-04-15 --amount 2420 --direction INCOMING --description "proyecto abril" --classification BUSINESS --taxable-base 2000 --iva-rate 0.21 --iva-amount 420
aeat app ledger add --date 2026-05-20 --amount 1210 --direction INCOMING --description "proyecto mayo" --classification BUSINESS --taxable-base 1000 --iva-rate 0.21 --iva-amount 210
aeat app ledger add --date 2026-06-05 --amount 302.50 --direction OUTGOING --description "material" --classification BUSINESS --category-id material_oficina --taxable-base 250 --iva-rate 0.21 --iva-amount 52.50 --purchase-invoice-evidence-id {material_evidence_id}
@step Create the second-quarter draft.
aeat app modelo work create --modelo 130 --year 2026 --period 2T
@step Calculate it with no input zeros; the carries resolve from the filed first quarter.
aeat --format json app modelo work calculate --modelo 130 --year 2026 --period 2T
@expect result.casilla_values.01 == "4000"
@expect result.casilla_values.02 == "912.50"
@expect result.casilla_values["provisiones-gastos-dificil-justificacion"] == "162.50"
@expect result.casilla_values.03 == "3087.50"
@expect result.casilla_values.04 == "617.50"
@expect result.casilla_values.05 == "95.00"
@expect result.casilla_values.13 == "100.00"
@expect result.casilla_values.14 == "422.50"
@expect result.casilla_values.15 == "5.00"
@expect result.casilla_values.19 == "417.50"
@expect result.casilla_values["saldo-negativo-fin-periodo"] == "0.00"
@step Check the second quarter, exactly as in the first.
aeat --format json app modelo work verify --modelo 130 --year 2026 --period 2T
@expect result.granted_verificado_completo == true
@step Export the checked quarter to the official record layout.
@result aeat --format json app modelo export --modelo 130 --year 2026 --period 2T --output ./modelo-130-2026-2T.boe
@expect exit_code == 0
@expect result.modelo == "130"
@expect result.format == "fichero-boe"
@static aeat app modelo work file --modelo 130 --year 2026 --period 2T
@blocked obligation-window Refused NO_PENDING_OBLIGATION, no pending filing obligation at the current date: the July window is shut at the sandbox's frozen 1 April instant.
@static aeat app modelo reconcile pull --modelo 130 --year 2026 --period 2T
@blocked live-aeat The pull verb fetches from the AEAT sede; the sandbox refuses live frames.
