@step Inspect the root profile-authentication channels.
aeat --help

@step Inspect the login secret channels.
aeat config login --help

@step Inspect the profile-creation secret channels.
aeat config profile create --help

@step Inspect the passphrase-change secret channels.
aeat config passphrase change --help

@step Inspect the profile-restore secret channels.
aeat config profile restore --help

@step Inspect the certificate-passphrase secret channels.
@result aeat config auth certificate secret set --help
@expect exit_code == 0
