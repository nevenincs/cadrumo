:seed: quickstart-ledger
@step Register the supplier's purchase invoice as encrypted evidence.
aeat --format json app ledger evidence add fixtures/factura-material-oficina.pdf --supplier "Papeleria Central SL" --invoice-number C-2026-0087 --invoice-date 2026-02-11 --taxable-base 500 --iva-rate 0.21 --iva-amount 105
@capture evidence_id result.evidence_id
@step Read back the expense row's id. Repeating the add with its key returns the stored row.
aeat --format json app ledger add --date 2026-02-11 --amount 605 --direction OUTGOING --description "compra" --classification BUSINESS --category-id material_oficina --taxable-base 500 --iva-rate 0.21 --iva-amount 105 --idempotency-key qs-compra
@capture expense_id result.transaction_id
@step Link the invoice to the expense so the deducted IVA can be defended.
aeat --format json app ledger attach {expense_id} --purchase-invoice-evidence-id {evidence_id}
@expect exit_code == 0
@step Open, calculate, and verify the first-quarter Modelo 130 draft.
@setup aeat app modelo work create --modelo 130 --year 2026 --period 1T
@setup aeat app modelo work calculate --modelo 130 --year 2026 --period 1T --binding modelo-130-resultados-negativos-anteriores=0 --binding modelo-130-pagos-fraccionados-anteriores=0 --binding irpf.previous_year_economic_activity_net_income=0
@setup aeat app modelo work verify --modelo 130 --year 2026 --period 1T
@step Export the verified draft to a local fichero-BOE.
@result aeat --format json app modelo export --modelo 130 --year 2026 --period 1T --output ./modelo-130-2026-1T.boe
@expect result.byte_size == 946
@expect exit_code == 0
