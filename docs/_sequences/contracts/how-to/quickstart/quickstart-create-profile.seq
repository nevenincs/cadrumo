@step Create your taxpayer profile with your own details.
@result aeat --format json config profile create me --quiet --tax-residence-jurisdiction-scope common_regime --entity-type natural_person --tax-id 87654321X --name "Ana" --surnames "Garcia Lopez" --activity "consultoria" --activity-start-date 2026-01-01
@expect result.status == "created"
@expect result.active_profile == "me"
@expect exit_code == 0
