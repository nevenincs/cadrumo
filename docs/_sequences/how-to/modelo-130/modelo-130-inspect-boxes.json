            {"binding":"modelo-130-actividad-economica-ingresos-cumulative","casilla_id":"01","data_type":"money","form_number":null,"formula":null,"help_text":"Total cumulative business income for the tax year.","input_kind":"bound","label":"Income","legal_refs":["rd-439-2007:art-110","orden-eha-672-2007:art-1","ley-35-2006:art-99","rd-439-2007:art-95","ley-35-2006:art-27","ley-35-2006:art-28"],"number":"01","required":false,"section":["actividades_economicas_estimacion_directa"],"source_refs":["aeat-dr-130-2019-v12","aeat-modelo-130-instructions"]},
            {"binding":null,"casilla_id":"02","data_type":"money","form_number":null,"formula":"modelo-130-gastos","help_text":"Cumulative deductible expenses and amortization of the economic activity. Under simplified direct estimation it also includes the deductible provisions and hard-to-justify expenses.","input_kind":"computed","label":"Expenses","legal_refs":["rd-439-2007:art-110","orden-eha-672-2007:art-1","ley-35-2006:art-99","rd-439-2007:art-95","ley-35-2006:art-28","ley-35-2006:art-30","rd-439-2007:art-30"],"number":"02","required":true,"section":["actividades_economicas_estimacion_directa"],"source_refs":["aeat-dr-130-2019-v12","aeat-modelo-130-instructions"]},
