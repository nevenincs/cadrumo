@step Record the compensation balance the 2025 first quarter starts from, as the persona's figures state.
@setup aeat --format json app modelo iva-wallet seed --filing-year 2024 --period 4T --amount 0 --confirm
@step Open, calculate, verify and record as filed the 2025 1T Modelo 303.
@setup aeat --format json app modelo work create --modelo 303 --year 2025 --period 1T
@capture m303_1t_work_unit_id result.work_unit_id
@setup aeat --format json app modelo work calculate {m303_1t_work_unit_id} --no-joint-return-elected
@capture m303_1t_calculation_revision_id result.calculation_revision_id
@setup aeat --format json app modelo work verify {m303_1t_calculation_revision_id}
@setup aeat --format json app modelo work file {m303_1t_calculation_revision_id}
@step Open, calculate, verify and record as filed the 2025 2T Modelo 303.
@setup aeat --format json app modelo work create --modelo 303 --year 2025 --period 2T
@capture m303_2t_work_unit_id result.work_unit_id
@setup aeat --format json app modelo work calculate {m303_2t_work_unit_id} --no-joint-return-elected
@capture m303_2t_calculation_revision_id result.calculation_revision_id
@setup aeat --format json app modelo work verify {m303_2t_calculation_revision_id}
@setup aeat --format json app modelo work file {m303_2t_calculation_revision_id}
