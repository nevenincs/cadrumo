@capture m303_4t_attestation result.attachment_id
@capture m303_4t_attestation_sha256 result.sha256
@setup aeat --format json app modelo work calculate {m303_4t_work_unit_id} --no-joint-return-elected --m303-exonerado-390-attachment-id {m303_4t_attestation} --m303-exonerado-390-sha256 {m303_4t_attestation_sha256}
@capture m303_4t_calculation_revision_id result.calculation_revision_id
