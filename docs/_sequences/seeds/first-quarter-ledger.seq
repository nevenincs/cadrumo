:persona: autonomo-alta-reciente
:profile: activity-start-date
@step State when the activity started so every quarter of the year is a valid obligation.
:generated: begin
@setup aeat config profile edit docs-sequence-sandbox --quiet --activity-start-date 2026-01-01
:generated: end
@step Bring the quarter's movements into the ledger; already-imported rows are skipped.
@setup aeat app ledger import --file fixtures/movimientos-2026-1t.csv --provider csv
@step Classify the collected payment as business income, with its tax fields.
@setup aeat app ledger classify 21853f4f --classification BUSINESS --taxable-base 1000 --iva-rate 0.21 --iva-amount 210
@step Classify the purchase as a deductible business expense.
@setup aeat app ledger classify 1703f840 --classification BUSINESS --category-id material_oficina --taxable-base 500 --iva-rate 0.21 --iva-amount 105 --deduction-kind domestic_current
@step Register the supplier's purchase invoice as encrypted evidence bytes.
@setup aeat --format json app ledger evidence add fixtures/factura-material-oficina.pdf --supplier "Papeleria Central SL" --invoice-number C-2026-0087 --invoice-date 2026-02-11 --taxable-base 500 --iva-rate 21 --iva-amount 105 --idempotency-key fq-factura
@capture evidence_id result.evidence_id
@step Attach the purchase-invoice evidence to the deductible expense so the input IVA can be deducted.
@setup aeat app ledger attach 1703f840 --purchase-invoice-evidence-id {evidence_id}
