{
  "mcpServers": {
    "vaultspec-core": {
      "command": "uvx",
      "args": [
        "--from",
        "vaultspec-core",
        "python",
        "-m",
        "vaultspec_core.mcp_server.app"
      ]
    },
    "vaultspec-rag": {
      "command": "uvx",
      "args": [
        "--from",
        "vaultspec-rag[gpu,mcp]",
        "python",
        "-m",
        "vaultspec_rag.server"
      ]
    }
  }
}
