    aeat.domain.fincas.test_repository -> aeat.adapters.persistence.storage.crypto._crypto
    aeat.domain.fincas.test_repository -> aeat.adapters.persistence.storage.sql._orm
    aeat.domain.fincas.test_roundtrip_anti_tautology -> aeat.adapters.persistence.storage
    aeat.domain.fincas.test_roundtrip_anti_tautology -> aeat.adapters.persistence.storage.crypto._crypto
    aeat.domain.fincas.test_roundtrip_anti_tautology -> aeat.adapters.persistence.storage.sql._orm
    aeat.domain.invoices.test_secure_storage_roundtrip -> aeat.adapters.persistence.storage
