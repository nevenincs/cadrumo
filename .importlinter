    aeat.domain.usage_ratios.tests.test_censo_refuse_load -> aeat.adapters.persistence.profile.usage_ratios
    aeat.domain.usage_ratios.tests.test_service -> aeat.adapters.persistence.profile.usage_ratios
    aeat.domain.usage_ratios.tests.test_service -> aeat.adapters.persistence.storage
    aeat.domain.usage_ratios.tests.test_service -> aeat.adapters.persistence.storage.errors

[importlinter:contract:core-not-outer]
name = Core must not import outer layers
# ── S22: Core must not import outer layers ────────────────────────────────────
# Core is the innermost layer and must not import from domain, application,
# adapters, or entrypoints. The production violations were resolved in
# Wave 3 P04:
# - core/errors/__init__.py: SiteHealthStatus TYPE_CHECKING import replaced
#   with SiteHealthStatusProtocol declared in core.
# - core/errors/_registry.py: entrypoints.cli._i18n import replaced with
#   core.i18n.
# - core/i18n/_render.py: application imports replaced with a registered
#   callback (register_profile_language_resolver).
# Core test files that pull application / domain fixtures for integration tests
# are permitted per project convention.
#
# core.resources._repos deferred loader imports (resource-management-api ADR,
# 2026-05-16): the resource-management-api ADR explicitly places the concrete
# Repository implementations under core/resources/ ("Repository implementations
# reference [domain models] but the Repository class hierarchy itself is
# core-layer infrastructure") AND chose lazy loading as the default (ADR Q5:
# "each Repository's get(key) loads on demand"; "the eager imports disappear").
# Each loader below is a *function-local* import inside a Repository._load /
# _resolve_authority method -- it runs only at first resource access, never at
# module-import time, so core/resources/ stays an acyclic leaf in the module
# graph. The runtime dependency direction is a deliberate, ADR-sanctioned
# consequence of co-locating the single resource boundary in core. Each edge is
# pinned individually (no wildcard) so a NEW non-deferred core->outer import is
# still caught. Test files importing domain errors are permitted per convention.
unmatched_ignore_imports_alerting = error
type = forbidden
source_modules =
    aeat.core
forbidden_modules =
    aeat.domain
    aeat.application
    aeat.adapters
    aeat.entrypoints
ignore_imports =
    # ── W09: re-sanctioned test-file roundtrip/fixture/oracle edges (prior ignores went stale on test rename) ──
    aeat.core.tests.test_external_constants_centralisation_part2 -> aeat.domain.iva
    aeat.core.tests.test_modelo -> aeat.application.modelo
    aeat.core.tests.test_modelo -> aeat.domain.calculations.registry
    aeat.core.tests.test_modelo -> aeat.domain.modelos
    aeat.core.tests.test_service_capability -> aeat.domain.user_profile
    aeat.core.tests.test_logging -> aeat.adapters.inbound.pdf._pdfplumber
    # test_setup_answers's wizard._catalogue import went stale (test-topology
    # refactor); its domain.deadlines import is a real function-local edge
    # (see below), re-pinned at module granularity.
    aeat.core.tests.test_wizard_catalogue -> aeat.application.wizard._catalogue
    aeat.core.tests.test_setup_answers -> aeat.domain.deadlines
    aeat.core.tests.test_setup_answers -> aeat.domain.deadlines._profiles
    # test_external_constants_centralisation_part2 imports aeat.tests.leaf_name
    # (module-level, not previously pinned - new edge from the test-topology
    # refactor's shared test-helper consolidation).
    aeat.core.tests.test_external_constants_centralisation_part2 -> aeat.tests
    # test_external_constants imports domain.portals via function-local
    # imports (not top-of-file), confirmed live by lint-imports transitive
    # trace; re-pinned at module granularity (the ._entries._common
    # deep-submodule ignore was stale).
    aeat.core.tests.test_external_constants -> aeat.domain.portals
    # ── core test files importing application/domain/adapters for fixtures ──
    # test_clock verifies the calc-sheets ``_utc_now`` alias follows the core
    # clock seam (it IS ``core.time.now``); a deliberate cross-layer seam check.
    aeat.core.time.tests.test_clock -> aeat.application.storage.calc_sheets._records
    # test_golden (observability replay) pulls a domain user_profile fixture.
    aeat.core.observability.tests.test_golden -> aeat.domain.user_profile
    # test_external_constants now uses ast/tomllib static analysis only; it no
    # longer imports domain.portals at runtime (import-centralization
    # refactor). Prior ignores went stale.
    aeat.core.tests.test_external_constants_centralisation_part1 -> aeat.adapters.persistence.storage.blob_store
    aeat.core.tests.test_external_constants_centralisation_part1 -> aeat.application.ledger
    aeat.core.tests.test_paths -> aeat.adapters.outbound.storage._local
    aeat.core.tests.test_paths -> aeat.adapters.persistence.storage
    aeat.core.tests.test_paths -> aeat.domain.user_profile
    # ── core/resources/_repos deferred loader imports (ADR-sanctioned, see above) ──
    aeat.core.resources._repos.apoderamientos -> aeat.domain.auth.apoderamientos
    aeat.core.resources._repos.category_profiles -> aeat.domain.categories
    aeat.core.resources._repos.holiday_calendars -> aeat.domain.deadlines
    aeat.core.resources._repos.legal_parameters -> aeat.domain.calculations.registry
    aeat.core.resources._repos.manuals -> aeat.domain.manuals
    aeat.core.resources._repos.modelos -> aeat.domain.calculations.registry
    aeat.core.resources._repos.iva_catalogues -> aeat.domain.iva
    aeat.core.resources._repos.iva_rate_tables -> aeat.domain.iva
    aeat.core.resources._repos.recargo_bands -> aeat.domain.deadlines
    aeat.core.resources._repos.user_profile -> aeat.domain.user_profile
    # ── core/resources/_repos test files importing domain modules for fixtures (test-topology refactor) ──
    aeat.core.resources._repos.tests.test_manuals -> aeat.domain.manuals
    aeat.core.resources._repos.tests.test_singletons -> aeat.domain.auth.apoderamientos
    aeat.core.resources._repos.tests.test_singletons -> aeat.domain.calculations.registry
    aeat.core.resources._repos.tests.test_singletons -> aeat.domain.user_profile

[importlinter:contract:layered]
name = AEAT layered architecture
# ── S23: Full layered architecture contract ───────────────────────────────────
# The broad layered contract enforces hexagonal direction across all layers.
# Layer order (outer → inner): entrypoints > adapters > application > domain > core
#
# Per the restructure ADR (2026-04-30 sec. 538), application/ is permitted to
# import from adapters/ directly (outbound adapter wiring). The exception
# ledger now pins each existing application source module individually;
# full inversion remains deferred, but new source modules fail loudly.
#
# Test files across all layers are permitted to cross layer boundaries for
# fixture setup; these are covered by individual entries below.
#
# Domain repositories that directly import the SQL persistence substrate are
# grandfathered in via individual narrow entries.
unmatched_ignore_imports_alerting = error
type = layers
layers =
    aeat.entrypoints
    aeat.adapters
    aeat.application
    aeat.domain
    aeat.core
exhaustive = false
ignore_imports =
    # ── W09.P26: grimp-verified sanctioned test-source roundtrip/fixture/oracle edges (roundtrip-discipline rule) ──
    aeat.application.aggregation.tests.test_fx_conversion -> aeat.adapters.persistence.storage.sql
    aeat.application.aggregation.tests.test_iva_ledger -> aeat.adapters.persistence.storage.sql
    aeat.application.aggregation.tests.test_modelo_source_mesh_ledger -> aeat.adapters.persistence.storage.sql
    aeat.application.aggregation.tests.test_modelo_source_mesh_ledger -> aeat.tests.secure_sql
    aeat.application.aggregation.tests.test_renta_income_aggregation -> aeat.adapters.persistence.storage.sql
    aeat.application.aggregation.tests.test_renta_ledger -> aeat.adapters.persistence.storage.sql
    aeat.application.aggregation.tests.test_renta_ledger -> aeat.tests.secure_sql
    aeat.application.aggregation.tests.test_source_mesh -> aeat.adapters.persistence.storage.errors
    aeat.application.aggregation.tests.test_source_mesh_profile_live -> aeat.adapters.outbound.aeat.sede
