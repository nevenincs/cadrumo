[importlinter]
root_package = aeat
include_external_packages = False

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). Promoting the dependency through
# application/aggregation is the correct fix; the contract below blocks
# direct cross-package imports.
# Two import edges currently violate it and are explicitly ignored until
# Wave 2 Phase P04 lands the migration.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Both edges are part of the same F7 family. Remove these ignores when
# Wave 2 P04.S13 / S14 / S16 complete and RentaDeductibleExpenseObservation
# is reachable from application/aggregation instead.
ignore_imports =
    aeat.domain.calculations.registry._bindings -> aeat.domain.renta
    aeat.domain.calculations.registry.test_ledger_renta_expense_binding -> aeat.domain.renta

# ── Layered architecture (hexagonal direction) ───────────────────────────────
# Stub — enabling the layered contract surfaces ~30 legitimate architectural
# violations plus many test-pattern edges (live-test files importing CLI
# entrypoints). Wave 2 Phase P06.S19 lands the production-only layered
# contract with proper test-file exclusions. The stub below documents the
# intended layering and is commented out until then.
#
# [importlinter:contract:layered]
# name = AEAT layered architecture
# type = layers
# layers =
#     aeat.entrypoints
#     aeat.adapters
#     aeat.application
#     aeat.domain
#     aeat.core
# exhaustive = false
