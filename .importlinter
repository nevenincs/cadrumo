[importlinter]
root_package = aeat
include_external_packages = False
# Exclude TYPE_CHECKING-guarded imports from the import graph so that
# type-annotation-only imports do not trigger layer-direction contracts.
# Runtime behaviour is unaffected; only import-time side effects are analysed.
exclude_type_checking_imports = True

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). It is resolved via Protocol-based
# dependency inversion: the registry validator declares the abstract
# CrossDomainSnapshotCheck Protocol and a register_cross_domain_snapshot_check()
# injection point; the concrete renta first-slice routing check lives in
# aeat.domain.renta._first_slice_routing_integrity and registers itself at
# renta package import time. The registry never names renta. The test edge
# below remains a legitimate cross-domain reference for integration tests.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Test modules that construct domain objects for registry integration tests
# are permitted to import domain.renta directly - they are not production code.
ignore_imports =
    aeat.domain.calculations.registry.test_ledger_renta_expense_binding -> aeat.domain.renta

# ── S21: Domain must not import application ───────────────────────────────────
# Production domain modules must not import from the application layer.
# The five violations (deadlines/_profiles, profile/_keys) were resolved in
# Wave 3 P04 S16 and S17: _profiles.py now parses canonical tokens directly;
# _keys.py now uses a register_profile_keys() injection point.
# Test files that import application modules for fixture setup are permitted.

[importlinter:contract:domain-not-application]
name = Domain must not import application
type = forbidden
source_modules =
    aeat.domain
forbidden_modules =
    aeat.application
# Lazy function-scoped imports from domain.deadlines and domain.profile
# into application.wizard remain as Wave-future cleanup. Wave 3 P04 set
# up the register_profile_keys() injection pattern; full elimination of
# these five edges requires further refactor not yet scheduled.
#
# core.resources._repos.topics deferred loader import (resource-management-api
# ADR, 2026-05-16): TopicCatalogueRepository._load contains a function-local
# `from aeat.application.topics import load_topic_catalogue` import. It runs
# only at first resource access, never at module-import time, so
# core/resources/ stays an acyclic leaf. The ADR places the concrete
# Repository implementations in core/resources/ and chose lazy loading as the
# default (ADR Q5). This is the same edge the core-not-outer and layered
# contracts already document; this contract reaches it transitively (a domain
# test imports core.resources, which lazily loads core.resources._repos.topics).
# Pinned individually (no wildcard) so a new non-deferred edge is still caught.
ignore_imports =
    aeat.domain.deadlines._profiles -> aeat.application.wizard._catalogue
    aeat.domain.deadlines._profiles -> aeat.application.wizard._persistence
    aeat.domain.deadlines._profiles -> aeat.application.wizard._setup_answers
    aeat.domain.profile._keys -> aeat.application.wizard._catalogue
    aeat.domain.profile._keys -> aeat.application.wizard._compiler
    aeat.core.resources._repos.topics -> aeat.application.topics
    aeat.domain.calculations.registry.test_referential_integrity -> aeat.application.diagnostics
    aeat.domain.calculations.registry.test_cross_boundary_roundtrip -> aeat.application.workflow._models
    aeat.domain.calculations.registry.test_detail_record_modelo_coverage -> aeat.application.storage.calc_sheets
    aeat.domain.invoices.test_reconciliation -> aeat.application.invoices
    aeat.domain.modelos.test_work_unit -> aeat.application.modelo
    aeat.domain.profile.conftest -> aeat.application.wizard._compiler

# ── S22: Core must not import outer layers ────────────────────────────────────
# Core is the innermost layer and must not import from domain, application,
# adapters, or entrypoints. The production violations were resolved in
# Wave 3 P04:
# - core/errors/__init__.py: SiteHealthStatus TYPE_CHECKING import replaced
#   with SiteHealthStatusProtocol declared in core.
# - core/errors/_registry.py: entrypoints.cli._i18n import replaced with
#   core.i18n.
# - core/i18n/_render.py: application imports replaced with a registered
#   callback (register_profile_language_resolver).
# Core test files that pull application / domain fixtures for integration tests
# are permitted per project convention.
#
# core.resources._repos deferred loader imports (resource-management-api ADR,
# 2026-05-16): the resource-management-api ADR explicitly places the concrete
# Repository implementations under core/resources/ ("Repository implementations
# reference [domain models] but the Repository class hierarchy itself is
# core-layer infrastructure") AND chose lazy loading as the default (ADR Q5:
# "each Repository's get(key) loads on demand"; "the eager imports disappear").
# Each loader below is a *function-local* import inside a Repository._load /
# _resolve_authority method -- it runs only at first resource access, never at
# module-import time, so core/resources/ stays an acyclic leaf in the module
# graph. The runtime dependency direction is a deliberate, ADR-sanctioned
# consequence of co-locating the single resource boundary in core. Each edge is
# pinned individually (no wildcard) so a NEW non-deferred core->outer import is
# still caught. Test files importing domain errors are permitted per convention.

[importlinter:contract:core-not-outer]
name = Core must not import outer layers
type = forbidden
source_modules =
    aeat.core
forbidden_modules =
    aeat.domain
    aeat.application
    aeat.adapters
    aeat.entrypoints
ignore_imports =
    # ── core test files importing application/domain/adapters for fixtures ──
    aeat.core.i18n.test_output_language -> aeat.application.user_profile._orchestration
    aeat.core.i18n.test_output_language -> aeat.application.user_profile._testing
    aeat.core.i18n.test_output_language -> aeat.application.workflow._persistence
    aeat.core.i18n.test_output_language -> aeat.adapters.persistence.storage
    aeat.core.i18n.test_output_language -> aeat.adapters.persistence.storage.sql
    aeat.core.i18n.test_output_language -> aeat.domain.user_profile
    aeat.core.test_external_constants -> aeat.domain.portals._categories
    aeat.core.resources._repos.test_manuals -> aeat.domain.manuals.errors
    aeat.core.resources._repos.test_normatives -> aeat.domain.normatives.errors
    # ── core/resources/_repos deferred loader imports (ADR-sanctioned, see above) ──
    aeat.core.resources._repos.apoderamientos -> aeat.domain.auth.apoderamientos
    aeat.core.resources._repos.category_profiles -> aeat.domain.categories
    aeat.core.resources._repos.holiday_calendars -> aeat.domain.deadlines
    aeat.core.resources._repos.iva_catalogues -> aeat.domain.iva._catalogue
    aeat.core.resources._repos.iva_rate_tables -> aeat.domain.iva._rates
    aeat.core.resources._repos.legal_parameters -> aeat.domain.calculations.registry
    aeat.core.resources._repos.manuals -> aeat.domain.manuals
    aeat.core.resources._repos.modelos -> aeat.domain.calculations.registry
    aeat.core.resources._repos.normatives -> aeat.domain.normatives
    aeat.core.resources._repos.recargo_bands -> aeat.domain.deadlines
    aeat.core.resources._repos.topics -> aeat.application.topics
    aeat.core.resources._repos.user_profile -> aeat.domain.user_profile

# ── S23: Full layered architecture contract ───────────────────────────────────
# The broad layered contract enforces hexagonal direction across all layers.
# Layer order (outer → inner): entrypoints > adapters > application > domain > core
#
# Per the restructure ADR (2026-04-30 sec. 538), application/ is permitted to
# import from adapters/ directly (outbound adapter wiring). The wildcard entry
# blanket-permits all application→adapters edges; full inversion deferred.
#
# Test files across all layers are permitted to cross layer boundaries for
# fixture setup; these are covered by individual entries below.
#
# Domain repositories that directly import the SQL persistence substrate are
# grandfathered in via individual narrow entries.

[importlinter:contract:layered]
name = AEAT layered architecture
type = layers
layers =
    aeat.entrypoints
    aeat.adapters
    aeat.application
    aeat.domain
    aeat.core
exhaustive = false
ignore_imports =
    # ── application → adapters (permitted by architecture ADR sec. 538) ──
    # application/ may import adapters/ for outbound wiring; full inversion
    # would require a major refactor and is deferred.
    aeat.application.** -> aeat.adapters.**
    # ── application → entrypoints (test CLI-runner sentinels) ──
    aeat.application.setup.test_cli -> aeat.tests.cli_runner
    aeat.application.test_config_parity -> aeat.tests.cli_runner
    aeat.application.aggregation.test_renta_ledger -> aeat.entrypoints.cli._common
    # ── domain → adapters (repositories backed by persistence substrate) ──
    # Many domain repositories directly import the SQL persistence substrate.
    # Full inversion (Protocol + adapter injection) deferred to a future refactor.
    aeat.domain.attachments.test_repository -> aeat.adapters.persistence.storage
    aeat.domain.attachments.test_repository -> aeat.adapters.persistence.storage.attachment
    aeat.domain.attachments.test_repository -> aeat.adapters.persistence.storage.sql.engine
    aeat.domain.buckets._event_repository -> aeat.adapters.persistence.storage
    aeat.domain.buckets._event_repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.buckets._event_repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.filing._complementaria_repository -> aeat.adapters.persistence.storage
    aeat.domain.filing._complementaria_repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.filing._complementaria_repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.filing._repository -> aeat.adapters.persistence.storage
    aeat.domain.filing._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.invoices._repository -> aeat.adapters.persistence.storage
    aeat.domain.invoices._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.invoices._repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.invoices.test_reconciliation -> aeat.adapters.persistence.storage
    aeat.domain.invoices.test_repository -> aeat.adapters.persistence.storage
    aeat.domain.justificante._repository -> aeat.adapters.persistence.storage
    aeat.domain.justificante._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.justificante.test_repository -> aeat.adapters.persistence.storage
    aeat.domain.justificante.test_repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.justificante.test_repository -> aeat.adapters.persistence.storage.sql.engine
    aeat.domain.justificante.test_repository -> aeat.adapters.persistence.storage.sql.secure_objects
    aeat.domain.justificante.test_secure_storage_roundtrip -> aeat.adapters.persistence.storage
    aeat.domain.justificante.test_secure_storage_roundtrip -> aeat.adapters.persistence.storage.sql
    aeat.domain.justificante.test_secure_storage_roundtrip -> aeat.adapters.persistence.storage.sql._orm
    aeat.domain.justificante.test_secure_storage_roundtrip -> aeat.adapters.persistence.storage.sql.engine
    aeat.domain.modelos._calculation_repository -> aeat.adapters.persistence.storage
    aeat.domain.modelos._calculation_repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.modelos._calculation_repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.modelos._filing_repository -> aeat.adapters.persistence.storage
    aeat.domain.modelos._filing_repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.modelos._filing_repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.modelos._repository -> aeat.adapters.persistence.storage
    aeat.domain.modelos._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.modelos._repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.modelos._verification_repository -> aeat.adapters.persistence.storage
    aeat.domain.modelos._verification_repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.modelos._verification_repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.modelos.test_work_unit -> aeat.adapters.persistence.storage
    aeat.domain.modelos.test_work_unit -> aeat.adapters.persistence.storage.sql
    aeat.domain.modelos.test_work_unit -> aeat.adapters.persistence.storage.sql._orm
    aeat.domain.submission._engine -> aeat.adapters.persistence.storage.errors
    aeat.domain.submission._repository -> aeat.adapters.persistence.storage
    aeat.domain.submission._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.transactions._repository -> aeat.adapters.persistence.storage.envelope._envelope
    aeat.domain.transactions._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.transactions._repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.transactions.test_repository -> aeat.adapters.persistence.storage
    aeat.domain.transactions.test_repository -> aeat.adapters.persistence.storage.sql
    aeat.domain.transactions.test_repository -> aeat.adapters.persistence.storage.sql._orm
    aeat.domain.usage_ratios._service -> aeat.adapters.persistence.storage
    aeat.domain.usage_ratios._service -> aeat.adapters.persistence.storage.errors
    aeat.domain.usage_ratios._service -> aeat.adapters.persistence.storage.sql
    aeat.domain.usage_ratios.test_service -> aeat.adapters.persistence.storage
    aeat.domain.usage_ratios.test_service -> aeat.adapters.persistence.storage.sql.engine
    aeat.domain.usage_ratios.test_service -> aeat.adapters.persistence.storage.sql.secure_objects
    aeat.domain.usage_ratios.test_census_refuse_load -> aeat.adapters.persistence.storage
    aeat.domain.usage_ratios.test_census_refuse_load -> aeat.adapters.persistence.storage.sql.engine
    # ── domain repositories migrated to SecureBoundRepository (envelope substrate) ──
    aeat.domain.filing._repository -> aeat.adapters.persistence.storage.envelope._secure_repository
    aeat.domain.justificante._repository -> aeat.adapters.persistence.storage.envelope._secure_repository
    aeat.domain.submission._repository -> aeat.adapters.persistence.storage.envelope._secure_repository
    aeat.domain.fincas._repository -> aeat.adapters.persistence.storage.errors
    aeat.domain.fincas._repository -> aeat.adapters.persistence.storage.sql._orm
    # ── domain roundtrip / repository test files (real adapters per roundtrip discipline) ──
    aeat.domain.buckets.test_event_history_roundtrip -> aeat.adapters.persistence.storage
    aeat.domain.buckets.test_event_history_roundtrip -> aeat.adapters.persistence.storage.sql
    aeat.domain.buckets.test_event_history_roundtrip -> aeat.adapters.persistence.storage.sql._orm
    aeat.domain.buckets.test_event_history_roundtrip -> aeat.adapters.persistence.storage.sql.engine
    aeat.domain.buckets.test_event_history_roundtrip -> aeat.adapters.persistence.storage.sql.session
    aeat.domain.filing.test_amendment_roundtrip -> aeat.adapters.persistence.storage
    aeat.domain.filing.test_amendment_roundtrip -> aeat.adapters.persistence.storage.sql
    aeat.domain.filing.test_amendment_roundtrip -> aeat.adapters.persistence.storage.sql._orm
