[importlinter]
root_packages =
    cadrumo
    dev
include_external_packages = False
# Exclude TYPE_CHECKING-guarded imports from the import graph so that
# type-annotation-only imports do not trigger layer-direction contracts.
# Runtime behaviour is unaffected; only import-time side effects are analysed.
exclude_type_checking_imports = True

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). It is resolved via Protocol-based
# dependency inversion: the registry validator declares the abstract
# CrossDomainSnapshotCheck Protocol and a register_cross_domain_snapshot_check()
# injection point; the concrete renta first-slice routing check lives in
# cadrumo.domain.renta._first_slice_routing_integrity and registers itself at
# renta package import time. The registry never names renta. The test edge
# below remains a legitimate cross-domain reference for integration tests.

# ── Shipped artefact carries no development tree ─────────────────────────────
# A product install carries src/cadrumo and nothing else: the dev/ tree is in
# neither the wheel nor the sdist. A shipped module that imports it is broken
# for every real user at import time. This replaces a bespoke AST re-reading of
# the same import statements; the rule is now evaluated against the live graph.
#
# Tests under ``src/`` use the repository-level ``test_support`` boundary when
# they need development authoring tooling.  They are included here deliberately:
# a source-tree test import is still a source-tree dependency and must not make
# the distributable package aware of ``dev``.

[importlinter:contract:no-dev-in-shipped]
name = Shipped cadrumo modules must not import the dev tree
type = forbidden
unmatched_ignore_imports_alerting = none
source_modules =
    cadrumo
forbidden_modules =
    dev

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    cadrumo.domain.calculations
forbidden_modules =
    cadrumo.domain.renta
# Test modules that construct domain objects for registry integration tests
# are permitted to import domain.renta directly - they are not production code.
# The test_referential_integrity edge below is the chain origin of an
# indirect path (test -> application.diagnostics -> ... -> sede._declarations
# -> renta): sede._declarations imports the renta package for its
# cross-domain snapshot-check registration side effect, which is a legitimate
# adapter -> domain edge. Pinning the test-module chain origin keeps the
# contract enforcing genuine production calculations -> renta imports while
# excusing the test path. The same edge is already sanctioned in the
# domain-not-application contract.
[importlinter:contract:domain-not-application]
name = Domain must not import application
# ── S21: Domain must not import application ───────────────────────────────────
# Production domain modules must not import from the application layer.
# The five violations (deadlines/_profiles, profile/_keys) were resolved in
# Wave 3 P04 S16 and S17: _profiles.py now parses canonical tokens directly;
# _keys.py now uses a register_profile_keys() injection point.
# Test files that import application modules for fixture setup are permitted.
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    cadrumo.domain
forbidden_modules =
    cadrumo.application
# Production domain -> application coupling is zero. The former
# domain.contribuyente._keys -> application.wizard._compiler lazy edge was
# eliminated by the DB-17 eager-registration bootstrap (importing
# cadrumo.application.wizard pushes PROFILE_KEYS at import time), and the topic
# catalogue loader now reads core.topics (a core -> core edge), so neither
# crosses this boundary any longer. Only sanctioned test/fixture edges remain,
# pinned individually below so a new non-deferred production edge is still caught.
ignore_imports =
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Domain test/conftest modules legitimately import application services
    # for fixture setup, oracle replay, and cross-boundary roundtrip suites
    # (real dependencies, not mocks). This was an enumerated per-test-file
    # list that went stale on every test rename or topology move — the same
    # churn the sibling domain-not-adapters and layered contracts already
    # retired in favour of these wildcards. Production domain -> application
    # coupling is zero and the wildcards are scoped to test packages, so a
    # new production edge still fails loudly here. See
    # `2026-07-08-importlinter-test-carveout-adr`.
    cadrumo.domain.**.tests.** -> cadrumo.application.**
    # conftest.py modules sitting directly in a domain subpackage (not nested
    # under a tests/ folder) are the same fixture pattern — e.g. the profile-key
    # eager registration that imports application.wizard for its side effect.
    cadrumo.domain.**.conftest -> cadrumo.application.**

[importlinter:contract:domain-not-adapters]
name = Domain must not import adapters
# ── arch-remediation-ports-inversion (W04.P10.S20): declare the seam exhaustively ──
# The ports-inversion campaign migrated every production domain repository
# behind a Protocol port with its concrete under adapters.persistence.profile,
# so PRODUCTION domain -> adapters coupling is zero. This first-class forbidden
# contract (sibling of domain-not-application) replaces the per-production-edge
# exception list the layered contract carried: a new non-deferred production
# domain -> adapters import now fails loudly here rather than being absorbed as
# a layered-contract ignore. Only sanctioned test-file roundtrip/anti-tautology
# edges — which legitimately construct the concrete adapter to exercise the
# encrypted boundary end-to-end — remain, pinned individually below.
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: production direct coupling here is zero; transitive
# chains through test files are sanctioned roundtrip noise and the layered
# contract enforces the full ordering comprehensively.
allow_indirect_imports = true
type = forbidden
source_modules =
    cadrumo.domain
forbidden_modules =
    cadrumo.adapters
    cadrumo.llm
ignore_imports =
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Test/conftest modules across the domain layer legitimately construct the
    # concrete persistence adapter to exercise the encrypted storage boundary
    # end-to-end (real adapters, not mocks -- aeat-roundtrip-discipline). Every
    # prior per-file exemption here was a test path; production domain ->
    # adapters coupling is zero (this contract enforces it: the
    # arch-remediation-ports-inversion campaign moved every production domain
    # repository behind a Protocol port). Two wildcards cover a domain test
    # module at any nesting depth (bare `domain.tests.*` and
    # `domain.<pkg...>.tests.*`); a new roundtrip test needs no new exemption
    # line here. See `2026-07-08-importlinter-test-carveout-adr`.
    cadrumo.domain.tests.** -> cadrumo.adapters.**
    cadrumo.domain.**.tests.** -> cadrumo.adapters.**
[importlinter:contract:core-not-outer]
name = Core must not import outer layers
# ── S22: Core must not import outer layers ────────────────────────────────────
# Core is the innermost layer and must not import from domain, application,
# adapters, or entrypoints. The production violations were resolved in
# Wave 3 P04:
# - core/errors/__init__.py: SiteHealthStatus TYPE_CHECKING import replaced
#   with SiteHealthStatusProtocol declared in core.
# - core/errors/_registry.py: entrypoints.cli._i18n import replaced with
#   core.i18n.
# - core/i18n/_render.py: application imports replaced with a registered
#   callback (register_profile_language_resolver).
# Core test files that pull application / domain fixtures for integration tests
# are permitted per project convention.
#
# core.resources._repos deferred loader imports (resource-management-api ADR,
# 2026-05-16): the resource-management-api ADR explicitly places the concrete
# Repository implementations under core/resources/ ("Repository implementations
# reference [domain models] but the Repository class hierarchy itself is
# core-layer infrastructure") AND chose lazy loading as the default (ADR Q5:
# "each Repository's get(key) loads on demand"; "the eager imports disappear").
# Each loader below is a *function-local* import inside a Repository._load /
# _resolve_authority method -- it runs only at first resource access, never at
# module-import time, so core/resources/ stays an acyclic leaf in the module
# graph. The runtime dependency direction is a deliberate, ADR-sanctioned
# consequence of co-locating the single resource boundary in core. Each edge is
# pinned individually (no wildcard) so a NEW non-deferred core->outer import is
# still caught. Test files importing domain errors are permitted per convention.
unmatched_ignore_imports_alerting = error
type = forbidden
source_modules =
    cadrumo.core
forbidden_modules =
    cadrumo.domain
    cadrumo.application
    cadrumo.adapters
    cadrumo.entrypoints
    cadrumo.llm
ignore_imports =
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Core test/conftest modules pull domain/application/adapters/entrypoints
    # fixtures for integration and cross-layer seam tests (real dependencies,
    # not mocks); a new such test needs no new exemption line here. Production
    # core -> outer-layer coupling stays individually pinned below (the
    # core/resources/_repos deferred-loader block) so a NEW non-deferred
    # production edge is still caught loudly. See
    # `2026-07-08-importlinter-test-carveout-adr`.
    cadrumo.core.tests.** -> cadrumo.domain.**
    cadrumo.core.**.tests.** -> cadrumo.domain.**
    cadrumo.core.tests.** -> cadrumo.application.**
    cadrumo.core.**.tests.** -> cadrumo.application.**
    cadrumo.core.tests.** -> cadrumo.adapters.**
    cadrumo.core.tests.** -> cadrumo.llm.**
    # The shared fixture package reaches storage itself, so a core test that
    # imports a helper from it inherits the edge. Both the bare package and its
    # submodules are listed: `cadrumo.tests.**` does not match `cadrumo.tests`.
    cadrumo.core.tests.** -> cadrumo.tests
    cadrumo.core.tests.** -> cadrumo.tests.**
    cadrumo.core.**.tests.** -> cadrumo.tests
    cadrumo.core.**.tests.** -> cadrumo.tests.**
    # ── core/resources/_repos deferred loader imports (ADR-sanctioned, see above) ──
    cadrumo.core.resources._repos.apoderamientos -> cadrumo.domain.auth.apoderamientos.catalogue
    cadrumo.core.resources._repos.category_profiles -> cadrumo.domain.categories.registry
    cadrumo.core.resources._repos.holiday_calendars -> cadrumo.domain.deadlines.festivos
    cadrumo.core.resources._repos.manuals -> cadrumo.domain.manuals.loader
    cadrumo.core.resources._repos.manuals -> cadrumo.domain.manuals.schema
    cadrumo.core.resources._repos.iva_catalogues -> cadrumo.domain.iva.catalogue
    cadrumo.core.resources._repos.iva_catalogues -> cadrumo.domain.iva.errors
    cadrumo.core.resources._repos.recargo_bands -> cadrumo.domain.deadlines.recargo
[importlinter:contract:llm-not-persistence]
name = Local-inference subpackage must not reach persistence
type = forbidden
source_modules =
    cadrumo.llm
forbidden_modules =
    cadrumo.adapters.persistence
# The outward half of the inference boundary. The subpackage receives
# already-resolved bytes in memory and returns a typed payload; it holds no
# repository handle and constructs no AttachmentStore. That is not a style
# preference -- it is the property the encryption exemption rests on. The
# operator ruling exempts IN-MEMORY processing from encryption precisely
# because the code persists nothing, and the only thing establishing that it
# persists nothing is enforcement like this. A persistence import here would
# make the exemption self-referential.
#
# The inward half (who may import THIS package) is the forbidden-module
# enrolment in the core and domain contracts above. Both are needed and
# neither substitutes for the other.
ignore_imports =
    # ── Test-module carve-out, matching every other contract in this file ──
    # The subpackage's fixture discovery reaches the canonical secure-runtime
    # test support. Pinned per chain origin rather than by a wildcard so a NEW
    # production edge still fails.
    cadrumo.llm.conftest -> cadrumo.tests.llm_secure_runtime
    # The stamp-singularity gate scans the whole non-test package, so it needs
    # the shared file-walk helpers; that package reaches storage for its own
    # roundtrip fixtures. A test-file chain origin, pinned like its siblings.
    cadrumo.llm.tests.test_provenance_stamp_singularity -> cadrumo.tests
    cadrumo.llm.tests.test_redaction -> cadrumo.tests.secure_sql
    # The consent-ledger gate drives the REAL consent ledger and the real
    # active-bucket repository, because the property under test is that a
    # refusal survives a genuine session suspension -- a stubbed store would
    # assert the test's own bookkeeping rather than the boundary's. Direct
    # rather than via cadrumo.tests: it names the ledger namespace and the
    # session verb, not the shared file-walk helpers.
    cadrumo.llm.tests.test_evidence_consent_gate -> cadrumo.adapters.persistence.storage.**
    # Same shape as test_provenance_stamp_singularity above: a package-wide
    # scan needing the shared file-walk helpers, whose package reaches storage
    # for its own roundtrip fixtures. Pinned at the chain origin.
    cadrumo.llm.tests.test_evidence_marker_declared_at_every_builder -> cadrumo.tests
    # ── The subpackage's own tests, into the LLM adapter facade ────────────
    # These tests construct the REAL cache, usage recorder and telemetry
    # recorder, because the properties under test -- no cloud fallback on
    # degradation, on-host admission, transport retry -- are properties of the
    # boundary and a stubbed recorder would assert the test's own bookkeeping.
    # The facade reaches storage for its own record persistence, so every such
    # test raises a three-hop chain into cadrumo.adapters.persistence.
    #
    # Wildcarded on the IMPORTER TIER, not pinned per file. The per-file model
    # this replaces was the exact scaling failure the test-carve-out ADR
    # rejected: seven files were pinned individually and the gate broke again
    # the moment three more landed, none of which introduced any new coupling.
    # The pin-per-file comment claimed the pins were what kept a new PRODUCTION
    # edge failing; that was never true. The wildcard's importer side is
    # anchored at cadrumo.llm.tests, so no production module can match it --
    # a cadrumo.llm.client edge into this facade still breaks the contract
    # exactly as before. Two lines because grimp's ** matches one-or-more
    # segments: the facade itself, and its private submodules.
    cadrumo.llm.tests.** -> cadrumo.adapters.outbound.llm.**
    cadrumo.llm.tests.** -> cadrumo.adapters.outbound.llm.**
    # ── The subpackage's own tests, into the ledger application services ───
    # These gates drive the REAL application entry points the readers hang off:
    # the vision and text classifier wiring through ledger.llm_classification,
    # the stamp-singularity scan through ledger.evidence_textlayer, and the
    # role-evidence prompt-shape gate through ledger.party_attribution. Each of
    # those services reaches storage for its own records, so every such test
    # raises a chain into cadrumo.adapters.persistence.
    #
    # Same importer-tier wildcard as the facade pair above and for the same
    # reason: anchored at cadrumo.llm.tests, so no production module can match
    # it, and llm.suggestions' edge into ledger.models still breaks the
    # contract exactly as before. Pinning these four per file would repeat the
    # scaling failure recorded above.
    cadrumo.llm.tests.** -> cadrumo.application.ledger.**
    # ── One PRODUCTION edge, sanctioned and worth stating precisely ────────
    # LLMClient default-constructs the three core-side stores, which do resolve
    # secure storage. So the subpackage reaches persistence TRANSITIVELY even
    # though it imports nothing from it directly and constructs no
    # AttachmentStore of its own -- the letter of the persistence decision
    # holds, the spirit is stretched by the defaulting.
    #
    # This is pinned rather than silently permitted because it is the one place
    # the boundary is softer than the governing record implies. The clean close
    # is to make the three stores caller-injected instead of defaulted, which
    # removes the edge entirely; the client already accepts them as optional
    # constructor parameters, so the change is mechanical but touches every
    # construction site and is deliberately not bundled into a relocation.
    cadrumo.llm.client -> cadrumo.adapters.outbound.llm.**

[importlinter:contract:tui-backend-prohibition]
name = Backend and sibling entrypoints must not depend on the dedicated TUI
# The dedicated TUI is an outermost process entrypoint, not a reusable frontend
# adapter.  `cadrumo.*` covers every backend/test-support top-level package;
# `cadrumo.entrypoints.*` closes the otherwise-overlapping entrypoints package so
# CLI, MCP, schema and entrypoint tests cannot reach the TUI either.  The TUI
# expression itself overlaps and is skipped by Import Linter, which is the
# intended self-reference exception.  Dynamic, type-only and non-Python bypasses
# are the separate AST gate owned by W01.P01.S03.
type = forbidden
source_modules =
    cadrumo.*
    cadrumo.entrypoints.*
forbidden_modules =
    cadrumo.entrypoints.tui

[importlinter:contract:tui-sibling-entrypoint-prohibition]
name = The TUI must not depend on a sibling entrypoint
# The existing backend prohibition covers the OPPOSITE direction -- nothing may
# depend on the TUI -- and says nothing about the TUI reaching sideways.  Two
# entrypoints are peers: neither is a library for the other, and a TUI that
# imports the CLI would take that package's initialiser, and with it Typer, into
# a process that has no command line.  The PRODUCTION reach is zero, which is why
# this contract stays a hard prohibition over production modules rather than a
# baseline; it exists so the zero is guarded rather than merely true.
#
# One test edge is allowed, and only one.  The installed-entrypoint proof asserts
# that the command the CLI builds to start a session is the module-execution
# surface -- that is, it exists to prove this very boundary is kept, and it reads
# the session bridge's two constants to do it.  It imports no TUI-facing CLI
# behaviour and constructs no Typer application, so it cannot drag a command line
# into a process that has none, which is the harm the prohibition names.  This
# mirrors the launcher-only wiring contract below, which already separates
# production wiring from test construction on the same reasoning.
#
# The OPPOSITE direction is not softened anywhere: the backend prohibition above
# keeps no allowance, and the CLI's in-process reach into the TUI stays reported.
type = forbidden
source_modules =
    cadrumo.entrypoints.tui
    cadrumo.entrypoints.tui.*
forbidden_modules =
    cadrumo.entrypoints.cli
[importlinter:contract:tui-launcher-only-adapter-wiring]
name = Only the TUI launcher may wire concrete adapters
# Match future TUI children without requiring the package to exist before its
# migration wave.  Only direct imports matter here: feature modules consume
# injected dependencies and public application facades, whose implementations
# may themselves reach adapters.  The launcher is the sole concrete composition
# root.  No unmatched exception warning is emitted before that root is created.
type = forbidden
source_modules =
    cadrumo.entrypoints.tui.*
forbidden_modules =
    cadrumo.adapters
allow_indirect_imports = true
unmatched_ignore_imports_alerting = none
ignore_imports =
    cadrumo.entrypoints.tui.launcher -> cadrumo.adapters
    cadrumo.entrypoints.tui.launcher -> cadrumo.adapters.**
    cadrumo.entrypoints.tui.launcher.** -> cadrumo.adapters
    cadrumo.entrypoints.tui.launcher.** -> cadrumo.adapters.**
    # TUI test modules build the REAL repositories they exercise, because this
    # project refuses mocked substitutes for the behaviour under test.  That is
    # the same fixture pattern already pinned for `domain.**.tests.**` above,
    # and it is not composition: no production TUI module outside the launcher
    # imports adapters, which is the property this contract exists to hold.
    cadrumo.entrypoints.tui.tests.** -> cadrumo.adapters
    cadrumo.entrypoints.tui.tests.** -> cadrumo.adapters.**
    cadrumo.entrypoints.tui.**.tests.** -> cadrumo.adapters
    cadrumo.entrypoints.tui.**.tests.** -> cadrumo.adapters.**

[importlinter:contract:tui-components-independent]
name = TUI component implementations depend only on Textual and neutral core presentation
# Component implementation modules are reusable presentation mechanics.  Their
# package facade may re-export those implementations; facade/re-export and
# Textual-location checks belong to W01.P01.S03.  Import Linter owns the runtime
# dependency graph below and rejects feature, composition and backend reaches.
type = forbidden
source_modules =
    cadrumo.entrypoints.tui.components.**
forbidden_modules =
    cadrumo.entrypoints.tui.*
    cadrumo.application
    cadrumo.domain
    cadrumo.adapters
    cadrumo.llm
    cadrumo.entrypoints.cli

[importlinter:contract:tui-feature-independence]
name = TUI feature implementations share components rather than each other
# Feature implementations may meet only in app.py.
#
# Named as packages, NOT as `.**` expressions. A `**` expression expands to every
# descendant, so a package with a test subpackage yields both `<pkg>.tests` and
# `<pkg>.tests.test_x` -- an ancestor and its own descendant inside ONE listed
# expression. Import Linter rejects that with "Modules have shared descendants."
# and aborts the WHOLE suite before evaluating any contract, so every other
# contract in this file silently stopped enforcing. The package form covers
# descendants already, which is what this contract wants.
#
# The wildcards were written while these feature packages did not yet exist.
# They exist now, so the pre-migration form is retired.
#
# `operations` is NOT among them, because it is not a feature. It is the shared
# surface for running any registered operation -- controller, modal, projection,
# logs -- parameterised by definition id and owning no domain of its own. Both
# `modelo` and `profile` consume it, which is what "share components rather than
# each other" describes. It cannot live under `components` either: that contract
# holds components to Textual and neutral core presentation, and this surface
# depends on `application.operations` by design. Listing it here made every
# feature that runs an operation a contract violation for doing the sanctioned
# thing.
type = independence
modules =
    cadrumo.entrypoints.tui.profile
    cadrumo.entrypoints.tui.secret

[importlinter:contract:layered]
name = AEAT layered architecture
# ── S23: Full layered architecture contract ───────────────────────────────────
# The broad layered contract enforces hexagonal direction across all layers.
# Layer order (outer → inner): entrypoints > adapters > application > domain > core
#
# Per the restructure ADR (2026-04-30 sec. 538), application/ is permitted to
# import from adapters/ directly (outbound adapter wiring). The exception
# ledger now pins each existing application source module individually;
# full inversion remains deferred, but new source modules fail loudly.
#
# Test files across all layers are permitted to cross layer boundaries for
# fixture setup; these are covered by individual entries below.
#
# Domain repositories that directly import the SQL persistence substrate are
# grandfathered in via individual narrow entries.
unmatched_ignore_imports_alerting = error
type = layers
layers =
    cadrumo.entrypoints
    cadrumo.adapters : cadrumo.llm
    cadrumo.application
    cadrumo.domain
    cadrumo.core
exhaustive = false
ignore_imports =
    # ── application -> adapters/llm: a policy rule, not a census ─────────
    # These three lines replace 226 individually pinned edges. Those edges
    # were never decisions: the layered restructure already PERMITS
    # application to reach outbound wiring, so the ledger only re-enumerated
    # instances of a rule already granted -- 108 of 653 application modules,
    # growing about two commits a day toward full enumeration.
    #
    # Enumerating them was actively harmful. `lint-imports` aborts on the
    # FIRST ignore_imports pin that matches nothing, before evaluating any
    # contract, and a pin stops matching exactly when somebody FIXES the
    # violation it excused. Improving the tree killed the whole gate: that
    # happened twice here and it stayed dead for days each time. Every pin
    # was a tripwire, so the census made the gate less trustworthy the
    # longer it grew.
    #
    # inbound is deliberately NOT in this rule and stays individually pinned
    # below: reading an externally-authored format is a real architectural
    # decision each time. The application-not-inbound-adapters contract keeps
    # that direction loud.
    cadrumo.application.** -> cadrumo.adapters.persistence.**
    cadrumo.application.** -> cadrumo.adapters.outbound.**
    cadrumo.application.** -> cadrumo.llm.**
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Test/conftest modules across every layer legitimately cross layer
    # boundaries for fixture setup, oracle replay, and real-adapter
    # roundtrip/anti-tautology suites (real dependencies, not mocks); a new
    # such test needs no new exemption line here. Production cross-layer
    # coupling remains individually pinned below (the application -> adapters
    # ADR sec. 538 allowance, the per-repository ports-inversion edges, and
    # the core/resources/_repos deferred loaders) so a NEW non-deferred
    # production edge still fails loudly. The prorrata-owned production edges
    # (application._revision_persistence, application.calculations.
    # _prorrata_regularizacion, application.aggregation.iva_ledger ->
    # adapters.persistence.profile.prorrata_register / adapters.persistence.
    # storage) were inverted behind ProrrataRegisterRepositoryProtocol and now
    # ride the sanctioned construction-edge pins below (see the prorrata-register
    # ports-inversion block), superseding the deferral recorded in
    # `2026-07-08-importlinter-test-carveout-adr`.
    cadrumo.domain.tests.** -> cadrumo.adapters.**
    cadrumo.domain.**.tests.** -> cadrumo.adapters.**
    cadrumo.domain.**.tests.** -> cadrumo.application.**
    cadrumo.application.tests.** -> cadrumo.adapters.**
    cadrumo.application.**.tests.** -> cadrumo.adapters.**
    cadrumo.application.**.tests.** -> cadrumo.entrypoints.**
    cadrumo.core.tests.** -> cadrumo.domain.**
    cadrumo.core.**.tests.** -> cadrumo.domain.**
    cadrumo.core.tests.** -> cadrumo.application.**
    cadrumo.core.**.tests.** -> cadrumo.application.**
    cadrumo.core.tests.** -> cadrumo.adapters.**
    # cadrumo.llm is a declared sibling layer of adapters, and the family above
    # enumerates one pattern per layer PAIR -- so a new pair needs a line even
    # though the prose says a new test does not. The same pattern is already
    # sanctioned in the local-inference contract above.
    cadrumo.core.tests.** -> cadrumo.llm.**
    # conftest.py modules sitting directly in a layer subpackage (not nested
    # under a tests/ folder) are the same roundtrip-discipline fixture pattern.
    cadrumo.application.**.conftest -> cadrumo.adapters.**
    cadrumo.domain.**.conftest -> cadrumo.application.**
    # The layer-root conftest reaches the shared fixture package the same way
    # the nested ones reach adapters; `**.conftest` does not match a conftest
    # sitting directly at the layer root.
    cadrumo.application.conftest -> cadrumo.tests.**
    # test modules that route through the shared cadrumo.tests.* fixture helpers
    # (cadrumo.tests is a cross-cutting test-support package, not a declared
    # layer) which themselves transitively reach a forbidden outer layer.
    # Each layer is listed twice: `cadrumo.tests.**` matches a submodule import,
    # but the package's own __init__ re-exports the fixture helpers, so a test
    # importing from `cadrumo.tests` directly creates an edge to the BARE
    # package -- which `.**` does not match. Both forms are needed per layer.
    cadrumo.domain.**.tests.** -> cadrumo.tests.**
    cadrumo.domain.**.tests.** -> cadrumo.tests
    cadrumo.domain.tests.** -> cadrumo.tests.**
    cadrumo.application.tests.** -> cadrumo.tests.**
    cadrumo.application.tests.** -> cadrumo.tests
    cadrumo.application.**.tests.** -> cadrumo.tests.**
    cadrumo.application.**.tests.** -> cadrumo.tests
    cadrumo.core.tests.** -> cadrumo.tests.**
    cadrumo.core.tests.** -> cadrumo.tests
    cadrumo.core.**.tests.** -> cadrumo.tests.**
    cadrumo.core.**.tests.** -> cadrumo.tests

    # The tabular fallback lane reaches the gated subpackage for the one
    # judgement it cannot make deterministically: what a file's own header
    # vocabulary means. Deferred inside the resolver, and pinned here because
    # cadrumo.llm is a SIBLING of cadrumo.adapters on the adapter tier rather
    # than an inner one, so this is a peer edge and not an inward reach. Values
    # never cross it -- only headers out, roles back.
    cadrumo.adapters.inbound.financial.providers._mapped_tabular -> cadrumo.llm.column_role_mapping
    # ── aeat-roundtrip-discipline carve-out, cadrumo.llm half (test-file-only) ──
    # cadrumo.llm is enrolled as a PEER of cadrumo.adapters on the adapter tier
    # (`cadrumo.adapters : cadrumo.llm` above), so an application test reaching
    # it is categorically the same edge as the application test reaching
    # adapters that the wildcard two lines up already covers. It was left as a
    # per-test-file list only because the carve-out sweep split on the target
    # package name rather than on the tier, and that list then reproduced
    # exactly the scaling failure `2026-07-08-importlinter-test-carveout-adr`
    # rejected: eleven near-duplicate lines, and two new seam tests
    # (test_invoice_extraction_authority, test_absent_identity_is_not_a_failed_role)
    # broke the contract purely by existing. These are SEAM tests -- they assert
    # the ledger router consumes llm-owned surfaces correctly, so they belong to
    # neither side and cannot be relocated into either without looking like a
    # unit test of something that package does not own. The mirror image is
    # already enrolled by wildcard-equivalent per-origin pins above
    # (llm.tests.test_llm_vision_classifier -> application.ledger._llm_classification),
    # and sanctioning one direction of a seam while refusing the other would be
    # arbitrary. Every one reaches the PUBLIC facade, so what is exempted is
    # only the layer direction, not a private reach. Production
    # application -> llm coupling stays individually pinned above and a NEW
    # production edge still fails loudly.
    cadrumo.application.**.tests.** -> cadrumo.llm.**
    # The read-time shape probe. DocumentShape is derived from a document's
    # own bytes by an INBOUND adapter, because reading an externally-authored
    # format is inbound-adapter work; the ledger consumes the answer.
    cadrumo.application.ledger.evidence_input -> cadrumo.adapters.inbound.einvoice.shape
    # The batch runner asks that same probe ONE question -- is this document
    # structured, and therefore readable without loading a model -- and consumes
    # the answer. Same shape and same justification as the pin above; it is the
    # probe's own caller, not a second reader. Its import is function-local, and
    # the contract sees it anyway (grimp walks function bodies), so the pin
    # records a reviewed decision rather than suppressing something that would
    # otherwise have gone unnoticed.
    cadrumo.application.ledger.batch_ingest -> cadrumo.adapters.inbound.einvoice.shape
    # Bank-statement rows arrive as the provider's own ParsedLedgerRow records,
    # and this module classifies and imports them. Reading an externally-authored
    # statement format is inbound-adapter work; the ledger consumes the answer --
    # the same shape as the einvoice pins above. The type-only import is excluded
    # from the graph; the runtime edge is two function-local imports that grimp
    # sees and this pin therefore reviews.
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.base
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.csv
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.detection
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.ofx
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.pdf_n26
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.xlsx
    # A fourth einvoice consumer, previously hidden inside a broad wildcard while
    # its three siblings were individually reviewed. A structured e-invoice is
    # read exactly by parse_einvoice_document and its parse failure is caught
    # here; same justification as _evidence_input and _batch_ingest, now stated
    # rather than assumed.
    # Splitting evidence_draft turned that one consumer into three, each holding
    # the part of the read it owns: the extraction lane calls the parser and
    # catches its XML failure, and the two record-shaping modules consume the
    # invoice class the parser returns. Same justification, three spellings.
    cadrumo.application.ledger.confirmed_field_resolution -> cadrumo.adapters.inbound.einvoice.parsers
    cadrumo.application.ledger.invoice_draft_extraction -> cadrumo.adapters.inbound.einvoice.parsers
    cadrumo.application.ledger.invoice_draft_extraction -> cadrumo.adapters.inbound.einvoice.xml
    cadrumo.application.ledger.invoice_draft_records -> cadrumo.adapters.inbound.einvoice.parsers
    # Reaches NO persistence at all: its former `adapters.**` pin was wholly an
    # inbound-adapter allowance wearing a storage-shaped label. Lifting a PDF's
    # text layer out of bytes is inbound-adapter work; this module decides what
    # the extracted text means as evidence.
    cadrumo.application.ledger.evidence_textlayer -> cadrumo.adapters.inbound.pdf.page_text_extraction
    # ── live-snapshot family: concrete relocated, construction edge retained ──
    # SecureSnapshotRepository -- the encrypted secure-object backend these
    # services persist through -- now lives in the persistence adapter, as
    # adapters.persistence.profile.snapshots. The application layer keeps only
    # the SnapshotRepository PORT and the lifecycle service bases, which is why
    # _snapshot_base carries no pin at all any more.
    #
    # Each service below still holds a persistence pin, and that is the
    # finished state, not leftover work: it imports its own
    # LIVE_*_SNAPSHOT_NAMESPACE constant from the central 72-entry namespace
    # registry and resolves its per-bucket store, both independently of the
    # repository class. This is exactly the prorrata-register end state
    # recorded below -- concrete behind the port in the adapter, sanctioned
    # sec. 538 default-construction edge retained at the caller.
    #
    # The sede pins are a different axis: they carry AEAT boundary DTOs
    # (Deuda, Declaracion, NotificationsSnapshot) as payload shapes, shared
    # with live modules that are not snapshot services at all.
    cadrumo.application.live.filed_observation_persistence -> cadrumo.adapters.inbound.justificante.parser
    cadrumo.application.live.justificante -> cadrumo.adapters.inbound.justificante.parser
    # Reaches NO persistence: the second pin in this sweep whose storage-shaped
    # The workflow run-contract surface reports whether a browser session can be
    # established, so it names the outbound browser adapter alongside its
    # persistence reach.
    # The shared secure-SQL test helper wraps the real persistence adapter for
    # roundtrip-discipline tests; ignoring its adapter edge breaks the layer
    # path for every application/domain test that routes fixtures through it.
    cadrumo.tests.secure_sql -> cadrumo.adapters.**
    # The test-only ephemeral master-key provider composes the public storage
    # and master-key facades. Classify this exact shared-helper edge so tests
    # can exercise real session lifecycle without weakening production layers.
    cadrumo.tests.master_key -> cadrumo.adapters.**
    # The shared justificante parse-cache test helper imports the inbound
    # justificante adapter for roundtrip-discipline fixtures; same rationale.
    # ── core/resources/_repos deferred loader imports ──
    # Function-local imports inside Repository._load / _resolve_authority
    # methods. The resource-management-api ADR (2026-05-16) places the
    # concrete Repository implementations in core/resources/ and chose lazy
    # loading (ADR Q5); the imports run only at first resource access, never
    # at module-import time, so core/resources/ stays an acyclic leaf. Each
    # edge is pinned individually so a new non-deferred core->outer import is
    # still caught. See the core-not-outer contract comment above for detail.
    cadrumo.core.resources._repos.apoderamientos -> cadrumo.domain.auth.apoderamientos.catalogue
    cadrumo.core.resources._repos.category_profiles -> cadrumo.domain.categories.registry
    cadrumo.core.resources._repos.holiday_calendars -> cadrumo.domain.deadlines.festivos
    cadrumo.core.resources._repos.manuals -> cadrumo.domain.manuals.loader
    cadrumo.core.resources._repos.manuals -> cadrumo.domain.manuals.schema
    cadrumo.core.resources._repos.iva_catalogues -> cadrumo.domain.iva.catalogue
    cadrumo.core.resources._repos.iva_catalogues -> cadrumo.domain.iva.errors
    cadrumo.core.resources._repos.recargo_bands -> cadrumo.domain.deadlines.recargo

[importlinter:contract:application-not-inbound-adapters]
# The one application -> adapters direction that stays a decision.
#
# Persistence and outbound wiring are permitted wholesale by the layered
# contract above, because the restructure already granted them. Reading an
# externally-authored format is different: an inbound parser reach means the
# application layer has taken on interpreting somebody else's file shape, and
# that is worth defending each time rather than absorbing into a wildcard.
#
# A blanket `application -> adapters.**` would have swallowed this class
# silently, which is exactly why the wildcards above name persistence and
# outbound explicitly instead.
name = Application must not reach inbound adapters unless pinned
type = forbidden
source_modules =
    cadrumo.application
forbidden_modules =
    cadrumo.adapters.inbound
# Direct reaches only. An application module importing an OUTBOUND adapter
# that itself imports an inbound parser is the outbound adapter's business,
# not a decision the application layer took; adapter-to-adapter imports sit
# inside one layer and the layered contract governs them.
allow_indirect_imports = true
unmatched_ignore_imports_alerting = error
ignore_imports =
    # Test/conftest modules cross layers for fixture setup and real-adapter
    # roundtrip suites, exactly as the layered contract already allows. A new
    # such test needs no line here; only PRODUCTION reaches are pinned below.
    cadrumo.application.tests.** -> cadrumo.adapters.inbound.**
    cadrumo.application.**.tests.** -> cadrumo.adapters.inbound.**
    # Production reaches, each a decision to defend:
    cadrumo.application.ledger.evidence_input -> cadrumo.adapters.inbound.einvoice.shape
    cadrumo.application.ledger.batch_ingest -> cadrumo.adapters.inbound.einvoice.shape
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.base
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.csv
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.detection
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.ofx
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.pdf_n26
    cadrumo.application.ledger.actions_import -> cadrumo.adapters.inbound.financial.providers.xlsx
    cadrumo.application.ledger.confirmed_field_resolution -> cadrumo.adapters.inbound.einvoice.parsers
    cadrumo.application.ledger.invoice_draft_extraction -> cadrumo.adapters.inbound.einvoice.parsers
    cadrumo.application.ledger.invoice_draft_extraction -> cadrumo.adapters.inbound.einvoice.xml
    cadrumo.application.ledger.invoice_draft_records -> cadrumo.adapters.inbound.einvoice.parsers
    cadrumo.application.ledger.evidence_textlayer -> cadrumo.adapters.inbound.pdf.page_text_extraction
    cadrumo.application.live.filed_observation_persistence -> cadrumo.adapters.inbound.justificante.parser
    cadrumo.application.live.justificante -> cadrumo.adapters.inbound.justificante.parser
