[importlinter]
root_package = aeat
include_external_packages = False

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). Wave 2 P04 resolved it via Protocol-
# based dependency inversion; the production import is gone. The test edge
# below remains a legitimate cross-domain reference for integration tests.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Test modules that construct domain objects for registry integration tests
# are permitted to import domain.renta directly - they are not production code.
ignore_imports =
    aeat.domain.calculations.registry.test_ledger_renta_expense_binding -> aeat.domain.renta

# ── Deferred contracts (Wave 3 prerequisites) ────────────────────────────────
# Three additional hexagonal-direction contracts were drafted during
# Wave 2 P06.S19 but cannot be activated yet because the existing codebase
# violates them in production code that requires structural refactor:
#
# 1. domain-not-application (5 production violations: deadlines/_profiles
#    and profile/_keys importing application.wizard internals).
# 2. core-not-outer (multiple production violations: core.errors importing
#    adapters.outbound.aeat.browser._site_health; core.i18n._render reaching
#    into application.user_profile and application.workflow through the
#    locale rendering pipeline).
# 3. layered (the broad layered contract; surfaces ~30 production violations
#    plus dozens of live-test patterns).
#
# Each of these contracts is structurally desirable but activating them
# requires refactoring the offending production paths. The work belongs in
# Wave 3 alongside the typed-envelope promotion (defect class T-01) and
# the registry referential-integrity gate (T-09). The current contract above
# closes the F7 defect Wave 2 was scoped to address.
