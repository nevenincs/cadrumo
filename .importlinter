[importlinter]
root_package = aeat
include_external_packages = False

# ── Layered architecture (hexagonal direction) ───────────────────────────────
# The hexagonal layering rule: domain depends only on core. Application
# depends on domain + core. Adapters depend on domain + application + core
# (typically via Protocol-typed interfaces). Entrypoints sit on top.
# Reverse-direction imports break hexagonal encapsulation and are forbidden.

[importlinter:contract:layered]
name = AEAT layered architecture
type = layers
layers =
    aeat.entrypoints
    aeat.adapters
    aeat.application
    aeat.domain
    aeat.core
exhaustive = false

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). Promoting the dependency through
# application/aggregation is the correct fix; the contract below blocks
# direct cross-package imports until that promotion lands.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Remove once Wave 2 P04 lands. The exception keeps the contract honest
# while the migration is in flight; flip to no exceptions once
# RentaDeductibleExpenseObservation moves to application/aggregation.
ignore_imports =
    aeat.domain.calculations.registry._bindings -> aeat.domain.renta

# ── Profile-level convergence (CCAA) ─────────────────────────────────────────
# After Wave 2 P02 (CCAA canonicalisation) lands, this contract pins the
# single canonical CCAA shape inside domain.profile and prevents
# reintroduction of competing enums elsewhere in domain.
# Stubbed for now; activate once the migration completes.
#
# [importlinter:contract:ccaa-canonical]
# name = Single canonical CCAA enum lives in domain.profile
# type = forbidden
# source_modules =
#     aeat.domain.renta
# forbidden_modules =
#     aeat.domain.profile._ccaa
# Until the migration, renta retains its own enum; flip after P02.S07.
