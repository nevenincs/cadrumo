[importlinter]
root_package = aeat
include_external_packages = False
# Exclude TYPE_CHECKING-guarded imports from the import graph so that
# type-annotation-only imports do not trigger layer-direction contracts.
# Runtime behaviour is unaffected; only import-time side effects are analysed.
exclude_type_checking_imports = True

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). It is resolved via Protocol-based
# dependency inversion: the registry validator declares the abstract
# CrossDomainSnapshotCheck Protocol and a register_cross_domain_snapshot_check()
# injection point; the concrete renta first-slice routing check lives in
# aeat.domain.renta._first_slice_routing_integrity and registers itself at
# renta package import time. The registry never names renta. The test edge
# below remains a legitimate cross-domain reference for integration tests.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Test modules that construct domain objects for registry integration tests
# are permitted to import domain.renta directly - they are not production code.
# The test_referential_integrity edge below is the chain origin of an
# indirect path (test -> application.diagnostics -> ... -> sede._declarations
# -> renta): sede._declarations imports the renta package for its
# cross-domain snapshot-check registration side effect, which is a legitimate
# adapter -> domain edge. Pinning the test-module chain origin keeps the
# contract enforcing genuine production calculations -> renta imports while
# excusing the test path. The same edge is already sanctioned in the
# domain-not-application contract.
ignore_imports =
    # ── W09: re-sanctioned test-file roundtrip/fixture/oracle edges (prior ignores went stale on test rename) ──
    aeat.domain.calculations.registry.tests.test_ledger_renta_expense_binding -> aeat.domain.renta
    # W09.S90: parity-scenario test consumers trigger the renta first-slice
    # registration directly (relocated out of the production _scenarios harness)

[importlinter:contract:domain-not-application]
name = Domain must not import application
# ── S21: Domain must not import application ───────────────────────────────────
# Production domain modules must not import from the application layer.
# The five violations (deadlines/_profiles, profile/_keys) were resolved in
# Wave 3 P04 S16 and S17: _profiles.py now parses canonical tokens directly;
# _keys.py now uses a register_profile_keys() injection point.
# Test files that import application modules for fixture setup are permitted.
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain
forbidden_modules =
    aeat.application
# Production domain -> application coupling is zero. The former
# domain.contribuyente._keys -> application.wizard._compiler lazy edge was
# eliminated by the DB-17 eager-registration bootstrap (importing
# aeat.application.wizard pushes PROFILE_KEYS at import time), and the topic
# catalogue loader now reads core.topics (a core -> core edge), so neither
# crosses this boundary any longer. Only sanctioned test/fixture edges remain,
# pinned individually below so a new non-deferred production edge is still caught.
ignore_imports =
    # ── W09: sanctioned cross-layer test/fixture/oracle edges (roundtrip discipline) ──
    aeat.domain.deadlines.conftest -> aeat.application.wizard._catalogue
    # ── conftest profile-key eager registration (wizard import side-effect; test scaffolding) ──
    aeat.domain.calculations.registry.tests.conftest -> aeat.application.wizard
    aeat.domain.contribuyente.conftest -> aeat.application.wizard
    # ── DB-16: per-domain repositories wrap the secure-storage substrate ──
    # Sanctioned by the secure-persistence-foundation ADR series
    # (2026-04-30-secure-persistence-foundation-adr, Wave-3/4 per-domain
    # repository pattern; e.g. domain.justificante._repository is Phase 4).
    # SecureBoundRepository is SQL/crypto-coupled so its base cannot move to
    # core; the repositories are deliberately co-located with their domain.
    aeat.domain.calculations.registry.tests.test_cross_boundary_roundtrip -> aeat.application.workflow
    aeat.domain.calculations.registry.tests.test_detail_record_modelo_coverage -> aeat.application.storage.calc_sheets
    aeat.domain.invoices.tests.test_reconciliation -> aeat.application.invoices
    aeat.domain.modelos.tests.test_work_unit -> aeat.application.modelo
    # ── registry/modelo test files pulling application fixtures (test-topology refactor) ──
    # W10: import-centralization refactor moved these test files onto the
    # top-level application.modelo / application.aggregation re-exports
    # (service-imports-via-top-level-reexports), so the prior private-submodule
    # ignores (._semantic_role_resolution, ._renta_income_ledger) went stale.
    aeat.domain.calculations.registry.tests.test_modelo_100_registry_roles_capital_gains -> aeat.application.modelo
    aeat.domain.calculations.registry.tests.test_modelo_100_registry_roles_prevision_social -> aeat.application.modelo
    aeat.domain.calculations.registry.tests._ledger_iva_aggregation_support -> aeat.application.calculations
    aeat.domain.calculations.registry.tests.test_binding_coverage_breadth -> aeat.application.aggregation
    aeat.domain.calculations.registry.tests.test_binding_coverage_breadth -> aeat.application.modelo._calculation_actions
    aeat.domain.calculations.registry.tests.test_ledger_renta_income_binding -> aeat.application.aggregation
    # W04.P08.S47: source-connectivity gate joins the domain registry inventory
    # against the live-mesh disposition taxonomy (application.aggregation public set).
    aeat.domain.calculations.registry.tests.test_source_enrollment -> aeat.application.aggregation
    aeat.domain.calculations.registry.tests.test_referential_integrity_part4 -> aeat.application.diagnostics
    aeat.domain.modelos.tests.test_work_unit -> aeat.application.user_profile

[importlinter:contract:domain-not-adapters]
name = Domain must not import adapters
# ── arch-remediation-ports-inversion (W04.P10.S20): declare the seam exhaustively ──
# The ports-inversion campaign migrated every production domain repository
# behind a Protocol port with its concrete under adapters.persistence.profile,
# so PRODUCTION domain -> adapters coupling is zero. This first-class forbidden
# contract (sibling of domain-not-application) replaces the per-production-edge
# exception list the layered contract carried: a new non-deferred production
# domain -> adapters import now fails loudly here rather than being absorbed as
# a layered-contract ignore. Only sanctioned test-file roundtrip/anti-tautology
# edges — which legitimately construct the concrete adapter to exercise the
# encrypted boundary end-to-end — remain, pinned individually below.
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: production direct coupling here is zero; transitive
# chains through test files are sanctioned roundtrip noise and the layered
# contract enforces the full ordering comprehensively.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain
forbidden_modules =
    aeat.adapters
ignore_imports =
    # ── sanctioned domain test-file edges: roundtrip / anti-tautology suites
    #    constructing the concrete persistence adapter (roundtrip-discipline rule) ──
    aeat.domain.attachments.tests.test_attachment_store_no_uri_list -> aeat.adapters.persistence.storage.attachment
    aeat.domain.attachments.tests.test_repository -> aeat.adapters.persistence.storage.attachment
    aeat.domain.attachments.tests.test_service -> aeat.adapters.persistence.storage.attachment
    aeat.domain.calculations.registry.tests.test_renta_web_open_oracle -> aeat.adapters.outbound.aeat.sede
    aeat.domain.currency.tests.test_service -> aeat.adapters.outbound.fx
    aeat.domain.filing.tests.test_amendment_roundtrip -> aeat.adapters.persistence.profile.filing_amendments
    aeat.domain.filing.tests.test_amendment_roundtrip -> aeat.adapters.persistence.storage
    aeat.domain.filing.tests.test_amendment_roundtrip -> aeat.adapters.persistence.storage.crypto
    aeat.domain.filing.tests.test_amendment_roundtrip -> aeat.adapters.persistence.storage.sql
    aeat.domain.filing.tests.test_amendment_roundtrip -> aeat.adapters.persistence.storage.sql.session
    aeat.domain.filing.tests.test_binding_value_provenance_roundtrip -> aeat.adapters.persistence.profile.filing_drafts
    aeat.domain.filing.tests.test_binding_value_provenance_roundtrip -> aeat.adapters.persistence.storage.crypto
    aeat.domain.filing.tests.test_binding_value_provenance_roundtrip -> aeat.adapters.persistence.storage.sql
    aeat.domain.filing.tests.test_binding_value_provenance_roundtrip -> aeat.adapters.persistence.storage.sql.session
    aeat.domain.filing.tests.test_roundtrip_anti_tautology -> aeat.adapters.persistence.profile.filing_drafts
    aeat.domain.filing.tests.test_roundtrip_anti_tautology -> aeat.adapters.persistence.storage.crypto
    aeat.domain.filing.tests.test_roundtrip_anti_tautology -> aeat.adapters.persistence.storage.sql
    aeat.domain.filing.tests.test_roundtrip_anti_tautology -> aeat.adapters.persistence.storage.sql.session
    aeat.domain.filing.tests.test_secure_storage_roundtrip -> aeat.adapters.persistence.profile.filing_drafts
    aeat.domain.filing.tests.test_secure_storage_roundtrip -> aeat.adapters.persistence.profile.modelos_calculation
    aeat.domain.fincas.tests.test_aggregates -> aeat.adapters.persistence.profile.fincas
    aeat.domain.fincas.tests.test_aggregates -> aeat.adapters.persistence.storage
    aeat.domain.fincas.tests.test_aggregates -> aeat.adapters.persistence.storage.sql.engine
    aeat.domain.invoices.tests.test_reconciliation -> aeat.adapters.persistence.profile.invoices
    aeat.domain.invoices.tests.test_reconciliation -> aeat.adapters.persistence.profile.transactions
    aeat.domain.modelos.tests.test_filing_record_repository_roundtrip -> aeat.adapters.persistence.profile.modelos_filing
    aeat.domain.modelos.tests.test_filing_record_repository_roundtrip -> aeat.adapters.persistence.storage
    aeat.domain.modelos.tests.test_participation_index_roundtrip -> aeat.adapters.persistence.profile.participation_index
    aeat.domain.modelos.tests.test_participation_index_roundtrip -> aeat.adapters.persistence.storage
    aeat.domain.modelos.tests.test_secure_storage_roundtrip -> aeat.adapters.persistence.profile.modelos_work_units
    aeat.domain.modelos.tests.test_secure_storage_roundtrip -> aeat.adapters.persistence.storage
