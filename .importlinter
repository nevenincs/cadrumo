[importlinter]
root_package = aeat
include_external_packages = False
# Exclude TYPE_CHECKING-guarded imports from the import graph so that
# type-annotation-only imports do not trigger layer-direction contracts.
# Runtime behaviour is unaffected; only import-time side effects are analysed.
exclude_type_checking_imports = True

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). It is resolved via Protocol-based
# dependency inversion: the registry validator declares the abstract
# CrossDomainSnapshotCheck Protocol and a register_cross_domain_snapshot_check()
# injection point; the concrete renta first-slice routing check lives in
# aeat.domain.renta._first_slice_routing_integrity and registers itself at
# renta package import time. The registry never names renta. The test edge
# below remains a legitimate cross-domain reference for integration tests.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
unmatched_ignore_imports_alerting = warn
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Test modules that construct domain objects for registry integration tests
# are permitted to import domain.renta directly - they are not production code.
# The test_referential_integrity edge below is the chain origin of an
# indirect path (test -> application.diagnostics -> ... -> sede._declarations
# -> renta): sede._declarations imports the renta package for its
# cross-domain snapshot-check registration side effect, which is a legitimate
# adapter -> domain edge. Pinning the test-module chain origin keeps the
# contract enforcing genuine production calculations -> renta imports while
# excusing the test path. The same edge is already sanctioned in the
# domain-not-application contract.
ignore_imports =
    # ── W09: re-sanctioned test-file roundtrip/fixture/oracle edges (prior ignores went stale on test rename) ──
    aeat.domain.calculations.registry.tests.test_minimo_contribuyente_age_increment -> aeat.domain.renta
    aeat.domain.calculations.registry.tests.test_modelo_100_registry -> aeat.domain.renta
    aeat.domain.calculations.registry.tests.test_ledger_renta_expense_binding -> aeat.domain.renta
    # W09.S90: parity-scenario test consumers trigger the renta first-slice
    # registration directly (relocated out of the production _scenarios harness)
    aeat.domain.calculations.registry.tests.test_registry_scenarios -> aeat.domain.renta
    aeat.domain.calculations.registry.tests.test_reduccion_art_84_conjunta -> aeat.domain.renta
    aeat.domain.calculations.registry.tests.test_renta_chain_behaviour -> aeat.domain.renta

# ── S21: Domain must not import application ───────────────────────────────────
# Production domain modules must not import from the application layer.
# The five violations (deadlines/_profiles, profile/_keys) were resolved in
# Wave 3 P04 S16 and S17: _profiles.py now parses canonical tokens directly;
# _keys.py now uses a register_profile_keys() injection point.
# Test files that import application modules for fixture setup are permitted.

    # ── Autogenerated additions for test-topology refactoring ──
    aeat.domain.calculations.registry.tests.test_referential_integrity_part1 -> aeat.application.diagnostics
    # ── Autogenerated additions for test-topology refactoring ──
    aeat.domain.calculations.registry.tests.test_referential_integrity_part1 -> aeat.application.diagnostics
[importlinter:contract:domain-not-application]
name = Domain must not import application
unmatched_ignore_imports_alerting = warn
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain
forbidden_modules =
    aeat.application
# Production domain -> application coupling is zero. The former
# domain.contribuyente._keys -> application.wizard._compiler lazy edge was
# eliminated by the DB-17 eager-registration bootstrap (importing
# aeat.application.wizard pushes PROFILE_KEYS at import time), and the topic
# catalogue loader now reads core.topics (a core -> core edge), so neither
# crosses this boundary any longer. Only sanctioned test/fixture edges remain,
# pinned individually below so a new non-deferred production edge is still caught.
ignore_imports =
    # ── W09: sanctioned cross-layer test/fixture/oracle edges (roundtrip discipline) ──
    aeat.domain.deadlines.conftest -> aeat.application.wizard._catalogue
    aeat.domain.deadlines.conftest -> aeat.application.wizard._persistence
    # ── conftest profile-key eager registration (wizard import side-effect; test scaffolding) ──
    aeat.domain.calculations.registry.tests.conftest -> aeat.application.wizard
    aeat.domain.contribuyente.conftest -> aeat.application.wizard
    # ── DB-16: per-domain repositories wrap the secure-storage substrate ──
    # Sanctioned by the secure-persistence-foundation ADR series
    # (2026-04-30-secure-persistence-foundation-adr, Wave-3/4 per-domain
    # repository pattern; e.g. domain.justificante._repository is Phase 4).
    # SecureBoundRepository is SQL/crypto-coupled so its base cannot move to
    # core; the repositories are deliberately co-located with their domain.
    aeat.domain.buckets._event_repository -> aeat.adapters.persistence.storage.runtime_repository
    aeat.domain.filing._runtime_repository -> aeat.adapters.persistence.storage.runtime_repository
    aeat.domain.modelos._runtime_repository -> aeat.adapters.persistence.storage.runtime_repository
    aeat.domain.transactions._repository -> aeat.adapters.persistence.storage
    aeat.domain.usage_ratios._service -> aeat.adapters.persistence.storage.runtime_repository
    aeat.domain.calculations.registry.tests.test_cross_boundary_roundtrip -> aeat.application.workflow._models
    aeat.domain.calculations.registry.tests.test_detail_record_modelo_coverage -> aeat.application.storage.calc_sheets
    aeat.domain.invoices.tests.test_reconciliation -> aeat.application.invoices
    aeat.domain.modelos.tests.test_work_unit -> aeat.application.modelo

# ── S22: Core must not import outer layers ────────────────────────────────────
# Core is the innermost layer and must not import from domain, application,
# adapters, or entrypoints. The production violations were resolved in
# Wave 3 P04:
# - core/errors/__init__.py: SiteHealthStatus TYPE_CHECKING import replaced
#   with SiteHealthStatusProtocol declared in core.
# - core/errors/_registry.py: entrypoints.cli._i18n import replaced with
#   core.i18n.
# - core/i18n/_render.py: application imports replaced with a registered
#   callback (register_profile_language_resolver).
# Core test files that pull application / domain fixtures for integration tests
# are permitted per project convention.
#
# core.resources._repos deferred loader imports (resource-management-api ADR,
# 2026-05-16): the resource-management-api ADR explicitly places the concrete
# Repository implementations under core/resources/ ("Repository implementations
# reference [domain models] but the Repository class hierarchy itself is
# core-layer infrastructure") AND chose lazy loading as the default (ADR Q5:
# "each Repository's get(key) loads on demand"; "the eager imports disappear").
# Each loader below is a *function-local* import inside a Repository._load /
# _resolve_authority method -- it runs only at first resource access, never at
# module-import time, so core/resources/ stays an acyclic leaf in the module
# graph. The runtime dependency direction is a deliberate, ADR-sanctioned
# consequence of co-locating the single resource boundary in core. Each edge is
# pinned individually (no wildcard) so a NEW non-deferred core->outer import is
# still caught. Test files importing domain errors are permitted per convention.

    # ── Autogenerated additions for test-topology refactoring ──
    aeat.domain.calculations.registry.tests.test_referential_integrity_part1 -> aeat.application.diagnostics
    # ── Autogenerated additions for test-topology refactoring ──
    aeat.domain.calculations.registry.tests.test_referential_integrity_part1 -> aeat.application.diagnostics
[importlinter:contract:core-not-outer]
name = Core must not import outer layers
unmatched_ignore_imports_alerting = warn
type = forbidden
source_modules =
    aeat.core
forbidden_modules =
    aeat.domain
    aeat.application
    aeat.adapters
    aeat.entrypoints
ignore_imports =
    # ── W09: re-sanctioned test-file roundtrip/fixture/oracle edges (prior ignores went stale on test rename) ──
    aeat.core.resources._repos.tests.test_manuals -> aeat.domain.manuals._errors
    aeat.core.resources._repos.tests.test_normatives -> aeat.domain.normatives._errors
    aeat.core.resources._repos.tests.test_singletons -> aeat.domain.calculations.registry._schema
    aeat.core.tests.test_external_constants_centralisation_part1 -> aeat.adapters.persistence.storage.blob_store._blob_store
    aeat.core.tests.test_external_constants_centralisation_part1 -> aeat.application.aggregation._currency_predicates
    aeat.core.tests.test_external_constants_centralisation_part1 -> aeat.application.ledger._models
    aeat.core.tests.test_external_constants_centralisation_part1 -> aeat.domain.currency._service
    aeat.core.tests.test_external_constants_centralisation_part2 -> aeat.domain.iva
    aeat.core.tests.test_modelo -> aeat.application.modelo
    aeat.core.tests.test_modelo -> aeat.domain.calculations.registry
    aeat.core.tests.test_modelo -> aeat.domain.modelos
    aeat.core.tests.test_logging -> aeat.adapters.inbound.pdf._pdfplumber
    aeat.core.tests.test_setup_answers -> aeat.application.wizard._catalogue
    aeat.core.tests.test_setup_answers -> aeat.domain.deadlines._models
    aeat.core.tests.test_setup_answers -> aeat.domain.deadlines._profiles
    aeat.core.tests.test_wizard_catalogue -> aeat.application.wizard._catalogue
    # ── core test files importing application/domain/adapters for fixtures ──
    aeat.core.tests.test_external_constants -> aeat.domain.portals._categories
    aeat.core.resources._repos.tests.test_singletons -> aeat.domain.auth.apoderamientos._catalogue
    aeat.core.resources._repos.tests.test_singletons -> aeat.domain.user_profile._schema
    # ── core/resources/_repos deferred loader imports (ADR-sanctioned, see above) ──
    aeat.core.resources._repos.apoderamientos -> aeat.domain.auth.apoderamientos
    aeat.core.resources._repos.category_profiles -> aeat.domain.categories
    aeat.core.resources._repos.holiday_calendars -> aeat.domain.deadlines
    aeat.core.resources._repos.iva_catalogues -> aeat.domain.iva._catalogue
    aeat.core.resources._repos.iva_rate_tables -> aeat.domain.iva._rates
    aeat.core.resources._repos.legal_parameters -> aeat.domain.calculations.registry
    aeat.core.resources._repos.manuals -> aeat.domain.manuals
    aeat.core.resources._repos.modelos -> aeat.domain.calculations.registry
    aeat.core.resources._repos.normatives -> aeat.domain.normatives
    aeat.core.resources._repos.recargo_bands -> aeat.domain.deadlines
    aeat.core.resources._repos.user_profile -> aeat.domain.user_profile

# ── S23: Full layered architecture contract ───────────────────────────────────
# The broad layered contract enforces hexagonal direction across all layers.
# Layer order (outer → inner): entrypoints > adapters > application > domain > core
#
# Per the restructure ADR (2026-04-30 sec. 538), application/ is permitted to
# import from adapters/ directly (outbound adapter wiring). The wildcard entry
# blanket-permits all application→adapters edges; full inversion deferred.
#
# Test files across all layers are permitted to cross layer boundaries for
# fixture setup; these are covered by individual entries below.
#
# Domain repositories that directly import the SQL persistence substrate are
# grandfathered in via individual narrow entries.

    # ── Autogenerated additions for test-topology refactoring ──
    aeat.core.tests.test_external_constants -> aeat.domain.portals._codes
    aeat.core.tests.test_external_constants -> aeat.domain.portals._entries._common
    aeat.core.tests.test_external_constants -> aeat.domain.portals._hosts
    # ── Autogenerated additions for test-topology refactoring ──
    aeat.core.tests.test_external_constants -> aeat.domain.portals._codes
    aeat.core.tests.test_external_constants -> aeat.domain.portals._entries._common
    aeat.core.tests.test_external_constants -> aeat.domain.portals._hosts
[importlinter:contract:layered]
name = AEAT layered architecture
unmatched_ignore_imports_alerting = warn
type = layers
layers =
    aeat.entrypoints
    aeat.adapters
    aeat.application
    aeat.domain
    aeat.core
exhaustive = false
ignore_imports =
