[importlinter]
root_package = aeat
include_external_packages = False
# Exclude TYPE_CHECKING-guarded imports from the import graph so that
# type-annotation-only imports do not trigger layer-direction contracts.
# Runtime behaviour is unaffected; only import-time side effects are analysed.
exclude_type_checking_imports = True

# ── Cross-package domain isolation ───────────────────────────────────────────
# Domain peer-packages must not import each other's private internals.
# The calculations registry was found importing from domain.renta during
# the linkage-design audit (defect F7). It is resolved via Protocol-based
# dependency inversion: the registry validator declares the abstract
# CrossDomainSnapshotCheck Protocol and a register_cross_domain_snapshot_check()
# injection point; the concrete renta first-slice routing check lives in
# aeat.domain.renta._first_slice_routing_integrity and registers itself at
# renta package import time. The registry never names renta. The test edge
# below remains a legitimate cross-domain reference for integration tests.

[importlinter:contract:no-renta-in-registry]
name = Calculations registry must not import directly from domain.renta
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain.calculations
forbidden_modules =
    aeat.domain.renta
# Test modules that construct domain objects for registry integration tests
# are permitted to import domain.renta directly - they are not production code.
# The test_referential_integrity edge below is the chain origin of an
# indirect path (test -> application.diagnostics -> ... -> sede._declarations
# -> renta): sede._declarations imports the renta package for its
# cross-domain snapshot-check registration side effect, which is a legitimate
# adapter -> domain edge. Pinning the test-module chain origin keeps the
# contract enforcing genuine production calculations -> renta imports while
# excusing the test path. The same edge is already sanctioned in the
# domain-not-application contract.
ignore_imports =
    # ── W09: re-sanctioned test-file roundtrip/fixture/oracle edges (prior ignores went stale on test rename) ──
    aeat.domain.calculations.registry.tests.test_ledger_renta_expense_binding -> aeat.domain.renta
    # W09.S90: parity-scenario test consumers trigger the renta first-slice
    # registration directly (relocated out of the production _scenarios harness)

[importlinter:contract:domain-not-application]
name = Domain must not import application
# ── S21: Domain must not import application ───────────────────────────────────
# Production domain modules must not import from the application layer.
# The five violations (deadlines/_profiles, profile/_keys) were resolved in
# Wave 3 P04 S16 and S17: _profiles.py now parses canonical tokens directly;
# _keys.py now uses a register_profile_keys() injection point.
# Test files that import application modules for fixture setup are permitted.
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: the F7/S21 defects this guards were direct
# couplings; transitive chains through test files (test -> application -> ...)
# are sanctioned roundtrip noise, and the layered contract enforces the full
# ordering comprehensively. Production direct coupling here is zero.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain
forbidden_modules =
    aeat.application
# Production domain -> application coupling is zero. The former
# domain.contribuyente._keys -> application.wizard._compiler lazy edge was
# eliminated by the DB-17 eager-registration bootstrap (importing
# aeat.application.wizard pushes PROFILE_KEYS at import time), and the topic
# catalogue loader now reads core.topics (a core -> core edge), so neither
# crosses this boundary any longer. Only sanctioned test/fixture edges remain,
# pinned individually below so a new non-deferred production edge is still caught.
ignore_imports =
    # ── W09: sanctioned cross-layer test/fixture/oracle edges (roundtrip discipline) ──
    aeat.domain.deadlines.conftest -> aeat.application.wizard._catalogue
    # ── conftest profile-key eager registration (wizard import side-effect; test scaffolding) ──
    aeat.domain.calculations.registry.tests.conftest -> aeat.application.wizard
    aeat.domain.contribuyente.conftest -> aeat.application.wizard
    # ── DB-16: per-domain repositories wrap the secure-storage substrate ──
    # Sanctioned by the secure-persistence-foundation ADR series
    # (2026-04-30-secure-persistence-foundation-adr, Wave-3/4 per-domain
    # repository pattern; e.g. domain.justificante._repository is Phase 4).
    # SecureBoundRepository is SQL/crypto-coupled so its base cannot move to
    # core; the repositories are deliberately co-located with their domain.
    aeat.domain.calculations.registry.tests.test_cross_boundary_roundtrip -> aeat.application.workflow
    aeat.domain.calculations.registry.tests.test_detail_record_modelo_coverage -> aeat.application.storage.calc_sheets
    aeat.domain.invoices.tests.test_reconciliation -> aeat.application.invoices
    aeat.domain.modelos.tests.test_work_unit -> aeat.application.modelo
    # ── registry/modelo test files pulling application fixtures (test-topology refactor) ──
    # W10: import-centralization refactor moved these test files onto the
    # top-level application.modelo / application.aggregation re-exports
    # (service-imports-via-top-level-reexports), so the prior private-submodule
    # ignores (._semantic_role_resolution, ._renta_income_ledger) went stale.
    aeat.domain.calculations.registry.tests.test_modelo_100_registry_roles_capital_gains -> aeat.application.modelo
    aeat.domain.calculations.registry.tests.test_modelo_100_registry_roles_prevision_social -> aeat.application.modelo
    aeat.domain.calculations.registry.tests._ledger_iva_aggregation_support -> aeat.application.calculations
    aeat.domain.calculations.registry.tests.test_binding_coverage_breadth -> aeat.application.aggregation
    aeat.domain.calculations.registry.tests.test_binding_coverage_breadth -> aeat.application.modelo._calculation_actions
    aeat.domain.calculations.registry.tests.test_ledger_renta_income_binding -> aeat.application.aggregation
    # W04.P08.S47: source-connectivity gate joins the domain registry inventory
    # against the live-mesh disposition taxonomy (application.aggregation public set).
    aeat.domain.calculations.registry.tests.test_source_enrollment -> aeat.application.aggregation
    aeat.domain.calculations.registry.tests.test_referential_integrity_part4 -> aeat.application.diagnostics
    aeat.domain.modelos.tests.test_work_unit -> aeat.application.user_profile

[importlinter:contract:domain-not-adapters]
name = Domain must not import adapters
# ── arch-remediation-ports-inversion (W04.P10.S20): declare the seam exhaustively ──
# The ports-inversion campaign migrated every production domain repository
# behind a Protocol port with its concrete under adapters.persistence.profile,
# so PRODUCTION domain -> adapters coupling is zero. This first-class forbidden
# contract (sibling of domain-not-application) replaces the per-production-edge
# exception list the layered contract carried: a new non-deferred production
# domain -> adapters import now fails loudly here rather than being absorbed as
# a layered-contract ignore. Only sanctioned test-file roundtrip/anti-tautology
# edges — which legitimately construct the concrete adapter to exercise the
# encrypted boundary end-to-end — remain, pinned individually below.
unmatched_ignore_imports_alerting = error
# Scoped to DIRECT imports: production direct coupling here is zero; transitive
# chains through test files are sanctioned roundtrip noise and the layered
# contract enforces the full ordering comprehensively.
allow_indirect_imports = true
type = forbidden
source_modules =
    aeat.domain
forbidden_modules =
    aeat.adapters
ignore_imports =
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Test/conftest modules across the domain layer legitimately construct the
    # concrete persistence adapter to exercise the encrypted storage boundary
    # end-to-end (real adapters, not mocks -- aeat-roundtrip-discipline). Every
    # prior per-file exemption here was a test path; production domain ->
    # adapters coupling is zero (this contract enforces it: the
    # arch-remediation-ports-inversion campaign moved every production domain
    # repository behind a Protocol port). Two wildcards cover a domain test
    # module at any nesting depth (bare `domain.tests.*` and
    # `domain.<pkg...>.tests.*`); a new roundtrip test needs no new exemption
    # line here. See `2026-07-08-importlinter-test-carveout-adr`.
    aeat.domain.tests.** -> aeat.adapters.**
    aeat.domain.**.tests.** -> aeat.adapters.**
[importlinter:contract:core-not-outer]
name = Core must not import outer layers
# ── S22: Core must not import outer layers ────────────────────────────────────
# Core is the innermost layer and must not import from domain, application,
# adapters, or entrypoints. The production violations were resolved in
# Wave 3 P04:
# - core/errors/__init__.py: SiteHealthStatus TYPE_CHECKING import replaced
#   with SiteHealthStatusProtocol declared in core.
# - core/errors/_registry.py: entrypoints.cli._i18n import replaced with
#   core.i18n.
# - core/i18n/_render.py: application imports replaced with a registered
#   callback (register_profile_language_resolver).
# Core test files that pull application / domain fixtures for integration tests
# are permitted per project convention.
#
# core.resources._repos deferred loader imports (resource-management-api ADR,
# 2026-05-16): the resource-management-api ADR explicitly places the concrete
# Repository implementations under core/resources/ ("Repository implementations
# reference [domain models] but the Repository class hierarchy itself is
# core-layer infrastructure") AND chose lazy loading as the default (ADR Q5:
# "each Repository's get(key) loads on demand"; "the eager imports disappear").
# Each loader below is a *function-local* import inside a Repository._load /
# _resolve_authority method -- it runs only at first resource access, never at
# module-import time, so core/resources/ stays an acyclic leaf in the module
# graph. The runtime dependency direction is a deliberate, ADR-sanctioned
# consequence of co-locating the single resource boundary in core. Each edge is
# pinned individually (no wildcard) so a NEW non-deferred core->outer import is
# still caught. Test files importing domain errors are permitted per convention.
unmatched_ignore_imports_alerting = error
type = forbidden
source_modules =
    aeat.core
forbidden_modules =
    aeat.domain
    aeat.application
    aeat.adapters
    aeat.entrypoints
ignore_imports =
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Core test/conftest modules pull domain/application/adapters/entrypoints
    # fixtures for integration and cross-layer seam tests (real dependencies,
    # not mocks); a new such test needs no new exemption line here. Production
    # core -> outer-layer coupling stays individually pinned below (the
    # core/resources/_repos deferred-loader block) so a NEW non-deferred
    # production edge is still caught loudly. See
    # `2026-07-08-importlinter-test-carveout-adr`.
    aeat.core.tests.** -> aeat.domain.**
    aeat.core.**.tests.** -> aeat.domain.**
    aeat.core.tests.** -> aeat.application.**
    aeat.core.**.tests.** -> aeat.application.**
    aeat.core.tests.** -> aeat.adapters.**
    aeat.core.tests.** -> aeat.entrypoints.**
    # ── core/resources/_repos deferred loader imports (ADR-sanctioned, see above) ──
    aeat.core.resources._repos.apoderamientos -> aeat.domain.auth.apoderamientos
    aeat.core.resources._repos.category_profiles -> aeat.domain.categories
    aeat.core.resources._repos.holiday_calendars -> aeat.domain.deadlines
    aeat.core.resources._repos.legal_parameters -> aeat.domain.calculations.registry
    aeat.core.resources._repos.manuals -> aeat.domain.manuals
    aeat.core.resources._repos.modelos -> aeat.domain.calculations.registry
    aeat.core.resources._repos.iva_catalogues -> aeat.domain.iva
    aeat.core.resources._repos.iva_rate_tables -> aeat.domain.iva
    aeat.core.resources._repos.recargo_bands -> aeat.domain.deadlines
    aeat.core.resources._repos.user_profile -> aeat.domain.user_profile
[importlinter:contract:layered]
name = AEAT layered architecture
# ── S23: Full layered architecture contract ───────────────────────────────────
# The broad layered contract enforces hexagonal direction across all layers.
# Layer order (outer → inner): entrypoints > adapters > application > domain > core
#
# Per the restructure ADR (2026-04-30 sec. 538), application/ is permitted to
# import from adapters/ directly (outbound adapter wiring). The exception
# ledger now pins each existing application source module individually;
# full inversion remains deferred, but new source modules fail loudly.
#
# Test files across all layers are permitted to cross layer boundaries for
# fixture setup; these are covered by individual entries below.
#
# Domain repositories that directly import the SQL persistence substrate are
# grandfathered in via individual narrow entries.
unmatched_ignore_imports_alerting = error
type = layers
layers =
    aeat.entrypoints
    aeat.adapters
    aeat.application
    aeat.domain
    aeat.core
exhaustive = false
ignore_imports =
    # ── aeat-roundtrip-discipline carve-out (test-file-only) ──────────────
    # Test/conftest modules across every layer legitimately cross layer
    # boundaries for fixture setup, oracle replay, and real-adapter
    # roundtrip/anti-tautology suites (real dependencies, not mocks); a new
    # such test needs no new exemption line here. Production cross-layer
    # coupling remains individually pinned below (the application -> adapters
    # ADR sec. 538 allowance, the per-repository ports-inversion edges, and
    # the core/resources/_repos deferred loaders) so a NEW non-deferred
    # production edge still fails loudly. The prorrata-owned production edges
    # (application._revision_persistence, application.calculations.
    # _prorrata_regularizacion, application.aggregation._iva_ledger ->
    # adapters.persistence.profile.prorrata_register / adapters.persistence.
    # storage) were inverted behind ProrrataRegisterRepositoryProtocol and now
    # ride the sanctioned construction-edge pins below (see the prorrata-register
    # ports-inversion block), superseding the deferral recorded in
    # `2026-07-08-importlinter-test-carveout-adr`.
    aeat.domain.tests.** -> aeat.adapters.**
    aeat.domain.**.tests.** -> aeat.adapters.**
    aeat.domain.**.tests.** -> aeat.application.**
    aeat.application.tests.** -> aeat.adapters.**
    aeat.application.**.tests.** -> aeat.adapters.**
    aeat.application.**.tests.** -> aeat.entrypoints.**
    aeat.core.tests.** -> aeat.domain.**
    aeat.core.**.tests.** -> aeat.domain.**
    aeat.core.tests.** -> aeat.application.**
    aeat.core.**.tests.** -> aeat.application.**
    aeat.core.tests.** -> aeat.adapters.**
    aeat.core.tests.** -> aeat.entrypoints.**
    # conftest.py modules sitting directly in a layer subpackage (not nested
    # under a tests/ folder) are the same roundtrip-discipline fixture pattern.
    aeat.application.**.conftest -> aeat.adapters.**
    aeat.domain.**.conftest -> aeat.application.**
    # test modules that route through the shared aeat.tests.* fixture helpers
    # (aeat.tests is a cross-cutting test-support package, not a declared
    # layer) which themselves transitively reach a forbidden outer layer.
    aeat.domain.**.tests.** -> aeat.tests.cli_runner
    aeat.application.tests.** -> aeat.tests.cli_runner
    aeat.application.**.tests.** -> aeat.tests.cli_runner
    aeat.domain.**.tests.** -> aeat.locales
    # ── D9 follow-up: local-import lifts made these concrete storage edges
    #    import-linter-visible; pin exact targets, not broad source modules. ──
    aeat.application.modelo._m145_communication_records -> aeat.adapters.persistence.storage
    aeat.application.modelo._review_package_recipient_encryption -> aeat.adapters.persistence.storage
    aeat.application.modelo._review_package_recipient_encryption -> aeat.adapters.persistence.storage.crypto
    aeat.application.modelo._review_package_recipient_registry -> aeat.adapters.persistence.storage
    aeat.application.modelo._review_package_recipient_replay_guard -> aeat.adapters.persistence.storage
    aeat.application.modelo._review_package_signing -> aeat.adapters.persistence.storage

    # ── application → adapters (permitted by architecture ADR sec. 538) ──
    # application/ may import adapters/ for outbound wiring; full inversion
    # would require a major refactor and is deferred.
    aeat.application.aggregation._modelo_bindings -> aeat.adapters.**
    aeat.application.aggregation._oss_ioss -> aeat.adapters.**
    aeat.application.aggregation._percepciones_observations_repository -> aeat.adapters.persistence.storage
    aeat.application.aggregation._retencion_observations_repository -> aeat.adapters.persistence.storage
    aeat.application.aggregation._withholding_source -> aeat.adapters.persistence.storage
    aeat.application.auth -> aeat.adapters.outbound.aeat.auth
    aeat.application.auth._apoderado -> aeat.adapters.persistence.storage
    aeat.application.auth._certificate_secret_backend -> aeat.adapters.**
    aeat.application.auth._certificate_sources_operator -> aeat.adapters.**
    aeat.application.auth._diagnostics -> aeat.adapters.**
    aeat.application.auth._operator -> aeat.adapters.**
    aeat.application.auth._operator_probes -> aeat.adapters.**
    aeat.application.auth._operator_scope -> aeat.adapters.**
    aeat.application.auth._sessions -> aeat.adapters.**
    aeat.application.bienes_inversion -> aeat.adapters.**
    aeat.application.bucket_maintenance._manifest_digest -> aeat.adapters.**
    aeat.application.bucket_maintenance._sandbox -> aeat.adapters.**
    aeat.application.bucket_maintenance._service -> aeat.adapters.**
    aeat.application.calculations._iva_compensation_annual_partition -> aeat.adapters.**
    aeat.application.calculations._iva_compensation_history -> aeat.adapters.**
    aeat.application.calculations._multi_year -> aeat.adapters.**
    aeat.application.calculations._observations_repository -> aeat.adapters.**
    aeat.application.calculations._relation_prefill -> aeat.adapters.**
    aeat.application.diagnostics -> aeat.adapters.**
    aeat.application.diagnostics_run_health -> aeat.adapters.**
    aeat.application.evidence._service -> aeat.adapters.**
    aeat.application.filing._history_repository -> aeat.adapters.**
    aeat.application.filing._import -> aeat.adapters.**
    aeat.application.filing._runtime_repository -> aeat.adapters.**
    aeat.application.inventory._service -> aeat.adapters.**
    aeat.application.invoices._source_resolver -> aeat.adapters.**
    aeat.application.ledger._actions_common -> aeat.adapters.**
    aeat.application.ledger._actions_import -> aeat.adapters.**
    aeat.application.ledger._business_operation_invoice -> aeat.adapters.**
    aeat.application.ledger._evidence -> aeat.adapters.**
    aeat.application.ledger._evidence_draft -> aeat.adapters.**
    aeat.application.ledger._evidence_draft_vision -> aeat.adapters.**
    aeat.application.ledger._evidence_textlayer -> aeat.adapters.**
    aeat.application.ledger._llm_classification -> aeat.adapters.**
    aeat.application.ledger._llm_diagnostics -> aeat.adapters.**
    # ── arch-remediation-ports-inversion: usage_ratios persistence relocated to
    #    adapters.persistence.profile.usage_ratios; the ledger callers now import
    #    the adapter directly (narrow target keeps the source-module set flat) ──
    aeat.application.ledger._preflight -> aeat.adapters.persistence.profile.usage_ratios
    aeat.application.ledger._ratios -> aeat.adapters.persistence.profile.usage_ratios
    # ── arch-remediation-ports-inversion: submission repository relocated to
    #    adapters.persistence.profile.submission; the workflow gate constructs the
    #    concrete and injects it into the SubmissionEngine, tests seed via it ──
    aeat.application.modelo._workflow_gate -> aeat.adapters.persistence.profile.submission
    # ── arch-remediation-ports-inversion: justificante repository relocated to
    #    adapters.persistence.profile.justificante (no domain port; no domain
    #    caller); application/entrypoint callers import the adapter directly ──
    aeat.application.calculations._cross_period_clean_state -> aeat.adapters.persistence.profile.justificante
    aeat.application.modelo._external_import_actions -> aeat.adapters.persistence.profile.justificante
    aeat.application.ledger._review_projection -> aeat.adapters.**
    aeat.application.ledger._rule_repository -> aeat.adapters.**
    aeat.application.ledger._vision_classifier -> aeat.adapters.**
    aeat.application.live -> aeat.adapters.**
    aeat.application.live._borrador_100 -> aeat.adapters.**
    aeat.application.live._censo -> aeat.adapters.**
    aeat.application.live._errors -> aeat.adapters.**
    aeat.application.live._expedientes -> aeat.adapters.**
    aeat.application.live._filed_data -> aeat.adapters.**
    aeat.application.live._filed_data_capture -> aeat.adapters.**
    aeat.application.live._filed_observation_persistence -> aeat.adapters.**
    aeat.application.live._iva_remote_state -> aeat.adapters.**
    aeat.application.live._justificante -> aeat.adapters.**
    aeat.application.live._notifications -> aeat.adapters.**
    aeat.application.live._session -> aeat.adapters.**
    aeat.application.live._snapshot_base -> aeat.adapters.**
    aeat.application.live._verify -> aeat.adapters.**
    aeat.application.modelo._borrador_binding -> aeat.adapters.**
    aeat.application.modelo._m036_lifecycle -> aeat.adapters.**
    aeat.application.modelo._reconcile -> aeat.adapters.**
    aeat.application.prorrata_register -> aeat.adapters.**
    aeat.application.registry -> aeat.adapters.**
    aeat.application.repair_integrity -> aeat.adapters.**
    aeat.application.state_projection -> aeat.adapters.**
    aeat.application.storage.calc_sheets._parity_harness -> aeat.adapters.**
    aeat.application.user_profile._aggregate -> aeat.adapters.**
    aeat.application.user_profile._bundle -> aeat.adapters.**
    aeat.application.user_profile._bundle_encryption -> aeat.adapters.**
    aeat.application.user_profile._capabilities -> aeat.adapters.**
    aeat.application.user_profile._censo_sync -> aeat.adapters.**
    aeat.application.user_profile._custody -> aeat.adapters.**
    aeat.application.user_profile._custody_carry -> aeat.adapters.**
    aeat.application.user_profile._language_resolver -> aeat.adapters.**
    aeat.application.user_profile._orchestration -> aeat.adapters.**
    aeat.application.user_profile._profile_repository -> aeat.adapters.**
    aeat.application.user_profile._repository -> aeat.adapters.**
    aeat.application.user_profile._testing -> aeat.adapters.**
    aeat.application.verification._verify -> aeat.adapters.**
    aeat.application.workflow._adapters -> aeat.adapters.**
    aeat.application.workflow._models -> aeat.adapters.**
    aeat.application.workflow._persistence -> aeat.adapters.**
    aeat.application.workflow._profile_bucket_scan -> aeat.adapters.**
    aeat.application.workflow._profile_health -> aeat.adapters.**
    # The shared secure-SQL test helper wraps the real persistence adapter for
    # roundtrip-discipline tests; ignoring its adapter edge breaks the layer
    # path for every application/domain test that routes fixtures through it.
    aeat.tests.secure_sql -> aeat.adapters.**
    # The manual-ledger action support centralises its concrete adapter
    # constructors here so split application tests keep one test-support edge.
    aeat.tests.ledger_action_adapters -> aeat.adapters.**
    # Review-package roundtrip tests centralise raw storage/sql probes here so
    # application tests do not each own direct adapter pins.
    aeat.tests.review_package_adapters -> aeat.adapters.**
    # The custody-store recovery matrix centralises its real concrete adapter
    # constructors here so the application test owns one test-support edge
    # instead of eleven direct adapter pins.
    aeat.tests.custody_store_matrix_adapters -> aeat.adapters.**
    # The shared justificante parse-cache test helper imports the inbound
    # justificante adapter for roundtrip-discipline fixtures; same rationale.
    aeat.tests._justificante_parse_cache -> aeat.adapters.**
    # ── core/resources/_repos deferred loader imports ──
    # Function-local imports inside Repository._load / _resolve_authority
    # methods. The resource-management-api ADR (2026-05-16) places the
    # concrete Repository implementations in core/resources/ and chose lazy
    # loading (ADR Q5); the imports run only at first resource access, never
    # at module-import time, so core/resources/ stays an acyclic leaf. Each
    # edge is pinned individually so a new non-deferred core->outer import is
    # still caught. See the core-not-outer contract comment above for detail.
    aeat.core.resources._repos.apoderamientos -> aeat.domain.auth.apoderamientos
    aeat.core.resources._repos.category_profiles -> aeat.domain.categories
    aeat.core.resources._repos.holiday_calendars -> aeat.domain.deadlines
    aeat.core.resources._repos.legal_parameters -> aeat.domain.calculations.registry
    aeat.core.resources._repos.manuals -> aeat.domain.manuals
    aeat.core.resources._repos.modelos -> aeat.domain.calculations.registry
    aeat.core.resources._repos.iva_catalogues -> aeat.domain.iva
    aeat.core.resources._repos.iva_rate_tables -> aeat.domain.iva
    aeat.core.resources._repos.recargo_bands -> aeat.domain.deadlines
    aeat.core.resources._repos.user_profile -> aeat.domain.user_profile
    # ── application production edges: participation-index derived-cache co-write
    #    (module-granularity replaces the pre-refactor deep-submodule edge) ──
    aeat.application.ledger._participation_read -> aeat.adapters.persistence.profile.participation_index
    aeat.application.modelo._revision_persistence -> aeat.adapters.persistence.profile.participation_index
    aeat.application.modelo._participation_index_rebuild -> aeat.adapters.persistence.profile.participation_index
    aeat.application.modelo._verification_actions -> aeat.adapters.persistence.profile.participation_index
    aeat.application.modelo._export -> aeat.adapters.persistence.profile.modelos_verification_reports
    aeat.application.modelo._filing_actions -> aeat.adapters.persistence.profile.modelos_verification_reports
    aeat.application.modelo._history -> aeat.adapters.persistence.profile.modelos_verification_reports
