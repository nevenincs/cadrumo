{
  "platform": "linux-aarch64",
  "backend": "linux",
  "linux_desktop_runtime": "gtk3-webkit41-v1",
  "stdlib_exclude": [
    "site-packages",
    "__pycache__",
    "test",
    "tests",
    "idlelib",
    "tkinter",
    "turtledemo",
    "ensurepip",
    "lib-dynload"
  ],
  "package_exclusions": [
    {
      "pattern": "PIL/ImageTk.py",
      "reason": "Optional Pillow Tk adapter; Tk is excluded from the CADRUMO runtime"
    },
    {
      "pattern": "PIL/_imagingtk.*.so",
      "reason": "Optional Pillow Tk extension; Tk is excluded from the CADRUMO runtime"
    }
  ],
  "paths": {
    "executable": "python",
    "packages": "lib/cadrumo/site-packages"
  },
  "entrypoint_suffix": "",
  "application_images": [
    {
      "name": "cadrumo",
      "placement": ".",
      "target": "desktop-host-build",
      "artifact": "CADRUMO_DESKTOP_HOST_EXECUTABLE",
      "desktop": true,
      "signed": true,
      "version_arguments": [
        "--headless",
        "--",
        "--version"
      ]
    },
    {
      "name": "cadrumo-manager",
      "placement": ".",
      "target": "rust_manager",
      "artifact": "CADRUMO_MANAGER_EXECUTABLE",
      "desktop": false,
      "signed": true,
      "version_arguments": [
        "--version"
      ]
    }
  ],
  "files": {
    "development_executable": "python_d",
    "path_file": "lib/cadrumo/python.pth",
    "bridge": "cadrumo_python.so",
    "runtime": "libpython3.13.so.1.0"
  },
  "sdk": {
    "root": "cpython-pbs",
    "archive_root": "python",
    "executable": "install/bin/python3.13",
    "include": "install/include/python3.13",
    "stdlib": "install/lib/python3.13",
    "extensions": "install/lib/python3.13/lib-dynload",
    "link_library": "install/lib/libpython3.13.so.1.0",
    "native_files": [
      "install/lib/libpython3.13.so.1.0"
    ],
    "license": "licenses/LICENSE.cpython.txt",
    "licenses": {
      "licenses": "docs/licenses/CPython-dependencies",
      "PYTHON.json": "docs/licenses/CPython-dependencies/PYTHON.json"
    },
    "metadata": "PYTHON.json",
    "extension_suffix": ".cpython-313-aarch64-linux-gnu.so",
    "extension_exclusions": [
      {
        "pattern": "_tkinter.*.so",
        "reason": "Tk is excluded from the CADRUMO runtime"
      },
      {
        "pattern": "_ctypes_test.*.so",
        "reason": "CPython extension test support is excluded from the CADRUMO runtime"
      },
      {
        "pattern": "_dbm.*.so",
        "reason": "Berkeley DB is excluded from the CADRUMO base runtime"
      }
    ]
  },
  "smoke_modules": {},
  "bootstrap": "interpreter/posix/bootstrap.py",
  "package_root_from_executable": ".",
  "native_system_libraries": [
    "libdl.so.2",
    "librt.so.1",
    "libm.so.6",
    "libpthread.so.0",
    "libutil.so.1",
    "libc.so.6",
    "libstdc++.so.6",
    "libgcc_s.so.1",
    "libz.so.1",
    "ld-linux-aarch64.so.1"
  ]
}
