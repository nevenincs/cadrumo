{
  "platform": "windows-x64",
  "backend": "windows",
  "package_exclusions": [
    {
      "pattern": "PIL/_imagingtk*.pyd",
      "reason": "Optional Pillow Tk adapter; Tk is excluded from the CADRUMO runtime"
    },
    {
      "pattern": "PIL/ImageTk.py",
      "reason": "Optional Pillow Tk adapter; Tk is excluded from the CADRUMO runtime"
    }
  ],
  "paths": {
    "executable": "python.exe"
  },
  "entrypoint_suffix": ".exe",
  "application_images": [
    {
      "name": "cadrumo",
      "placement": ".",
      "target": "desktop-host-build",
      "artifact": "CADRUMO_DESKTOP_HOST_EXECUTABLE",
      "desktop": true,
      "signed": true,
      "version_arguments": ["--headless", "--", "--version"]
    },
    {
      "name": "cadrumo-manager",
      "placement": ".",
      "target": "rust_manager",
      "artifact": "CADRUMO_MANAGER_EXECUTABLE",
      "desktop": false,
      "signed": true,
      "version_arguments": ["--version"]
    }
  ],
  "files": {
    "development_executable": "python_d.exe",
    "bridge": "cadrumo_python.dll",
    "runtime": "python313.dll"
  },
  "sdk": {
    "root": "cpython-nuget/tools",
    "executable": "python.exe",
    "stdlib": "Lib",
    "license": "LICENSE.txt"
  },
  "smoke_modules": {
    "pywin32": [
      "win32api",
      "pythoncom",
      "win32com.shell.shell"
    ]
  },
  "native_smoke_prerequisites": {
    "dde": ["win32ui"]
  },
  "bootstrap": "interpreter/windows/bootstrap.py",
  "smoke_test": "windows_smoke.py",
  "package_root_from_executable": "."
}
