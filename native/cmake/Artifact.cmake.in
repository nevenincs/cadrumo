# Bind the locator to the archive just created, not a later configure invocation.
list(LENGTH CPACK_PACKAGE_FILES archive_count)
if(NOT archive_count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one package archive")
endif()
list(GET CPACK_PACKAGE_FILES 0 archive)
file(SHA256 "${archive}" archive_hash)
set(manifest_path "@CADRUMO_PATH_STAGE@/${CPACK_BUILD_CONFIG}/app/@CADRUMO_PACKAGE_MANIFEST@")
file(READ "${manifest_path}" manifest)
file(SHA256 "${manifest_path}" manifest_hash)
string(JSON development_executable GET "${manifest}" layout files development_executable)
string(JSON development_hash ERROR_VARIABLE missing GET "${manifest}" files "${development_executable}")
if(missing)
  set(development false)
else()
  set(development true)
endif()
get_filename_component(archive_name "${archive}" NAME)
file(WRITE "@PROJECT_BINARY_DIR@/artifacts-${CPACK_BUILD_CONFIG}.json"
  "{\"archive\":\"${CPACK_PACKAGE_DIRECTORY}/${archive_name}\",\"archive_sha256\":\"${archive_hash}\",\"manifest_sha256\":\"${manifest_hash}\",\"configuration\":\"${CPACK_BUILD_CONFIG}\",\"development_binary\":${development}}\n")
