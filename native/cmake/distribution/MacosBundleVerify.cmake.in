# CPack pre- and post-build script: verify, never re-sign, the bundle sealed in staging.
if(DEFINED CPACK_PACKAGE_FILES)
  set(bundle_check verify-packages --spctl "@CADRUMO_SPCTL@" --hdiutil "@CADRUMO_HDIUTIL@"
    --ditto "@CADRUMO_DITTO@" ${CPACK_PACKAGE_FILES})
else()
  set(bundle_check verify-staging --root "${CPACK_TEMPORARY_INSTALL_DIRECTORY}")
endif()
execute_process(COMMAND "@CADRUMO_DEV_PYTHON@" -B -m dev.packaging.native.macos_bundle
  --identity "@CADRUMO_PATH_GENERATED@/identity.json" --codesign "@CADRUMO_CODESIGN@" ${bundle_check}
  WORKING_DIRECTORY "@CADRUMO_SOURCE_ROOT@" COMMAND_ERROR_IS_FATAL ANY)
