include_guard(GLOBAL)
# Build output contract shared by the source build, the desktop project and the
# distribution project.
#
# Configure ends with a summary at STATUS: the product, target and toolchain the
# binary directory selected, its options, and every build target with what it
# produces and where. --log-level=VERBOSE adds the output layout and the cleanup
# and test inventories; --log-context prefixes lines with the section that
# printed them. While building, every described step announces itself and its
# output through its COMMENT and reports completion once its commands succeed.
# The Python helpers a step runs log under the same [cadrumo:<step>] prefix at
# the level CADRUMO_BUILD_LOG_LEVEL selects (dev/packaging/native/build_log.py).

# A fact the summary prints, in registration order. A list value prints comma-separated.
function(cadrumo_build_fact label)
  get_property(count GLOBAL PROPERTY CADRUMO_BUILD_FACT_COUNT)
  if(NOT count)
    set(count 0)
  endif()
  set_property(GLOBAL PROPERTY "CADRUMO_BUILD_FACT_LABEL_${count}" "${label}")
  set_property(GLOBAL PROPERTY "CADRUMO_BUILD_FACT_VALUE_${count}" "${ARGN}")
  math(EXPR count "${count} + 1")
  set_property(GLOBAL PROPERTY CADRUMO_BUILD_FACT_COUNT "${count}")
endfunction()

# Record what a target builds for the summary. OUTPUTS may hold generator expressions.
function(cadrumo_describe_target target)
  cmake_parse_arguments(PARSE_ARGV 1 STEP "" "GROUP;SUMMARY" "OUTPUTS")
  _cadrumo_record_step("${target}" "${STEP_GROUP}" "${STEP_SUMMARY}" "${STEP_UNPARSED_ARGUMENTS}" ${STEP_OUTPUTS})
endfunction()

function(_cadrumo_record_step target STEP_GROUP STEP_SUMMARY STEP_UNPARSED_ARGUMENTS)
  set(STEP_OUTPUTS ${ARGN})
  if(NOT STEP_GROUP OR NOT STEP_SUMMARY OR STEP_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Describing ${target} requires GROUP and SUMMARY, and accepts only OUTPUTS besides")
  endif()
  get_property(described GLOBAL PROPERTY CADRUMO_STEPS)
  if(target IN_LIST described)
    message(FATAL_ERROR "Build target ${target} is described twice")
  endif()
  set_property(GLOBAL APPEND PROPERTY CADRUMO_STEPS "${target}")
  get_property(groups GLOBAL PROPERTY CADRUMO_STEP_GROUPS)
  if(NOT STEP_GROUP IN_LIST groups)
    set_property(GLOBAL APPEND PROPERTY CADRUMO_STEP_GROUPS "${STEP_GROUP}")
  endif()
  set_property(GLOBAL PROPERTY "CADRUMO_STEP_GROUP_${target}" "${STEP_GROUP}")
  set_property(GLOBAL PROPERTY "CADRUMO_STEP_SUMMARY_${target}" "${STEP_SUMMARY}")
  set_property(GLOBAL PROPERTY "CADRUMO_STEP_OUTPUTS_${target}" "${STEP_OUTPUTS}")
endfunction()

# Describe a custom target before creating it and return the COMMENT that announces it:
#   cadrumo_build_step(comment python_sdk GROUP dependencies SUMMARY "..." OUTPUTS "...")
#   add_custom_target(python_sdk ... COMMENT "${comment}" VERBATIM)
# The target then reports completion after its own commands.
function(cadrumo_build_step output target)
  cmake_parse_arguments(PARSE_ARGV 2 STEP "" "GROUP;SUMMARY" "OUTPUTS")
  _cadrumo_record_step("${target}" "${STEP_GROUP}" "${STEP_SUMMARY}" "${STEP_UNPARSED_ARGUMENTS}" ${STEP_OUTPUTS})
  get_property(summary GLOBAL PROPERTY "CADRUMO_STEP_SUMMARY_${target}")
  get_property(outputs GLOBAL PROPERTY "CADRUMO_STEP_OUTPUTS_${target}")
  set(comment "[cadrumo:${target}] $<CONFIG>: ${summary}")
  if(outputs)
    list(GET outputs 0 first)
    _cadrumo_display_path(first "${first}")
    string(APPEND comment " -> ${first}")
    list(LENGTH outputs count)
    if(count GREATER 1)
      math(EXPR others "${count} - 1")
      string(APPEND comment " and ${others} more")
    endif()
  endif()
  # A deferred call expands its arguments when it runs; bake in the name now.
  cmake_language(EVAL CODE "cmake_language(DEFER CALL _cadrumo_step_completion [==[${target}]==])")
  set(${output} "${comment}" PARENT_SCOPE)
endfunction()

function(_cadrumo_step_completion target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Build step ${target} was described but never created")
  endif()
  add_custom_command(TARGET "${target}" POST_BUILD
    COMMAND "${CMAKE_COMMAND}" -E echo "[cadrumo:${target}] $<CONFIG>: complete" VERBATIM)
endfunction()

# Source-relative, so a line names the same place on every checkout.
function(_cadrumo_display_path output path)
  if(DEFINED CADRUMO_SOURCE_ROOT)
    string(LENGTH "${CADRUMO_SOURCE_ROOT}/" root_length)
    string(SUBSTRING "${path}" 0 ${root_length} head)
    if(CMAKE_HOST_WIN32)
      string(TOLOWER "${head}" head)
      string(TOLOWER "${CADRUMO_SOURCE_ROOT}/" root)
    else()
      set(root "${CADRUMO_SOURCE_ROOT}/")
    endif()
    if(head STREQUAL root)
      string(SUBSTRING "${path}" ${root_length} -1 path)
    endif()
  endif()
  set(${output} "${path}" PARENT_SCOPE)
endfunction()

# Generator expressions read as the per-configuration choice they make.
function(_cadrumo_configure_time_path output path)
  _cadrumo_display_path(path "${path}")
  string(REGEX REPLACE "\\$<IF:\\$<CONFIG:Debug>,([^,>]*),([^>]*)>" "{\\1|\\2}" path "${path}")
  string(REPLACE "$<CONFIG>" "<config>" path "${path}")
  set(${output} "${path}" PARENT_SCOPE)
endfunction()

function(_cadrumo_pad output text width)
  string(LENGTH "${text}" length)
  if(length LESS width)
    math(EXPR padding "${width} - ${length}")
    string(REPEAT " " ${padding} spaces)
    string(APPEND text "${spaces}")
  endif()
  set(${output} "${text}" PARENT_SCOPE)
endfunction()

function(_cadrumo_collect_tests directory result)
  get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
  get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(child IN LISTS children)
    _cadrumo_collect_tests("${child}" child_tests)
    list(APPEND tests ${child_tests})
  endforeach()
  set(${result} "${tests}" PARENT_SCOPE)
endfunction()

function(cadrumo_print_build_summary)
  get_property(printed GLOBAL PROPERTY CADRUMO_BUILD_SUMMARY_PRINTED)
  if(printed)
    return()
  endif()
  set_property(GLOBAL PROPERTY CADRUMO_BUILD_SUMMARY_PRINTED TRUE)
  get_property(multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(multi_config)
    set(configurations ${CMAKE_CONFIGURATION_TYPES})
  else()
    set(configurations ${CMAKE_BUILD_TYPE})
  endif()

  set(labels "Project" "Source" "Build tree" "Generator")
  set(values "${PROJECT_NAME}" "${CMAKE_SOURCE_DIR}" "${CMAKE_BINARY_DIR}" "${CMAKE_GENERATOR}")
  list(JOIN configurations ", " configuration_text)
  list(APPEND labels "Configurations")
  list(APPEND values "${configuration_text}")
  get_property(fact_count GLOBAL PROPERTY CADRUMO_BUILD_FACT_COUNT)
  if(fact_count)
    math(EXPR fact_last "${fact_count} - 1")
    foreach(index RANGE ${fact_last})
      get_property(label GLOBAL PROPERTY "CADRUMO_BUILD_FACT_LABEL_${index}")
      get_property(value GLOBAL PROPERTY "CADRUMO_BUILD_FACT_VALUE_${index}")
      list(JOIN value ", " value)
      # Keep the list of values aligned with the labels when a value is empty.
      if(value STREQUAL "")
        set(value "-")
      endif()
      list(APPEND labels "${label}")
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(width 0)
  foreach(label IN LISTS labels)
    string(LENGTH "${label}" length)
    if(length GREATER width)
      set(width ${length})
    endif()
  endforeach()
  math(EXPR width "${width} + 2")

  message(STATUS "")
  message(STATUS "Cadrumo build configuration")
  list(APPEND CMAKE_MESSAGE_INDENT "  ")
  list(LENGTH labels label_count)
  math(EXPR label_last "${label_count} - 1")
  foreach(index RANGE ${label_last})
    list(GET labels ${index} label)
    list(GET values ${index} value)
    _cadrumo_pad(label "${label}" ${width})
    message(STATUS "${label}${value}")
  endforeach()

  get_property(steps GLOBAL PROPERTY CADRUMO_STEPS)
  get_property(groups GLOBAL PROPERTY CADRUMO_STEP_GROUPS)
  set(name_width 0)
  set(described_steps)
  foreach(step IN LISTS steps)
    if(TARGET "${step}")
      list(APPEND described_steps "${step}")
      string(LENGTH "${step}" length)
      if(length GREATER name_width)
        set(name_width ${length})
      endif()
    endif()
  endforeach()
  math(EXPR name_width "${name_width} + 2")
  string(REPEAT " " ${name_width} output_indent)
  list(LENGTH described_steps step_count)
  message(STATUS "")
  message(STATUS "Build targets: ${step_count} (* = part of the default build)")
  list(APPEND CMAKE_MESSAGE_INDENT "  ")
  foreach(group IN LISTS groups)
    set(members)
    foreach(step IN LISTS described_steps)
      get_property(step_group GLOBAL PROPERTY "CADRUMO_STEP_GROUP_${step}")
      if(step_group STREQUAL group)
        list(APPEND members "${step}")
      endif()
    endforeach()
    if(NOT members)
      continue()
    endif()
    message(STATUS "${group}")
    foreach(step IN LISTS members)
      get_target_property(excluded "${step}" EXCLUDE_FROM_ALL)
      if(excluded)
        set(marker " ")
      else()
        set(marker "*")
      endif()
      get_property(summary GLOBAL PROPERTY "CADRUMO_STEP_SUMMARY_${step}")
      get_property(outputs GLOBAL PROPERTY "CADRUMO_STEP_OUTPUTS_${step}")
      _cadrumo_pad(name "${step}" ${name_width})
      message(STATUS "${marker} ${name}${summary}")
      foreach(output IN LISTS outputs)
        _cadrumo_configure_time_path(output "${output}")
        message(STATUS "  ${output_indent}-> ${output}")
      endforeach()
    endforeach()
  endforeach()
  list(POP_BACK CMAKE_MESSAGE_INDENT)

  # Cleanup.cmake owns the walk over every directory's targets.
  set(all_targets)
  if(COMMAND _cadrumo_collect_build_targets)
    _cadrumo_collect_build_targets("${CMAKE_SOURCE_DIR}" all_targets)
  endif()
  set(clean_targets)
  set(other_targets)
  foreach(target IN LISTS all_targets)
    if(target MATCHES "^clean-")
      list(APPEND clean_targets "${target}")
    elseif(target MATCHES "^(Experimental|Nightly|Continuous)")
      # include(CTest) adds its dashboard submission targets.
      continue()
    elseif(NOT target IN_LIST described_steps)
      list(APPEND other_targets "${target}")
    endif()
  endforeach()
  if(other_targets)
    list(JOIN other_targets ", " other_text)
    message(STATUS "Undescribed targets: ${other_text}")
  endif()
  list(LENGTH clean_targets clean_count)
  message(STATUS "Clean targets: ${clean_count}; clean-<target> removes only what that target owns")
  list(JOIN clean_targets ", " clean_text)
  message(VERBOSE "  ${clean_text}")
  _cadrumo_collect_tests("${CMAKE_SOURCE_DIR}" tests)
  list(LENGTH tests test_count)
  message(STATUS "CTest tests: ${test_count}")
  list(JOIN tests ", " test_text)
  if(tests)
    message(VERBOSE "  ${test_text}")
  endif()

  if(DEFINED CADRUMO_BUILD_DIRECTORY_KEYS)
    message(VERBOSE "")
    message(VERBOSE "Output layout")
    foreach(key IN LISTS CADRUMO_BUILD_DIRECTORY_KEYS)
      string(TOLOWER "${key}" name)
      _cadrumo_pad(name "${name}" 28)
      _cadrumo_configure_time_path(path "${CADRUMO_PATH_${key}}")
      message(VERBOSE "  ${name}${path}")
    endforeach()
  endif()

  list(GET configurations 0 example_configuration)
  message(STATUS "")
  message(STATUS "Build one target: cmake --build \"${CMAKE_BINARY_DIR}\" --config ${example_configuration} --target <name>")
  message(STATUS "More detail: --log-level=VERBOSE when configuring; CADRUMO_BUILD_LOG_LEVEL=VERBOSE or DEBUG when building")
  list(POP_BACK CMAKE_MESSAGE_INDENT)
  message(STATUS "")
endfunction()
