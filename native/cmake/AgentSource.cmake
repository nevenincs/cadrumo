cmake_minimum_required(VERSION 4.4)
if(NOT DEFINED AGENT_OUTPUT OR NOT DEFINED AGENT_REVISION)
  message(FATAL_ERROR "Agent acquisition requires a declared output and immutable revision")
endif()
if(NOT AGENT_REVISION MATCHES "^[0-9a-f]+$")
  message(FATAL_ERROR "Agent revision must be a commit identity")
endif()
file(MAKE_DIRECTORY "${AGENT_OUTPUT}")
set(archive "${AGENT_OUTPUT}/source.tar.gz")
if(EXISTS "${archive}" AND DEFINED AGENT_SHA256)
  file(SHA256 "${archive}" observed)
  if(NOT observed STREQUAL AGENT_SHA256)
    file(REMOVE "${archive}")
  endif()
endif()
if(NOT EXISTS "${archive}")
  find_program(agent_gh NAMES gh REQUIRED)
  execute_process(COMMAND "${agent_gh}" auth token --hostname github.com
    OUTPUT_VARIABLE agent_token OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET RESULT_VARIABLE authenticated)
  if(NOT authenticated EQUAL 0)
    message(FATAL_ERROR "Agent acquisition needs authenticated GitHub access")
  endif()
  file(DOWNLOAD "https://api.github.com/repos/nevenincs/cadrumo-agent/tarball/${AGENT_REVISION}"
    "${archive}.part" TLS_VERIFY ON HTTPHEADER "Authorization: Bearer ${agent_token}"
    STATUS downloaded TIMEOUT 300)
  unset(agent_token)
  list(GET downloaded 0 download_status)
  if(NOT download_status EQUAL 0)
    file(REMOVE "${archive}.part")
    message(FATAL_ERROR "Agent archive acquisition failed (HTTP transport ${download_status})")
  endif()
  file(RENAME "${archive}.part" "${archive}")
endif()
file(SHA256 "${archive}" observed)
if(DEFINED AGENT_SHA256 AND NOT observed STREQUAL AGENT_SHA256)
  message(FATAL_ERROR "Agent archive SHA-256 differs from the source pin")
endif()
file(WRITE "${AGENT_OUTPUT}/source.sha256" "${observed}\n")
if(AGENT_ARCHIVE_ONLY OR NOT DEFINED AGENT_SHA256)
  message(STATUS "Agent source pin: ${observed}")
  return()
endif()
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${AGENT_OUTPUT}/unpacked")
file(GLOB roots LIST_DIRECTORIES TRUE "${AGENT_OUTPUT}/unpacked/*")
list(LENGTH roots root_count)
if(NOT root_count EQUAL 1)
  message(FATAL_ERROR "Agent archive must have exactly one source root")
endif()
list(GET roots 0 source)
file(RENAME "${source}" "${AGENT_OUTPUT}/source")
file(REMOVE_RECURSE "${AGENT_OUTPUT}/unpacked")
