include_guard(GLOBAL)

function(cadrumo_finalize_ctest_environment)
  set(directories "${CMAKE_SOURCE_DIR}")
  while(directories)
    list(POP_FRONT directories directory)
    get_property(tests DIRECTORY "${directory}" PROPERTY TESTS)
    foreach(test IN LISTS tests)
      get_property(existing TEST "${test}" DIRECTORY "${directory}" PROPERTY ENVIRONMENT)
      set(additions)
      set(storage_configured FALSE)
      foreach(member IN LISTS existing)
        if(member MATCHES "^CADRUMO_(LOCAL_)?STORAGE_ROOT=")
          set(storage_configured TRUE)
          break()
        endif()
      endforeach()
      foreach(name IN ITEMS TEMP TMP TMPDIR)
        set(already_configured FALSE)
        foreach(member IN LISTS existing)
          if(member MATCHES "^${name}=")
            set(already_configured TRUE)
            break()
          endif()
        endforeach()
        if(NOT already_configured)
          list(APPEND additions "${name}=${CADRUMO_CTEST_TEMPORARY}")
        endif()
      endforeach()
      if(NOT storage_configured)
        set(test_storage "${CADRUMO_PATH_TESTING}/$<CONFIG>/storage")
        list(APPEND additions
          "CADRUMO_STORAGE_ROOT=${test_storage}"
          "CADRUMO_LOCAL_STORAGE_ROOT=${test_storage}")
      endif()
      if(additions)
        set_property(TEST "${test}" DIRECTORY "${directory}" APPEND PROPERTY ENVIRONMENT ${additions})
      endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    list(APPEND directories ${children})
  endwhile()
endfunction()
