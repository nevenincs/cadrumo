{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@fixtures/*": [
        "../../../build/windows-x64/fixtures/window/*",
        "../../../build/windows-installers-x64/fixtures/window/*",
        "../../../build/windows-tests-x64/fixtures/window/*",
        "../../../build/linux-x86-64/fixtures/window/*",
        "../../../build/linux-aarch64/fixtures/window/*",
        "../../../build/macos-arm64/fixtures/window/*"
      ]
    }
  },
  "include": [
    "src",
    "dev",
    ".storybook",
    "vite.config.ts",
    "playwright.config.ts",
    "tests"
  ]
}
