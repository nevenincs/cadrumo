{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop-windows-x64",
      "displayName": "Desktop, Windows x64",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/../../build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "windows-x86-64"
      }
    },
    {
      "name": "desktop-linux-x86-64",
      "displayName": "Desktop, linux-x86-64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/../../build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "linux-x86-64"
      }
    },
    {
      "name": "desktop-linux-aarch64",
      "displayName": "Desktop, linux-aarch64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/../../build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "linux-aarch64"
      }
    },
    {
      "name": "desktop-macos-arm64",
      "displayName": "Desktop, macos-arm64",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/../../build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CADRUMO_TARGET": "macos-arm64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop-windows-x64-debug",
      "configurePreset": "desktop-windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "desktop-windows-x64-release",
      "configurePreset": "desktop-windows-x64",
      "configuration": "Release"
    },
    {
      "name": "desktop-linux-x86-64-debug",
      "configurePreset": "desktop-linux-x86-64",
      "configuration": "Debug"
    },
    {
      "name": "desktop-linux-x86-64-release",
      "configurePreset": "desktop-linux-x86-64",
      "configuration": "Release"
    },
    {
      "name": "desktop-linux-aarch64-debug",
      "configurePreset": "desktop-linux-aarch64",
      "configuration": "Debug"
    },
    {
      "name": "desktop-linux-aarch64-release",
      "configurePreset": "desktop-linux-aarch64",
      "configuration": "Release"
    },
    {
      "name": "desktop-macos-arm64-debug",
      "configurePreset": "desktop-macos-arm64",
      "configuration": "Debug"
    },
    {
      "name": "desktop-macos-arm64-release",
      "configurePreset": "desktop-macos-arm64",
      "configuration": "Release"
    }
  ]
}
