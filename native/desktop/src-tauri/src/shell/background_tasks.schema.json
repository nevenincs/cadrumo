{
  "$defs": {
    "BackgroundTaskCue": {
      "description": "A background job of the profile changed: read it again if the revision\nis newer than the one read last.",
      "properties": {
        "family": {
          "$ref": "#/$defs/BackgroundTaskFamily"
        },
        "job_id": {
          "description": "The job, where the family has one per record.",
          "type": [
            "string",
            "null"
          ]
        },
        "profile_id": {
          "type": "string"
        },
        "revision": {
          "description": "The job's stored revision, which rises with every change to it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "family",
        "profile_id",
        "revision"
      ],
      "type": "object"
    },
    "BackgroundTaskFamily": {
      "description": "The kinds of background job the window is cued about: a closed list,\nwhich another background operation joins by adding its family.",
      "enum": [
        "ledger_classification"
      ],
      "type": "string"
    },
    "BackgroundTaskRevision": {
      "description": "One background job's stored revision.",
      "properties": {
        "family": {
          "$ref": "#/$defs/BackgroundTaskFamily"
        },
        "job_id": {
          "description": "The job, where the family has one per record.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "family",
        "revision"
      ],
      "type": "object"
    },
    "BackgroundTaskRevisions": {
      "description": "The background jobs of the signed-in profile, each at its stored\nrevision, as one read found them.",
      "properties": {
        "profile_id": {
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/BackgroundTaskRevision"
          },
          "type": "array"
        }
      },
      "required": [
        "profile_id",
        "tasks"
      ],
      "type": "object"
    }
  },
  "roots": [
    "BackgroundTaskCue",
    "BackgroundTaskRevisions"
  ]
}
