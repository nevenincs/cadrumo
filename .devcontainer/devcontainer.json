{
  "name": "cadrumo dev (Python 3.13 + uv + Playwright)",
  // `dockerfile` is resolved relative to this devcontainer.json file;
  // `context` is the build context passed to `docker build` (repo root, so
  // the Dockerfile's `COPY . .` sees the full workspace). The Dockerfile is
  // multi-stage — `dev` is the development target.
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "target": "dev"
  },

  // `workspaceMount` MUST be declared alongside a custom `workspaceFolder`.
  // The spec default for an image/Dockerfile container mounts the source at
  // `/workspaces/${localWorkspaceFolderBasename}`, so declaring only
  // `workspaceFolder: /workspace` left the editor opening the image's BAKED
  // COPY of the repo while the real checkout sat unused at
  // `/workspaces/<folder>` — edits would have gone to a throwaway layer.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "workspaceFolder": "/workspace",
  "remoteUser": "cadrumo",
  "containerUser": "cadrumo",

  "mounts": [
    // Persist the encrypted secure-storage root and any cached AEAT
    // certificate/session material across container rebuilds. Per
    // docs/workstation-setup.md and env/.env.example, this directory holds
    // regulated personal data (DNI/NIE, cert password references, master-key
    // material) and must never be baked into the image itself.
    "source=cadrumo-state,target=/home/cadrumo/.local/share/cadrumo,type=volume",

    // Keep the virtualenv OUT of the bind-mounted workspace. The host
    // checkout carries its own `.venv` built for the HOST platform — on a
    // Windows host that is a `Scripts/python.exe` layout with Windows
    // binaries — and bind-mounting the workspace would shadow the image's
    // pre-baked Linux venv with it, so `.venv/bin/python` would simply not
    // exist and `postCreateCommand` would fail. Docker seeds an empty named
    // volume from the image content at that path, so this inherits the
    // pre-warmed Linux venv on first start and survives rebuilds.
    "source=cadrumo-venv,target=/workspace/.venv,type=volume"
  ],

  // uv sync + Playwright + vault tooling are already pre-baked at image
  // build time; postCreateCommand only re-syncs against the live-mounted
  // workspace (picks up any source drift since the image was built) and
  // provisions the local env file. `playwright install --with-deps` is
  // deliberately NOT run here — it is unnecessary, per the Dockerfile.
  // `just` itself is installed in the image (Debian trixie ships 1.40.0).
  "postCreateCommand": "just install && just env-setup",

  "remoteEnv": {
    // Headless Chromium in the container has no interactive display; the
    // live AEAT browser paths must run headless. The certificate itself is
    // per-user and per-machine and is never baked into the image (see
    // docs/workstation-setup.md); mount or set AEAT_CERTIFICATE_PATH after
    // the container starts if you need `aeat app live ...` locally.
    "AEAT_BROWSER_HEADLESS": "true"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/workspace/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["src/cadrumo"],
        "editor.formatOnSave": true,
        "editor.rulers": [120],
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports.ruff": "explicit",
            "source.fixAll.ruff": "explicit"
          }
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        }
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "davidanson.vscode-markdownlint"
      ]
    }
  }
}
