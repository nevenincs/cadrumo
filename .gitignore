# AEAT Manual practico raw PDFs (#25): binaries are materialised by
# `aeat manual fetch` and verified against the committed manifest.json.
# Keep raw PDFs ignored unless a registry source catalogue explicitly enrolls
# the official payload as legal/source evidence.
src/aeat/_data/corpus/manuals/**/source.pdf
!src/aeat/_data/corpus/manuals/renta/2020/part1/source.pdf
!src/aeat/_data/corpus/manuals/renta/2021/part1/source.pdf
!src/aeat/_data/corpus/manuals/renta/2022/part1/source.pdf
!src/aeat/_data/corpus/manuals/renta/2023/part1/source.pdf
!src/aeat/_data/corpus/manuals/renta/2024/part1/source.pdf
!src/aeat/_data/corpus/manuals/renta/2025/part1/source.pdf
!src/aeat/_data/corpus/manuals/renta/2025/part2-deducciones-autonomicas/source.pdf
src/aeat/_data/corpus/manuals/**/source.html/

